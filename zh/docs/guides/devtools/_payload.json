,1371,1372,1374],{},[1047,1373,333],{},[1047,1375,1376,792,1378,792,1381,792,1384,1330],{},[493,1377,1346],{},[493,1379,1380],{},"indentation",[493,1382,1383],{},"nesting",[493,1385,1386],{},"maxDepth",[1032,1388,1389,1392],{},[1047,1390,1391],{},"放置目标",[1047,1393,1394,792,1396,792,1399,792,1402],{},[493,1395,1340],{},[493,1397,1398],{},"priority",[493,1400,1401],{},"accept",[493,1403,1361],{},[1032,1405,1406,1409],{},[1047,1407,1408],{},"项",[1047,1410,1411,792,1413,792,1416],{},[493,1412,1340],{},[493,1414,1415],{},"keyboardMode",[493,1417,1320],{},[490,1419,1420],{},"编辑立即生效，只作用于当前页面，永远不会写入你的代码：库在读取选项的地方读取新值。它会一直有效，直到你重置它（每个选项旁的 ↺，或顶栏中的重置）、provider 卸载或页面重新加载。被编辑的选项旁边会显示你代码中的值。在编辑生效期间挂载的项——虚拟列表的行——也会获得它。",[510,1422,1424],{"id":1423},"state","状态",[490,1426,1427],{},"每个 provider 对你所选节点所知的信息：",[971,1429,1430,1436,1444],{},[974,1431,1432,1435],{},[502,1433,1434],{},"拖拽会话","：状态、当前的 id、项和传感器、目标及其是否接收、指针、浮层、可排序分组的会话和插入线；",[974,1437,1438,1440,1441,1443],{},[502,1439,1335],{},"：它的顺序和草稿；",[502,1442,333],{},"：它的行；",[974,1445,1446,1448,1449,1451],{},[502,1447,1408],{},"：它的类型、数据和位置；",[502,1450,1391],{},"：它的规则。",[490,1453,1454],{},"项的挂载和卸载没有事件：注册表会在一秒内跟上。",[510,1456,1458],{"id":1457},"log","日志",[490,1460,1461],{},"每次拖拽一个条带，按顺序排列：",[1026,1463,1464,1474],{},[1029,1465,1466],{},[1032,1467,1468,1471],{},[1035,1469,1470],{},"条目",[1035,1472,1473],{},"说明什么",[1042,1475,1476,1486,1499,1512,1524,1542],{},[1032,1477,1478,1483],{},[1047,1479,1480],{},[493,1481,1482],{},"drag start",[1047,1484,1485],{},"id、传感器以及是否由触摸发起、它来自的列表。",[1032,1487,1488,1496],{},[1047,1489,1490,792,1493],{},[493,1491,1492],{},"over",[493,1494,1495],{},"left",[1047,1497,1498],{},"进入和离开的每个目标，以及它是否接收。",[1032,1500,1501,1506],{},[1047,1502,1503],{},[493,1504,1505],{},"release",[1047,1507,1508,1509,1511],{},"在 ",[493,1510,1171],{}," 做决定期间，它被松开时所在的目标。",[1032,1513,1514,1518],{},[1047,1515,1516],{},[493,1517,1171],{},[1047,1519,1520,1521,1523],{},"裁决：已接受、部分接受、被钩子拒绝、被目标的 ",[493,1522,1401],{}," 拒绝，以及钩子花了多长时间。",[1032,1525,1526,1531],{},[1047,1527,1528],{},[493,1529,1530],{},"drop",[1047,1532,1533,1534,1537,1538,1541],{},"目标；对于可排序列表，还有这次移动、",[493,1535,1536],{},"e.result","，以及是否调用了 ",[493,1539,1540],{},"preventDefault()","。",[1032,1543,1544,1549],{},[1047,1545,1546],{},[493,1547,1548],{},"cancel",[1047,1550,1551,1552,1555,1556,1558],{},"原因：被取消（Escape、",[493,1553,1554],{},"cancel()","）、被钩子拒绝，或被目标的 ",[493,1557,1401],{}," 拒绝。",[490,1560,1561,1562,957,1565,792,1568,1571,1572,1575],{},"还有 ",[493,1563,1564],{},"auto-scroll on",[493,1566,1567],{},"off",[493,1569,1570],{},"announcement"," 文本（默认隐藏），以及拖拽之外的 ",[493,1573,1574],{},"animate","（非拖拽引起的列表项变化）。单击一个条目可以查看它的数据。后来打开的标签页会收到在此之前的拖拽。",[510,1577,1579],{"id":1578},"debug-a-drop-step-by-step","逐步调试一次放置",[490,1581,1582],{},"一张卡片放不进某一列。打开标签页：",[1584,1585,1586,1595,1613,1633],"ol",{},[974,1587,1588,1591,1592,1594],{},[502,1589,1590],{},"复现问题","，可以手动，也可以用 ",[502,1593,1094],{},"，这样你的手可以腾出来操作标签页。",[974,1596,1597,1598,1601,1602,1605,1606,1609,1610,1612],{},"卡片位于该列上方时",[502,1599,1600],{},"观察地图","。红色表示列表拒绝这张卡片：检查它的 ",[493,1603,1604],{},"group","（",[493,1607,1608],{},"put","）或目标的 ",[493,1611,1401],{},"。蓝色表示它接收，问题出在后面。",[974,1614,1615,1541,1618,1620,1621,1623,1624,1626,1627,1629,1630,1632],{},[502,1616,1617],{},"阅读那次拖拽的日志",[493,1619,1171],{}," 会说明是谁拒绝的——钩子，还是目标的 ",[493,1622,1401],{},"。如果放置完成了但你的数据没有变化，",[493,1625,1530],{}," 条目会说明是否调用了 ",[493,1628,1540],{}," 以及 ",[493,1631,1536],{}," 中有什么：受控列表必须自己应用它。",[974,1634,1508,1635,1637,1638,1641,1642,1644,1645,792,1647,1649],{},[502,1636,1097],{}," 中",[502,1639,1640],{},"实时尝试修复","——更宽松的 ",[493,1643,1361],{},"、另一种 ",[493,1646,1304],{},[493,1648,1134],{},"——然后把有效的那个写进你的代码。",[510,1651,1653],{"id":1652},"how-it-works","工作原理",[490,1655,1656,1657,1660],{},"provider 向页面一侧安装的一个钩子报告。在有标签页观察该页面之前，它们只是被记录下来；之后页面像任何监听器一样进行监听，并把标签页要显示的内容发送给它——拖拽期间每 40 ms 一次，其他时候每秒两次——在几秒钟内没有标签页观察时停止。标签页通过页面源的 ",[493,1658,1659],{},"BroadcastChannel"," 与页面通信。它只改变你要求的东西：拖拽、选中集合和选项覆盖。",[1662,1663,1664],"style",{},"html pre.shiki code .sbwC8, html code.shiki
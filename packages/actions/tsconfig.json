{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [],
    // The core from its sources (unreleased v3), with this package's copies of Vue and
    // VueUse: two copies would make their types incompatible.
    "paths": {
      "@vue-dnd-kit/core": ["../core/src/index.ts"],
      "vue": ["./node_modules/vue"],
      "@vueuse/core": ["./node_modules/@vueuse/core"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

{
  "name": "@vue-dnd-kit/core",
  "version": "3.0.0",
  "description": "Drag and drop for Vue 3: sortable lists, kanban boards, trees, multi-drag and animations out of the box",
  "author": "ZiZIGY",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "vue",
    "vue3",
    "dnd",
    "drag",
    "drop",
    "drag and drop",
    "sortable",
    "kanban",
    "tree",
    "multi-drag",
    "virtual list",
    "vue drag and drop",
    "vue dnd kit",
    "vue-dnd-kit",
    "@vue-dnd-kit/core"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zizigy/vue-dnd-kit.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "vite build",
    "start": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint --strict --pack npm && attw --pack .",
    "prepublishOnly": "yarn typecheck && yarn test && yarn build && yarn lint:package"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools.d.ts",
        "default": "./dist/devtools.js"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "devtools": [
        "./dist/devtools.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vueuse/core": "^14 || ^15"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.10.0",
    "@vue/tsconfig": "^0.8.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.8.1",
    "publint": "^0.3.25",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.24",
    "vue-tsc": "^3.1.3"
  }
}

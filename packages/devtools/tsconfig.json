{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    // The Vite plugin (`src/vite.ts`) runs in Node.
    "types": ["node"],
    "paths": {
      // The core's sources, not its build (as in the playground): the bridge is versioned with them.
      "@vue-dnd-kit/core": ["../core/src/index.ts"],
      "@vue-dnd-kit/core/devtools": ["../core/src/devtools/index.ts"],
      // The inspector drags through the actions' sources, versioned with the core's.
      "@vue-dnd-kit/actions": ["../actions/src/index.ts"],
      // One Vue for this package and the core's sources.
      "vue": ["./node_modules/vue"],
      "@vueuse/core": ["./node_modules/@vueuse/core"]
    }
  },
  // The tab (`client/`) too: a Vue app of its own, typechecked with the rest.
  "include": ["src/**/*.ts", "test/**/*.ts", "client/**/*.ts", "client/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}

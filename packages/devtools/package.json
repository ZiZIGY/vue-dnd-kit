{
  "name": "@vue-dnd-kit/devtools",
  "version": "3.0.0-beta.0",
  "description": "DevTools for Vue DnD Kit: a tab in the Nuxt DevTools and the Vue DevTools with a joystick that drags for real, a live mini-map of every list and drop target, live option editing, the providers' state and a log of the drags",
  "author": "ZiZIGY",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/auto.js",
    "./dist/auto.cjs"
  ],
  "keywords": [
    "vue",
    "vue3",
    "devtools",
    "vue devtools",
    "dnd",
    "drag and drop",
    "vue-dnd-kit",
    "@vue-dnd-kit/devtools",
    "nuxt devtools",
    "vite plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zizigy/vue-dnd-kit.git",
    "directory": "packages/devtools"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.client.config.ts",
    "start": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint --strict --pack npm && attw --pack .",
    "prepublishOnly": "yarn typecheck && yarn test && yarn build && yarn lint:package"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/auto.d.cts",
        "default": "./dist/auto.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "auto": [
        "./dist/auto.d.ts"
      ],
      "vite": [
        "./dist/vite.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@vue-dnd-kit/actions": "^3.0.0-0",
    "@vue-dnd-kit/core": "^3.0.0-0",
    "vue": "^3.5.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^15.0.0",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.24",
    "vue-tsc": "^3.1.3"
  }
}

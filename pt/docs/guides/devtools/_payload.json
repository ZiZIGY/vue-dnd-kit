 só funciona em desenvolvimento: nada dela chega a um build de produção.",[473,490,491],{},"A aba é uma página própria, servida pelo seu servidor de desenvolvimento ao lado do seu app, então\nela não pode rodar dentro desta documentação. Três passos a configuram.",[493,494,294],"h2",{"id":495},"install",[497,498,500],"h3",{"id":499},"_1-add-the-packages","1. Adicione os pacotes",[502,503,508],"pre",{"className":504,"code":505,"language":506,"meta":507,"style":507},"language-bash shiki shiki-themes dnd-light dnd-light dnd-dark","npm i -D @vue-dnd-kit\u002Fdevtools @vue-dnd-kit\u002Factions\n","bash","",[476,509,510],{"__ignoreMap":507},[511,512,515,519,523,526,529],"span",{"class":513,"line":514},"line",1,[511,516,518],{"class":517},"sbwC8","npm",[511,520,522],{"class":521},"sN8r7"," i",[511,524,525],{"class":521}," -D",[511,527,528],{"class":521}," @vue-dnd-kit\u002Fdevtools",[511,530,531],{"class":521}," @vue-dnd-kit\u002Factions\n",[473,533,534,537],{},[476,535,536],{},"@vue-dnd-kit\u002Factions"," é uma peer dependency: os movimentos da aba passam por ele. O npm 7+ e o\npnpm o instalam sozinhos; com o Yarn 1, adicione-o.",[497,539,541],{"id":540},"_2-add-the-plugin","2. Adicione o plugin",[543,544,545,694],"code-group",{},[502,546,551],{"className":547,"code":548,"filename":549,"language":550,"meta":507,"style":507},"language-ts shiki shiki-themes dnd-light dnd-light dnd-dark","import { defineConfig } from 'vite';\nimport vue from '@vitejs\u002Fplugin-vue';\nimport vueDevTools from 'vite-plugin-vue-devtools';\nimport { vueDnDKitDevtools } from '@vue-dnd-kit\u002Fdevtools\u002Fvite';\n\nexport default defineConfig({\n  \u002F\u002F Next to the Vue DevTools plugin: the tab joins its sidebar.\n  plugins: [vueDevTools(), vueDnDKitDevtools(), vue()],\n});\n","vite.config.ts","ts",[476,552,553,579,595,610,629,636,651,658,688],{"__ignoreMap":507},[511,554,555,559,563,567,570,573,576],{"class":513,"line":514},[511,556,558],{"class":557},"s78Kj","import",[511,560,562],{"c
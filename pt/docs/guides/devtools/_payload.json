çar. Nenhum ",[492,767,768],{},"app.use()"," é necessário, e os builds não são\nafetados.",[489,771,772,773,776,777,780],{},"Com o Nuxt, o módulo ",[492,774,775],{},"@vue-dnd-kit\u002Fnuxt"," encontra o pacote, serve a aba, a adiciona ao Nuxt\nDevTools e instala o lado da página com um plugin de cliente. ",[492,778,779],{},"vueDndKit: { devtools: false }"," a\ndesliga.",[513,782,784],{"id":783},"_3-run-the-app-in-development","3. Rode o app em desenvolvimento",[489,786,787,788,791,792,795],{},"Inicie o servidor de desenvolvimento como sempre (",[492,789,790],{},"vite",", ",[492,793,794],{},"nuxt dev",") e abra o app: a aba está\npronta. Todo provider da página aparece nela, seja qual for o app em que ele é renderizado.",[513,797,799],{"id":798},"without-the-plugins","Sem os plugins",[489,801,802,803,806],{},"Para um servidor de desenvolvimento seu, ou uma página que o Vite não serve a partir de um\n",[492,804,805],{},"index.html"," (configurações de SSR), instale o lado da página você mesmo:",[518,808,811],{"className":563,"code":809,"filename":810,"language":566,"meta":523,"style":523},"import { createApp } from 'vue';\nimport { DnDDevtools } from '@vue-dnd-kit\u002Fdevtools';\nimport App from '.\u002FApp.vue';\n\nconst app = createApp(App);\napp.use(DnDDevtools); \u002F\u002F before mount: providers set up earlier aren't seen\napp.mount('#app');\n","main.ts",[492,812,813,831,849,863,867,890,912],{"__ignoreMap":523},[527,814,815,817,819,822,824,826,829],{"class":529,"line":530},[527,816,574],{"class":573},[527,818,578],{"class":577},[527,820,821],{"class":581}," createApp ",[527,823,585],{"class":577},[527,825,588],{"class":573},[527,827,828],{"class":537}," 'vue'",[527,830,594],{"class":577},[527,832,833,835,837,840,842,844,847],{"class":529,"line":597},[527,834,574],{"class":573},[527,836,578],{"class":577},[527,838,839],{"class":581}," DnDDevtools ",[527,841,585],{"class":577},[527,843,588],{"class":573},[527,845,846],{"class":537}," '@vue-dnd-kit\u002Fdevtools'",[527,848,594],{"class":577},[527,850,851,853,856,858,861],{"class":529,"line":613},[527,852,574],{"class":573},[527,854,855],{"class":581}," App ",[527,857,605],{"class":573},[527,859,860],{"class":537}," '.\u002FApp.vue'",[527,862,594],{"class":577},[527,864,865],{"class":529,"line":628},[527,866,651],{"emptyLinePlaceholder":650},[527,868,869,872,875,878,881,884,887],{"class":529,"line":647},[527,870,871],{"class":573},"const",[527,873,874],{"class":581}," app ",[527,876,877],{"class":577},"=",[527,879,880],{"class":533}," createApp",[527,882,883],{"class":577},"(",[527,885,886],{"class":581},"App",[527,888,889],{"class":577},");\n",[527,891,892,895,898,901,903,906,909],{"class":529,"line":654},[527,893,894],{"class":533},"app",[527,896,897],{"class":577},".",[527,899,900],{"class":533},"use",[527,902,883],{"class":577},[527,904,905],{"class":581},"DnDDevtools",[527,907,908],{"class":577},");",[527,910,911],{"class":672}," \u002F\u002F before mount: providers set up earlier aren't seen\n",[527,913,914,916,918,921,923,926],{"class":529,"line":669},[527,915,894],{"class":533},[527,917,897],{"class":577},[527,919,920],{"class":533},"mount",[527,922,883],{"class":577},[527,924,925],{"class":537},"'#app'",[527,927,889],{"class":577},[489,929,930,931,934,935,938,939,942,943,946],{},"Ou importe ",[492,932,933],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," primeiro no arquivo de entrada. Use\n",[492,936,937],{},"vueDnDKitDevtools({ inject: false })"," quando o plugin deve servir a aba, mas você instala o lado da\npágina você mesmo; ",[492,940,941],{},"serveTab()"," de ",[492,944,945],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," é o middleware que serve a aba.",[948,949,950],"note",{},[489,951,952,953,956,957,960,961,964],{},"Em um build de produção, ",[492,954,955],{},"app.use(DnDDevtools)"," e o import ",[492,958,959],{},"auto"," encolhem para quase nada: todo\nponto de entrada verifica ",[492,962,963],{},"process.env.NODE_ENV"," primeiro, e os bundlers descartam o resto. No\nservidor, eles não fazem nada.",[509,966,968],{"id":967},"open-it","Abrir a aba",[970,971,972,993,1008],"ul",{},[973,974,975,978,979,983,984,983,987,990,991,897],"li",{},[497,976,977],{},"Vue DevTools",": ",[980,981],"kbd",{"value":982},"Alt"," + ",[980,985],{"value":986},"Shift",[980,988],{"value":989},"D",", ou o botão do Vue no\nrodapé da página, depois a aba ",[497,992,499],{},[973,994,995,978,998,983,1000,983,1002,1004,1005,1007],{},[497,996,997],{},"Nuxt DevTools",[980,999],{"value":982},[980,1001],{"value":986},[980,1003],{"value":989},", ou o botão do Nuxt,\ndepois ",[497,1006,499],{}," (na barra lateral ou no menu de itens extras dela).",[973,1009,1010,1013,1014,1017],{},[497,1011,1012],{},"Uma janela própria",": abra ",[492,1015,1016],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," no seu servidor de\ndesenvolvimento, ou o botão ⧉ da aba. Prático em um segundo monitor. Com várias páginas abertas,\num seletor no topo escolhe qual observar.",[1019,1020,1021],"warning",{},[489,1022,1023],{},"Mantenha a aba em uma janela própria, não em uma aba de navegador em segundo plano da mesma janela:\na página precisa continuar visível, e uma página escondida cancela os arrastes.",[509,1025,1027],{"id":1026},"the-tab-at-a-glance","A aba em resumo",[1029,1030,1031,1044],"table",{},[1032,1033,1034],"thead",{},[1035,1036,1037,1041],"tr",{},[1038,1039,1040],"th",{},"Parte",[1038,1042,1043],{},"O que contém",[1045,1046,1047,1064,1076,1091],"tbody",{},[1035,1048,1049,1053],{},[1050,1051,1052],"td",{},"Barra superior",[1050,1054,1055,1056,1059,1060,1063],{},"O que o arraste está fazendo agora (",[492,1057,1058],{},"dragging card-3 → done (accepts)","), a página observada, ",[497,1061,1062],{},"⌖ Pick",", a contagem de opções editadas com um reset, ⧉ (uma janela própria) e o tema.",[1035,1065,1066,1069],{},[1050,1067,1068],{},"Esquerda: o registro",[1050,1070,1071,1072,1075],{},"Todo provider como uma árvore: as listas, árvores, alvos de drop e draggables dele. ",[497,1073,1074],{},"☰"," o mostra ou esconde.",[1035,1077,1078,1088],{},[1050,1079,1080,1081,1084,1085],{},"Meio: ",[497,1082,1083],{},"Map"," e ",[497,1086,1087],{},"Log",[1050,1089,1090],{},"O minimapa ao vivo da página, ou o log dos arrastes.",[1035,1092,1093,1105],{},[1050,1094,1095,1096,791,1099,791,1102],{},"Direita: ",[497,1097,1098],{},"Drive",[497,1100,1101],{},"Options",[497,1103,1104],{},"State",[1050,1106,1107],{},"O joystick e os botões de mover, as opções do nó escolhido, e o que o provider sabe sobre ele.",[489,1109,1110],{},"Escolha um nó no registro ou um item no mapa, e o lado direito o acompanha.",[509,1112,1114],{"id":1113},"the-mini-map","O minimapa",[489,1116,1117],{},"Um card ao vivo por lista, árvore e alvo de drop, com cópias dos itens deles onde estão — os mesmos\nclones que o overlay mostraria, com o CSS da página. Durante um arraste, ele marca:",[970,1119,1120,1131,1134],{},[973,1121,1122,1123,1126,1127,1130],{},"as listas e os alvos que ",[497,1124,1125],{},"aceitam"," o arraste (azul) ou o ",[497,1128,1129],{},"recusam"," (vermelho);",[973,1132,1133],{},"o placeholder, e o alvo sob o ponteiro;",[973,1135,1136,1137,897],{},"o ponteiro, a caixa do overlay e a linha de inserção das listas com ",[492,1138,1139],{},"placeholder: 'indicator'",[489,1141,1142],{},"Um clique escolhe um item e o destaca na página; um clique duplo rola a página até ele. Use o mapa\nquando um drop não vai para onde você espera: ele mostra de relance quais listas aceitam o arraste.",[509,1144,1146],{"id":1145},"drive-the-joystick","Drive: o joystick",[489,1148,1149,1150,1152,1153,1084,1156,1159],{},"Escolha um item — no mapa, no registro ou com ",[497,1151,1062],{},", que captura a próxima pressão em um\ndraggable da página em vez de deixá-la agir — e empurre a alavanca do joystick. O item é pego e se\nmove naquela direção, mais rápido quanto mais longe a alavanca estiver do centro. Solte e ele\npara; ",[497,1154,1155],{},"Drop",[497,1157,1158],{},"Cancel"," encerram o arraste.",[489,1161,1162,1163,1166,1167,1172,1173,1084,1176,1179],{},"É um arraste por ponteiro de verdade de um sensor chamado ",[492,1164,1165],{},"devtools",", feito com a\n",[1168,1169,1171],"a",{"href":1170},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API pública de sensores",": as listas ordenam sob ele, os\ncontêineres rolam automaticamente nas bordas, e ",[492,1174,1175],{},"onBeforeDrop",[492,1177,1178],{},"onDrop"," rodam como em qualquer\narraste. Itens desativados não são pegos. Um arraste por teclado iniciado pela página também pode\nser conduzido.",[489,1181,1182,1183,1189],{},"Os itens de listas ordenáveis também ganham botões: para cima, para baixo, para o início, para o\nfim, para outra lista do grupo. Cada um é um arraste por teclado de\n",[1168,1184,1186],{"href":1185},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[492,1187,1188],{},"moveItem",". Embaixo do joystick, uma cópia grande do que o\noverlay mostra.",[1029,1191,1192,1202],{},[1032,1193,1194],{},[1035,1195,1196,1199],{},[1038,1197,1198],{},"Tecla, na aba",[1038,1200,1201],{},"Faz",[1045,1203,1204,1227,1237,1251,1261],{},[1035,1205,1206,1221],{},[1050,1207,1208,1209,1212,1213,1212,1216,1212,1219],{},"Setas ou ",[980,1210],{"value":1211},"W"," ",[980,1214],{"value":1215},"A",[980,1217],{"value":1218},"S",[980,1220],{"value":989},[1050,1222,1223,1224,1226],{},"Empurra a alavanca naquela direção, até a metade; com ",[980,1225],{"value":986},", até o fim",[1035,1228,1229,1234],{},[1050,1230,1231],{},[980,1232],{"value":1233},"G",[1050,1235,1236],{},"Pega o item escolhido",[1035,1238,1239,1248],{},[1050,1240,1241,1244,1245],{},[980,1242],{"value":1243},"Space"," \u002F ",[980,1246],{"value":1247},"Enter",[1050,1249,1250],{},"Solta",[1035,1252,1253,1258],{},[1050,1254,1255],{},[980,1256],{"value":1257},"Escape",[1050,1259,1260],{},"Cancela",[1035,1262,1263,1268],{},[1050,1264,1265],{},[980,1266],{"value":1267},"P",[1050,1269,1270],{},"Escolhe na página",[509,1272,1274],{"id":1273},"options","Opções",[489,1276,1277,1278,683],{},"Toda opção que não é um callback pode ser editada enquanto o app roda. Escolha o nó e abra\n",[497,1279,1101],{},[1029,1281,1282,1291],{},[1032,1283,1284],{},[1035,1285,1286,1289],{},[1038,1287,1288],{},"Nó",[1038,1290,1274],{},[1045,1292,1293,1335,1374,1392,1409],{},[1035,1294,1295,1298],{},[1050,1296,1297],{},"Provider",[1050,1299,1300,791,1303,791,1306,791,1309,1312,1313,791,1316,791,1319,791,1322,791,1325,791,1328,791,1331,1334],{},[492,1301,1302],{},"overlayFit",[492,1304,1305],{},"autoScroll",[492,1307,1308],{},"collision",[492,1310,1311],{},"modifiers"," (os da biblioteca, pelo nome), ",[492,1314,1315],{},"animation",[492,1317,1318],{},"dropAnimation",[492,1320,1321],{},"animateChanges",[492,1323,1324],{},"activation",[492,1326,1327],{},"keyboard",[492,1329,1330],{},"haptics",[492,1332,1333],{},"copyModifier","…",[1035,1336,1337,1340],{},[1050,1338,1339],{},"Lista",[1050,1341,1342,791,1345,791,1348,791,1351,791,1354,791,1357,791,1360,791,1363,791,1366,791,1368,791,1370,791,1372],{},[492,1343,1344],{},"disabled",[492,1346,1347],{},"strategy",[492,1349,1350],{},"placeholder",[492,1352,1353],{},"behavior",[492,1355,1356],{},"multiple",[492,1358,1359],{},"sort",[492,1361,1362],{},"dropOutside",[492,1364,1365],{},"acceptMode",[492,1367,1315],{},[492,1369,1321],{},[492,1371,1305],{},[492,1373,1311],{},[1035,1375,1376,1379],{},[1050,1377,1378],{},"Árvore",[1050,1380,1381,791,1383,791,1386,791,1389,1334],{},[492,1382,1350],{},[492,1384,1385],{},"indentation",[492,1387,1388],{},"nesting",[492,1390,1391],{},"maxDepth",[1035,1393,1394,1397],{},[1050,1395,1396],{},"Alvo de drop",[1050,1398,1399,791,1401,791,1404,791,1407],{},[492,1400,1344],{},[492,1402,1403],{},"priority",[492,1405,1406],{},"accept",[492,1408,1365],{},[1035,1410,1411,1414],{},[1050,1412,1413],{},"Item",[1050,1415,1416,791,1418,791,1421],{},[492,1417,1344],{},[492,1419,1420],{},"keyboardMode",[492,1422,1324],{},[489,1424,1425],{},"Uma edição vale na hora, só para esta página, e nunca é gravada no seu código: a biblioteca lê o\nnovo valor onde lê a opção. Ela dura até você resetá-la (↺ por opção, ou o reset da barra\nsuperior), o provider ser desmontado ou a página recarregar. Uma opção editada mostra ao lado o\nvalor do seu código. Os itens montados enquanto uma edição está ativa — linhas de uma lista\nvirtual — também a recebem.",[509,1427,1429],{"id":1428},"state","Estado",[489,1431,1432],{},"O que cada provider sabe, para o nó que você escolheu:",[970,1434,1435,1442,1453],{},[973,1436,1437,1438,1441],{},"a ",[497,1439,1440],{},"sessão de arraste",": o status, os ids, os itens e o sensor ativos, o alvo e se ele aceita, o\nponteiro, o overlay, a sessão do grupo ordenável e a linha de inserção;",[973,1443,1444,1445,1448,1449,1452],{},"uma ",[497,1446,1447],{},"lista",": a ordem dela e o rascunho; uma ",[497,1450,1451],{},"árvore",": as linhas dela;",[973,1454,1455,1456,1459,1460,1463],{},"um ",[497,1457,1458],{},"item",": o tipo, os dados e a posição dele; um ",[497,1461,1462],{},"alvo de drop",": as regras dele.",[489,1465,1466],{},"Os itens são montados e desmontados sem eventos: o registro se atualiza em até um segundo.",[509,1468,1087],{"id":1469},"log",[489,1471,1472],{},"Uma faixa por arraste, em ordem:",[1029,1474,1475,1485],{},[1032,1476,1477],{},[1035,1478,1479,1482],{},[1038,1480,1481],{},"Entrada",[1038,1483,1484],{},"O que diz",[1045,1486,1487,1497,1510,1523,1535,1553],{},[1035,1488,1489,1494],{},[1050,1490,1491],{},[492,1492,1493],{},"drag start",[1050,1495,1496],{},"Os ids, o sensor e se foi por toque, a lista de onde vem.",[1035,1498,1499,1507],{},[1050,1500,1501,791,1504],{},[492,1502,1503],{},"over",[492,1505,1506],{},"left",[1050,1508,1509],{},"Cada alvo em que entrou e de que saiu, e se ele aceita.",[1035,1511,1512,1517],{},[1050,1513,1514],{},[492,1515,1516],{},"release",[1050,1518,1519,1520,1522],{},"O alvo sobre o qual foi solto, enquanto o ",[492,1521,1175],{}," decide.",[1035,1524,1525,1529],{},[1050,1526,1527],{},[492,1528,1175],{},[1050,1530,1531,1532,1534],{},"O veredito: aceito, alguns aceitos, rejeitado por um hook, recusado pelo ",[492,1533,1406],{}," do alvo, e quanto tempo os hooks levaram.",[1035,1536,1537,1542],{},[1050,1538,1539],{},[492,1540,1541],{},"drop",[1050,1543,1544,1545,1548,1549,1552],{},"O alvo; para listas ordenáveis, o movimento, ",[492,1546,1547],{},"e.result",", e se ",[492,1550,1551],{},"preventDefault()"," foi chamado.",[1035,1554,1555,1560],{},[1050,1556,1557],{},[492,1558,1559],{},"cancel",[1050,1561,1562,1563,1566,1567,1569],{},"O motivo: cancelado (Escape, ",[492,1564,1565],{},"cancel()","), rejeitado por um hook, ou recusado pelo ",[492,1568,1406],{}," do alvo.",[489,1571,1572,1573,1084,1576,1579,1580,1583,1584,1587],{},"Também ",[492,1574,1575],{},"auto-scroll on",[492,1577,1578],{},"off",", os textos de ",[492,1581,1582],{},"announcement"," (escondidos por padrão) e, fora dos\narrastes, ",[492,1585,1586],{},"animate"," (mudanças nos itens de uma lista que nenhum arraste fez). Clique em uma entrada\npara ver os dados dela. Uma aba aberta depois recebe os arrastes até então.",[509,1589,1591],{"id":1590},"debug-a-drop-step-by-step","Depurar um drop, passo a passo",[489,1593,1594],{},"Um card não entra em uma coluna. Com a aba aberta:",[1596,1597,1598,1607,1624,1645],"ol",{},[973,1599,1600,1603,1604,1606],{},[497,1601,1602],{},"Reproduza"," à mão, ou com ",[497,1605,1098],{},", para que as suas mãos fiquem livres para a aba.",[973,1608,1609,1612,1613,1616,1617,1620,1621,1623],{},[497,1610,1611],{},"Observe o mapa"," enquanto o card está sobre a coluna. Vermelho significa que a lista recusa o\ncard: veja o ",[492,1614,1615],{},"group"," dela (",[492,1618,1619],{},"put",") ou o ",[492,1622,1406],{}," do alvo. Azul significa que ela aceita, e o\nproblema vem depois.",[973,1625,1626,1629,1630,1632,1633,1635,1636,1638,1639,1641,1642,1644],{},[497,1627,1628],{},"Leia o log"," desse arraste. ",[492,1631,1175],{}," diz quem disse não — um hook, ou o ",[492,1634,1406],{}," do\nalvo. Se o drop foi concluído mas os seus dados não mudaram, a entrada ",[492,1637,1541],{}," diz se\n",[492,1640,1551],{}," foi chamado e o que ",[492,1643,1547],{}," continha: uma lista controlada precisa\naplicá-lo ela mesma.",[973,1646,1647,1650,1651,1653,1654,1656,1657,791,1659,1661],{},[497,1648,1649],{},"Teste uma correção ao vivo"," em ",[497,1652,1101],{}," — um ",[492,1655,1365],{}," mais flexível, outra\n",[492,1658,1308],{},[492,1660,1139],{}," — e depois escreva no seu código a que funcionar.",[509,1663,1665],{"id":1664},"how-it-works","Como funciona",[489,1667,1668,1669,1672],{},"Os providers se reportam a um hook que o lado da página instala. Até uma aba observar a página,\neles só são registrados; depois disso, a página escuta como qualquer monitor e envia à aba o que\nela mostra — a cada 40 ms durante um arraste, duas vezes por segundo no resto do tempo — e para\nassim que nenhuma aba a observa por alguns segundos. A aba conversa com a página por um\n",[492,1670,1671],{},"BroadcastChannel"," da origem da página. Ela não muda nada além do que você pede: os arrastes, a\nseleção e as substituições de opções.",[1674,1675,1676],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s78Kj, html code.shiki .s78Kj{--shiki-light:#1F8A5B;--shiki-default:#1F8A5B;--shiki-dark:#42B883}html pre.shiki code .s6cML, html code.shiki .s6cML{--shiki-light:#5B5B63;--shiki-default:#5B5B63;--shiki-dark:#9F9FA9}html pre.shiki code .snmWg, html code.shiki .snmWg{--shiki-light:#27272A;--shiki-default:#27272A;--shiki-dark:#E4E4E7}html pre.shiki code .sytrG, html code.shiki .sytrG{--shiki-light:#85858D;--shiki-light-font-style:italic;--shiki-default:#85858D;--shiki-default-font-style:italic;--shiki-dark:#6E6E78;--shiki-dark-font-style:italic}html pre.shiki code .sVvmN, html code.shiki .sVvmN{--shiki-light:#7C4DCC;--shiki-default:#7C4DCC;--shiki-dark:#C3A6FF}",{"title":523,"searchDepth":613,"depth":613,"links":1678},[1679,1685,1686,1687,1688,1689,1690,1691,1692,1693],{"id":511,"depth":597,"text":299,"children":1680},[1681,1682,1683,1684],{"id":515,"depth":613,"text":516},{"id":556,"depth":613,"text":557},{"id":783,"depth":613,"text":784},{"id":798,"depth":613,"text":799},{"id":967,"depth":597,"text":968},{"id":1026,"depth":597,"text":1027},{"id":1113,"depth":597,"text":1114},{"id":1145,"depth":597,"text":1146},{"id":1273,"depth":597,"text":1274},{"id":1428,"depth":597,"text":1429},{"id":1469,"depth":597,"text":1087},{"id":1590,"depth":597,"text":1591},{"id":1664,"depth":597,"text":1665},"Uma aba Vue DnD Kit no Vue DevTools e no Nuxt DevTools — um minimapa ao vivo, um joystick que arrasta de verdade, edição de opções ao vivo e um log de cada arraste.","md",null,{"source":1698},"6f7e373d0b",{"icon":116},{"title":113,"description":1694},"21KQ-suQ97sqzwLlRHR_XuI9SKEIB5kyxOC18ePqzng",[1703,1705],{"title":369,"path":370,"stem":371,"description":1704,"icon":111},"Como a entrada vira um arraste — os sensores de ponteiro e de teclado, restrições de ativação, canDrag, sensores seus e arrastes que você roteiriza com @vue-dnd-kit\u002Factions.",{"title":376,"path":377,"stem":378,"description":1706,"icon":121},"O arrastar e soltar do próprio navegador, como arrastes da biblioteca — arquivos, links e texto de outros apps para alvos de drop e listas que abrem espaço para eles, itens arrastados para fora da página, e entre janelas do seu app.",1793925623074]
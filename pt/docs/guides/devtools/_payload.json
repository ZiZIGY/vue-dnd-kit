,489,491],"h3",{"id":490},"_1-add-the-packages","1. Adicione os pacotes",[493,494,499],"pre",{"className":495,"code":496,"language":497,"meta":498,"style":498},"language-bash shiki shiki-themes dnd-light dnd-light dnd-dark","npm i -D @vue-dnd-kit\u002Fdevtools @vue-dnd-kit\u002Factions\n","bash","",[467,500,501],{"__ignoreMap":498},[502,503,506,510,514,517,520],"span",{"class":504,"line":505},"line",1,[502,507,509],{"class":508},"sbwC8","npm",[502,511,513],{"class":512},"sN8r7"," i",[502,515,516],{"class":512}," -D",[502,518,519],{"class":512}," @vue-dnd-kit\u002Fdevtools",[502,521,522],{"class":512}," @vue-dnd-kit\u002Factions\n",[464,524,525,528],{},[467,526,527],{},"@vue-dnd-kit\u002Factions"," é uma peer dependency: os movimentos da aba passam por ele. O npm 7+ e o\npnpm o instalam sozinhos; com o Yarn 1, adicione-o.",[488,530,532],{"id":531},"_2-add-the-plugin","2. Adicione o plugin",[534,535,536,685],"code-group",{},[493,537,542],{"className":538,"code":539,"filename":540,"language":541,"meta":498,"style":498},"language-ts shiki shiki-themes dnd-light dnd-light dnd-dark","import { defineConfig } from 'vite';\nimport vue from '@vitejs\u002Fplugin-vue';\nimport vueDevTools from 'vite-plugin-vue-devtools';\nimport { vueDnDKitDevtools } from '@vue-dnd-kit\u002Fdevtools\u002Fvite';\n\nexport default defineConfig({\n  \u002F\u002F Next to the Vue DevTools plugin: the tab joins its sidebar.\n  plugins: [vueDevTools(), vueDnDKitDevtools(), vue()],\n});\n","vite.config.ts","ts",[467,543,544,570,586,601,620,627,642,649,679],{"__ignoreMap":498},[502,545,546,550,554,558,561,564,567],{"class":504,"line":505},[502,547,549],{"class":548},"s78Kj","import",[502,551,553],{"class":552},"s6cML"," {",[502,555,557],{"class":556},"snmWg"," defineConfig ",[502,559,560],{"class":552},"}",[502,562,563],{"class":548}," from",[502,565,566],{"class":512}," 'vite'",[502,568,569],{"class":552},";\n",[502,571,573,575,578,581,584],{"class":504,"line":572},2,[502,574,549],{"class":548},[502,57
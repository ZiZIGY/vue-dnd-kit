,[531,660,661],{"class":577},"export",[531,663,664],{"class":577}," default",[531,666,667],{"class":537}," defineConfig",[531,669,670],{"class":581},"({\n",[531,672,674],{"class":533,"line":673},7,[531,675,677],{"class":676},"sytrG","  \u002F\u002F Next to the Vue DevTools plugin: the tab joins its sidebar.\n",[531,679,681,685,688,691,694,697,700,702,705],{"class":533,"line":680},8,[531,682,684],{"class":683},"sVvmN","  plugins",[531,686,687],{"class":581},":",[531,689,690],{"class":581}," [",[531,692,693],{"class":537},"vueDevTools",[531,695,696],{"class":581},"(),",[531,698,699],{"class":537}," vueDnDKitDevtools",[531,701,696],{"class":581},[531,703,704],{"class":537}," vue",[531,706,707],{"class":581},"()],\n",[531,709,711],{"class":533,"line":710},9,[531,712,713],{"class":581},"});\n",[522,715,718],{"className":567,"code":716,"filename":717,"language":570,"meta":527,"style":527},"export default defineNuxtConfig({\n  \u002F\u002F With @vue-dnd-kit\u002Fdevtools installed, the tab appears in development.\n  modules: ['@vue-dnd-kit\u002Fnuxt'],\n});\n","nuxt.config.ts",[496,719,720,731,736,751],{"__ignoreMap":527},[531,721,722,724,726,729],{"class":533,"line":534},[531,723,661],{"class":577},[531,725,664],{"class":577},[531,727,728],{"class":537}," defineNuxtConfig",[531,730,670],{"class":581},[531,732,733],{"class":533,"line":601},[531,734,735],{"class":676},"  \u002F\u002F With @vue-dnd-kit\u002Fdevtools installed, the tab appears in development.\n",[531,737,738,741,743,745,748],{"class":533,"line":617},[531,739,740],{"class":683},"  modules",[531,742,687],{"class":581},[531,744,690],{"class":581},[531,746,747],{"class":541},"'@vue-dnd-kit\u002Fnuxt'",[531,749,750],{"class":581},"],\n",[531,752,753],{"class":533,"line":632},[531,754,713],{"class":581},[493,756,757,758,761,762,765,766,769,770,773],{},"Com o Vite, o plugin faz três coisas no servidor de desenvolvimento (",[496,759,760],{},"vite serve","): serve a aba em\n",[496,763,764],{},"\u002F__vue-dnd-kit-devtools\u002F"," (sob a sua ",[496,767,768],{},"base","), a adiciona ao Vue DevTools e faz a página se\nreportar a ela antes de o seu app começar. Nenhum ",[496,771,772],{},"app.use()"," é necessário, e os builds não são\nafetados.",[493,775,776,777,780,781,784],{},"Com o Nuxt, o módulo ",[496,778,779],{},"@vue-dnd-kit\u002Fnuxt"," encontra o pacote, serve a aba, a adiciona ao Nuxt\nDevTools e instala o lado da página com um plugin de cliente. ",[496,782,783],{},"vueDndKit: { devtools: false }"," a\ndesliga.",[517,786,788],{"id":787},"_3-run-the-app-in-development","3. Rode o app em desenvolvimento",[493,790,791,792,795,796,799],{},"Inicie o servidor de desenvolvimento como sempre (",[496,793,794],{},"vite",", ",[496,797,798],{},"nuxt dev",") e abra o app: a aba está\npronta. Todo provider da página aparece nela, seja qual for o app em que ele é renderizado.",[517,801,803],{"id":802},"without-the-plugins","Sem os plugins",[493,805,806,807,810],{},"Para um servidor de desenvolvimento seu, ou uma página que o Vite não serve a partir de um\n",[496,808,809],{},"index.html"," (configurações de SSR), instale o lado da página você mesmo:",[522,812,815],{"className":567,"code":813,"filename":814,"language":570,"meta":527,"style":527},"import { createApp } from 'vue';\nimport { DnDDevtools } from '@vue-dnd-kit\u002Fdevtools';\nimport App from '.\u002FApp.vue';\n\nconst app = createApp(App);\napp.use(DnDDevtools); \u002F\u002F before mount: providers set up earlier aren't seen\napp.mount('#app');\n","main.ts",[496,816,817,835,853,867,871,894,916],{"__ignoreMap":527},[531,818,819,821,823,826,828,830,833],{"class":533,"line":534},[531,820,578],{"class":577},[531,822,582],{"class":581},[531,824,825],{"class":585}," createApp ",[531,827,589],{"class":581},[531,829,592],{"class":577},[531,831,832],{"class":541}," 'vue'",[531,834,598],{"class":581},[531,836,837,839,841,844,846,848,851],{"class":533,"line":601},[531,838,578],{"class":577},[531,840,582],{"class":581},[531,842,843],{"class":585}," DnDDevtools ",[531,845,589],{"class":581},[531,847,592],{"class":577},[531,849,850],{"class":541}," '@vue-dnd-kit\u002Fdevtools'",[531,852,598],{"class":581},[531,854,855,857,860,862,865],{"class":533,"line":617},[531,856,578],{"class":577},[531,858,859],{"class":585}," App ",[531,861,609],{"class":577},[531,863,864],{"class":541}," '.\u002FApp.vue'",[531,866,598],{"class":581},[531,868,869],{"class":533,"line":632},[531,870,655],{"emptyLinePlaceholder":654},[531,872,873,876,879,882,885,888,891],{"class":533,"line":651},[531,874,875],{"class":577},"const",[531,877,878],{"class":585}," app ",[531,880,881],{"class":581},"=",[531,883,884],{"class":537}," createApp",[531,886,887],{"class":581},"(",[531,889,890],{"class":585},"App",[531,892,893],{"class":581},");\n",[531,895,896,899,902,905,907,910,913],{"class":533,"line":658},[531,897,898],{"class":537},"app",[531,900,901],{"class":581},".",[531,903,904],{"class":537},"use",[531,906,887],{"class":581},[531,908,909],{"class":585},"DnDDevtools",[531,911,912],{"class":581},");",[531,914,915],{"class":676}," \u002F\u002F before mount: providers set up earlier aren't seen\n",[531,917,918,920,922,925,927,930],{"class":533,"line":673},[531,919,898],{"class":537},[531,921,901],{"class":581},[531,923,924],{"class":537},"mount",[531,926,887],{"class":581},[531,928,929],{"class":541},"'#app'",[531,931,893],{"class":581},[493,933,934,935,938,939,942,943,946,947,950],{},"Ou importe ",[496,936,937],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," primeiro no arquivo de entrada. Use\n",[496,940,941],{},"vueDnDKitDevtools({ inject: false })"," quando o plugin deve servir a aba, mas você instala o lado da\npágina você mesmo; ",[496,944,945],{},"serveTab()"," de ",[496,948,949],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," é o middleware que serve a aba.",[952,953,954],"note",{},[493,955,956,957,960,961,964,965,968],{},"Em um build de produção, ",[496,958,959],{},"app.use(DnDDevtools)"," e o import ",[496,962,963],{},"auto"," encolhem para quase nada: todo\nponto de entrada verifica ",[496,966,967],{},"process.env.NODE_ENV"," primeiro, e os bundlers descartam o resto. No\nservidor, eles não fazem nada.",[513,970,972],{"id":971},"open-it","Abrir a aba",[974,975,976,997,1012],"ul",{},[977,978,979,982,983,987,988,987,991,994,995,901],"li",{},[501,980,981],{},"Vue DevTools",": ",[984,985],"kbd",{"value":986},"Alt"," + ",[984,989],{"value":990},"Shift",[984,992],{"value":993},"D",", ou o botão do Vue no\nrodapé da página, depois a aba ",[501,996,503],{},[977,998,999,982,1002,987,1004,987,1006,1008,1009,1011],{},[501,1000,1001],{},"Nuxt DevTools",[984,1003],{"value":986},[984,1005],{"value":990},[984,1007],{"value":993},", ou o botão do Nuxt,\ndepois ",[501,1010,503],{}," (na barra lateral ou no menu de itens extras dela).",[977,1013,1014,1017,1018,1021],{},[501,1015,1016],{},"Uma janela própria",": abra ",[496,1019,1020],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," no seu servidor de\ndesenvolvimento, ou o botão ⧉ da aba. Prático em um segundo monitor. Com várias páginas abertas,\num seletor no topo escolhe qual observar.",[1023,1024,1025],"warning",{},[493,1026,1027],{},"Mantenha a aba em uma janela própria, não em uma aba de navegador em segundo plano da mesma janela:\na página precisa continuar visível, e uma página escondida cancela os arrastes.",[513,1029,1031],{"id":1030},"the-tab-at-a-glance","A aba em resumo",[1033,1034,1035,1048],"table",{},[1036,1037,1038],"thead",{},[1039,1040,1041,1045],"tr",{},[1042,1043,1044],"th",{},"Parte",[1042,1046,1047],{},"O que contém",[1049,1050,1051,1068,1080,1095],"tbody",{},[1039,1052,1053,1057],{},[1054,1055,1056],"td",{},"Barra superior",[1054,1058,1059,1060,1063,1064,1067],{},"O que o arraste está fazendo agora (",[496,1061,1062],{},"dragging card-3 → done (accepts)","), a página observada, ",[501,1065,1066],{},"⌖ Pick",", a contagem de opções editadas com um reset, ⧉ (uma janela própria) e o tema.",[1039,1069,1070,1073],{},[1054,1071,1072],{},"Esquerda: o registro",[1054,1074,1075,1076,1079],{},"Todo provider como uma árvore: as listas, árvores, alvos de drop e draggables dele. ",[501,1077,1078],{},"☰"," o mostra ou esconde.",[1039,1081,1082,1092],{},[1054,1083,1084,1085,1088,1089],{},"Meio: ",[501,1086,1087],{},"Map"," e ",[501,1090,1091],{},"Log",[1054,1093,1094],{},"O minimapa ao vivo da página, ou o log dos arrastes.",[1039,1096,1097,1109],{},[1054,1098,1099,1100,795,1103,795,1106],{},"Direita: ",[501,1101,1102],{},"Drive",[501,1104,1105],{},"Options",[501,1107,1108],{},"State",[1054,1110,1111],{},"O joystick e os botões de mover, as opções do nó escolhido, e o que o provider sabe sobre ele.",[493,1113,1114],{},"Escolha um nó no registro ou um item no mapa, e o lado direito o acompanha.",[513,1116,1118],{"id":1117},"the-mini-map","O minimapa",[493,1120,1121],{},"Um card ao vivo por lista, árvore e alvo de drop, com cópias dos itens deles onde estão — os mesmos\nclones que o overlay mostraria, com o CSS da página. Durante um arraste, ele marca:",[974,1123,1124,1135,1138],{},[977,1125,1126,1127,1130,1131,1134],{},"as listas e os alvos que ",[501,1128,1129],{},"aceitam"," o arraste (azul) ou o ",[501,1132,1133],{},"recusam"," (vermelho);",[977,1136,1137],{},"o placeholder, e o alvo sob o ponteiro;",[977,1139,1140,1141,901],{},"o ponteiro, a caixa do overlay e a linha de inserção das listas com ",[496,1142,1143],{},"placeholder: 'indicator'",[493,1145,1146],{},"Um clique escolhe um item e o destaca na página; um clique duplo rola a página até ele. Use o mapa\nquando um drop não vai para onde você espera: ele mostra de relance quais listas aceitam o arraste.",[513,1148,1150],{"id":1149},"drive-the-joystick","Drive: o joystick",[493,1152,1153,1154,1156,1157,1088,1160,1163],{},"Escolha um item — no mapa, no registro ou com ",[501,1155,1066],{},", que captura a próxima pressão em um\ndraggable da página em vez de deixá-la agir — e empurre a alavanca do joystick. O item é pego e se\nmove naquela direção, mais rápido quanto mais longe a alavanca estiver do centro. Solte e ele\npara; ",[501,1158,1159],{},"Drop",[501,1161,1162],{},"Cancel"," encerram o arraste.",[493,1165,1166,1167,1170,1171,1176,1177,1088,1180,1183],{},"É um arraste por ponteiro de verdade de um sensor chamado ",[496,1168,1169],{},"devtools",", feito com a\n",[1172,1173,1175],"a",{"href":1174},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API pública de sensores",": as listas ordenam sob ele, os\ncontêineres rolam automaticamente nas bordas, e ",[496,1178,1179],{},"onBeforeDrop",[496,1181,1182],{},"onDrop"," rodam como em qualquer\narraste. Itens desativados não são pegos. Um arraste por teclado iniciado pela página também pode\nser conduzido.",[493,1185,1186,1187,1193],{},"Os itens de listas ordenáveis também ganham botões: para cima, para baixo, para o início, para o\nfim, para outra lista do grupo. Cada um é um arraste por teclado de\n",[1172,1188,1190],{"href":1189},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[496,1191,1192],{},"moveItem",". Embaixo do joystick, uma cópia grande do que o\noverlay mostra.",[1033,1195,1196,1206],{},[1036,1197,1198],{},[1039,1199,1200,1203],{},[1042,1201,1202],{},"Tecla, na aba",[1042,1204,1205],{},"Faz",[1049,1207,1208,1231,1241,1255,1265],{},[1039,1209,1210,1225],{},[1054,1211,1212,1213,1216,1217,1216,1220,1216,1223],{},"Setas ou ",[984,1214],{"value":1215},"W"," ",[984,1218],{"value":1219},"A",[984,1221],{"value":1222},"S",[984,1224],{"value":993},[1054,1226,1227,1228,1230],{},"Empurra a alavanca naquela direção, até a metade; com ",[984,1229],{"value":990},", até o fim",[1039,1232,1233,1238],{},[1054,1234,1235],{},[984,1236],{"value":1237},"G",[1054,1239,1240],{},"Pega o item escolhido",[1039,1242,1243,1252],{},[1054,1244,1245,1248,1249],{},[984,1246],{"value":1247},"Space"," \u002F ",[984,1250],{"value":1251},"Enter",[1054,1253,1254],{},"Solta",[1039,1256,1257,1262],{},[1054,1258,1259],{},[984,1260],{"value":1261},"Escape",[1054,1263,1264],{},"Cancela",[1039,1266,1267,1272],{},[1054,1268,1269],{},[984,1270],{"value":1271},"P",[1054,1273,1274],{},"Escolhe na página",[513,1276,1278],{"id":1277},"options","Opções",[493,1280,1281,1282,687],{},"Toda opção que não é um callback pode ser editada enquanto o app roda. Escolha o nó e abra\n",[501,1283,1105],{},[1033,1285,1286,1295],{},[1036,1287,1288],{},[1039,1289,1290,1293],{},[1042,1291,1292],{},"Nó",[1042,1294,1278],{},[1049,1296,1297,1339,1378,1396,1413],{},[1039,1298,1299,1302],{},[1054,1300,1301],{},"Provider",[1054,1303,1304,795,1307,795,1310,795,1313,1316,1317,795,1320,795,1323,795,1326,795,1329,795,1332,795,1335,1338],{},[496,1305,1306],{},"overlayFit",[496,1308,1309],{},"autoScroll",[496,1311,1312],{},"collision",[496,1314,1315],{},"modifiers"," (os da biblioteca, pelo nome), ",[496,1318,1319],{},"animation",[496,1321,1322],{},"dropAnimation",[496,1324,1325],{},"animateChanges",[496,1327,1328],{},"activation",[496,1330,1331],{},"keyboard",[496,1333,1334],{},"haptics",[496,1336,1337],{},"copyModifier","…",[1039,1340,1341,1344],{},[1054,1342,1343],{},"Lista",[1054,1345,1346,795,1349,795,1352,795,1355,795,1358,795,1361,795,1364,795,1367,795,1370,795,1372,795,1374,795,1376],{},[496,1347,1348],{},"disabled",[496,1350,1351],{},"strategy",[496,1353,1354],{},"placeholder",[496,1356,1357],{},"behavior",[496,1359,1360],{},"multiple",[496,1362,1363],{},"sort",[496,1365,1366],{},"dropOutside",[496,1368,1369],{},"acceptMode",[496,1371,1319],{},[496,1373,1325],{},[496,1375,1309],{},[496,1377,1315],{},[1039,1379,1380,1383],{},[1054,1381,1382],{},"Árvore",[1054,1384,1385,795,1387,795,1390,795,1393,1338],{},[496,1386,1354],{},[496,1388,1389],{},"indentation",[496,1391,1392],{},"nesting",[496,1394,1395],{},"maxDepth",[1039,1397,1398,1401],{},[1054,1399,1400],{},"Alvo de drop",[1054,1402,1403,795,1405,795,1408,795,1411],{},[496,1404,1348],{},[496,1406,1407],{},"priority",[496,1409,1410],{},"accept",[496,1412,1369],{},[1039,1414,1415,1418],{},[1054,1416,1417],{},"Item",[1054,1419,1420,795,1422,795,1425],{},[496,1421,1348],{},[496,1423,1424],{},"keyboardMode",[496,1426,1328],{},[493,1428,1429],{},"Uma edição vale na hora, só para esta página, e nunca é gravada no seu código: a biblioteca lê o\nnovo valor onde lê a opção. Ela dura até você resetá-la (↺ por opção, ou o reset da barra\nsuperior), o provider ser desmontado ou a página recarregar. Uma opção editada mostra ao lado o\nvalor do seu código. Os itens montados enquanto uma edição está ativa — linhas de uma lista\nvirtual — também a recebem.",[513,1431,1433],{"id":1432},"state","Estado",[493,1435,1436],{},"O que cada provider sabe, para o nó que você escolheu:",[974,1438,1439,1446,1457],{},[977,1440,1441,1442,1445],{},"a ",[501,1443,1444],{},"sessão de arraste",": o status, os ids, os itens e o sensor ativos, o alvo e se ele aceita, o\nponteiro, o overlay, a sessão do grupo ordenável e a linha de inserção;",[977,1447,1448,1449,1452,1453,1456],{},"uma ",[501,1450,1451],{},"lista",": a ordem dela e o rascunho; uma ",[501,1454,1455],{},"árvore",": as linhas dela;",[977,1458,1459,1460,1463,1464,1467],{},"um ",[501,1461,1462],{},"item",": o tipo, os dados e a posição dele; um ",[501,1465,1466],{},"alvo de drop",": as regras dele.",[493,1469,1470],{},"Os itens são montados e desmontados sem eventos: o registro se atualiza em até um segundo.",[513,1472,1091],{"id":1473},"log",[493,1475,1476],{},"Uma faixa por arraste, em ordem:",[1033,1478,1479,1489],{},[1036,1480,1481],{},[1039,1482,1483,1486],{},[1042,1484,1485],{},"Entrada",[1042,1487,1488],{},"O que diz",[1049,1490,1491,1501,1514,1527,1539,1557],{},[1039,1492,1493,1498],{},[1054,1494,1495],{},[496,1496,1497],{},"drag start",[1054,1499,1500],{},"Os ids, o sensor e se foi por toque, a lista de onde vem.",[1039,1502,1503,1511],{},[1054,1504,1505,795,1508],{},[496,1506,1507],{},"over",[496,1509,1510],{},"left",[1054,1512,1513],{},"Cada alvo em que entrou e de que saiu, e se ele aceita.",[1039,1515,1516,1521],{},[1054,1517,1518],{},[496,1519,1520],{},"release",[1054,1522,1523,1524,1526],{},"O alvo sobre o qual foi solto, enquanto o ",[496,1525,1179],{}," decide.",[1039,1528,1529,1533],{},[1054,1530,1531],{},[496,1532,1179],{},[1054,1534,1535,1536,1538],{},"O veredito: aceito, alguns aceitos, rejeitado por um hook, recusado pelo ",[496,1537,1410],{}," do alvo, e quanto tempo os hooks levaram.",[1039,1540,1541,1546],{},[1054,1542,1543],{},[496,1544,1545],{},"drop",[1054,1547,1548,1549,1552,1553,1556],{},"O alvo; para listas ordenáveis, o movimento, ",[496,1550,1551],{},"e.result",", e se ",[496,1554,1555],{},"preventDefault()"," foi chamado.",[1039,1558,1559,1564],{},[1054,1560,1561],{},[496,1562,1563],{},"cancel",[1054,1565,1566,1567,1570,1571,1573],{},"O motivo: cancelado (Escape, ",[496,1568,1569],{},"cancel()","), rejeitado por um hook, ou recusado pelo ",[496,1572,1410],{}," do alvo.",[493,1575,1576,1577,1088,1580,1583,1584,1587,1588,1591],{},"Também ",[496,1578,1579],{},"auto-scroll on",[496,1581,1582],{},"off",", os textos de ",[496,1585,1586],{},"announcement"," (escondidos por padrão) e, fora dos\narrastes, ",[496,1589,1590],{},"animate"," (mudanças nos itens de uma lista que nenhum arraste fez). Clique em uma entrada\npara ver os dados dela. Uma aba aberta depois recebe os arrastes até então.",[513,1593,1595],{"id":1594},"debug-a-drop-step-by-step","Depurar um drop, passo a passo",[493,1597,1598],{},"Um card não entra em uma coluna. Com a aba aberta:",[1600,1601,1602,1611,1628,1649],"ol",{},[977,1603,1604,1607,1608,1610],{},[501,1605,1606],{},"Reproduza"," à mão, ou com ",[501,1609,1102],{},", para que as suas mãos fiquem livres para a aba.",[977,1612,1613,1616,1617,1620,1621,1624,1625,1627],{},[501,1614,1615],{},"Observe o mapa"," enquanto o card está sobre a coluna. Vermelho significa que a lista recusa o\ncard: veja o ",[496,1618,1619],{},"group"," dela (",[496,1622,1623],{},"put",") ou o ",[496,1626,1410],{}," do alvo. Azul significa que ela aceita, e o\nproblema vem depois.",[977,1629,1630,1633,1634,1636,1637,1639,1640,1642,1643,1645,1646,1648],{},[501,1631,1632],{},"Leia o log"," desse arraste. ",[496,1635,1179],{}," diz quem disse não — um hook, ou o ",[496,1638,1410],{}," do\nalvo. Se o drop foi concluído mas os seus dados não mudaram, a entrada ",[496,1641,1545],{}," diz se\n",[496,1644,1555],{}," foi chamado e o que ",[496,1647,1551],{}," continha: uma lista controlada precisa\naplicá-lo ela mesma.",[977,1650,1651,1654,1655,1657,1658,1660,1661,795,1663,1665],{},[501,1652,1653],{},"Teste uma correção ao vivo"," em ",[501,1656,1105],{}," — um ",[496,1659,1369],{}," mais flexível, outra\n",[496,1662,1312],{},[496,1664,1143],{}," — e depois escreva no seu código a que funcionar.",[513,1667,1669],{"id":1668},"how-it-works","Como funciona",[493,1671,1672,1673,1676],{},"Os providers se reportam a um hook que o lado da página instala. Até uma aba observar a página,\neles só são registrados; depois disso, a página escuta como qualquer monitor e envia à aba o que\nela mostra — a cada 40 ms durante um arraste, duas vezes por segundo no resto do tempo — e para\nassim que nenhuma aba a observa por alguns segundos. A aba conversa com a página por um\n",[496,1674,1675],{},"BroadcastChannel"," da origem da página. Ela não muda nada além do que você pede: os arrastes, a\nseleção e as substituições de opções.",[1678,1679,1680],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s78Kj, html code.shiki .s78Kj{--shiki-light:#1F8A5B;--shiki-default:#1F8A5B;--shiki-dark:#42B883}html pre.shiki code .s6cML, html code.shiki .s6cML{--shiki-light:#5B5B63;--shiki-default:#5B5B63;--shiki-dark:#9F9FA9}html pre.shiki code .snmWg, html code.shiki .snmWg{--shiki-light:#27272A;--shiki-default:#27272A;--shiki-dark:#E4E4E7}html pre.shiki code .sytrG, html code.shiki .sytrG{--shiki-light:#85858D;--shiki-light-font-style:italic;--shiki-default:#85858D;--shiki-default-font-style:italic;--shiki-dark:#6E6E78;--shiki-dark-font-style:italic}html pre.shiki code .sVvmN, html code.shiki .sVvmN{--shiki-light:#7C4DCC;--shiki-default:#7C4DCC;--shiki-dark:#C3A6FF}",{"title":527,"searchDepth":617,"depth":617,"links":1682},[1683,1689,1690,1691,1692,1693,1694,1695,1696,1697],{"id":515,"depth":601,"text":303,"children":1684},[1685,1686,1687,1688],{"id":519,"depth":617,"text":520},{"id":560,"depth":617,"text":561},{"id":787,"depth":617,"text":788},{"id":802,"depth":617,"text":803},{"id":971,"depth":601,"text":972},{"id":1030,"depth":601,"text":1031},{"id":1117,"depth":601,"text":1118},{"id":1149,"depth":601,"text":1150},{"id":1277,"depth":601,"text":1278},{"id":1432,"depth":601,"text":1433},{"id":1473,"depth":601,"text":1091},{"id":1594,"depth":601,"text":1595},{"id":1668,"depth":601,"text":1669},"Uma aba Vue DnD Kit no Vue DevTools e no Nuxt DevTools — um minimapa ao vivo, um joystick que arrasta de verdade, edição de opções ao vivo e um log de cada arraste.","md",null,{"source":1702},"6f7e373d0b",{"icon":116},{"title":113,"description":1698},"21KQ-suQ97sqzwLlRHR_XuI9SKEIB5kyxOC18ePqzng",[1707,1709],{"title":373,"path":374,"stem":375,"description":1708,"icon":111},"Como a entrada vira um arraste — os sensores de ponteiro e de teclado, restrições de ativação, canDrag, sensores seus e arrastes que você roteiriza com @vue-dnd-kit\u002Factions.",{"title":380,"path":381,"stem":382,"description":1710,"icon":121},"O arrastar e soltar do próprio navegador, como arrastes da biblioteca — arquivos, links e texto de outros apps para alvos de drop e listas que abrem espaço para eles, itens arrastados para fora da página, e entre janelas do seu app.",1793926398318]
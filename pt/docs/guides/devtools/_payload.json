ervidor de desenvolvimento seu, ou uma página que o Vite não serve a partir de um\n",[472,784,785],{},"index.html"," (configurações de SSR), instale o lado da página você mesmo:",[498,788,791],{"className":543,"code":789,"filename":790,"language":546,"meta":503,"style":503},"import { createApp } from 'vue';\nimport { DnDDevtools } from '@vue-dnd-kit\u002Fdevtools';\nimport App from '.\u002FApp.vue';\n\nconst app = createApp(App);\napp.use(DnDDevtools); \u002F\u002F before mount: providers set up earlier aren't seen\napp.mount('#app');\n","main.ts",[472,792,793,811,829,843,847,870,892],{"__ignoreMap":503},[507,794,795,797,799,802,804,806,809],{"class":509,"line":510},[507,796,554],{"class":553},[507,798,558],{"class":557},[507,800,801],{"class":561}," createApp ",[507,803,565],{"class":557},[507,805,568],{"class":553},[507,807,808],{"class":517}," 'vue'",[507,810,574],{"class":557},[507,812,813,815,817,820,822,824,827],{"class":509,"line":577},[507,814,554],{"class":553},[507,816,558],{"class":557},[507,818,819],{"class":561}," DnDDevtools ",[507,821,565],{"class":557},[507,823,568],{"class":553},[507,825,826],{"class":517}," '@vue-dnd-kit\u002Fdevtools'",[507,828,574],{"class":557},[507,830,831,833,836,838,841],{"class":509,"line":593},[507,832,554],{"class":553},[507,834,835],{"class":561}," App ",[507,837,585],{"class":553},[507,839,840],{"class":517}," '.\u002FApp.vue'",[507,842,574],{"class":557},[507,844,845],{"class":509,"line":608},[507,846,631],{"emptyLinePlaceholder":630},[507,848,849,852,855,858,861,864,867],{"class":509,"line":627},[507,850,851],{"class":553},"const",[507,853,854],{"class":561}," app ",[507,856,857],{"class":557},"=",[507,859,860],{"class":513}," createApp",[507,862,863],{"class":557},"(",[507,865,866],{"class":561},"App",[507,868,869],{"class":557},");\n",[507,871,872,875,878,881,883,886,889],{"class":509,"line":634},[507,873,874],{"class":513},"app",[507,876,877],{"class":557},".",[507,879,880],{"class":513},"use",[507,882,863],{"class":557},[507,884,885],{"class":561},"DnDDevtools",[507,887,888],{"class":557},");",[507,890,891],{"class":652}," \u002F\u002F before mount: providers set up earlier aren't seen\n",[507,893,894,896,898,901,903,906],{"class":509,"line":649},[507,895,874],{"class":513},[507,897,877],{"class":557},[507,899,900],{"class":513},"mount",[507,902,863],{"class":557},[507,904,905],{"class":517},"'#app'",[507,907,869],{"class":557},[469,909,910,911,914,915,918,919,922,923,926],{},"Ou importe ",[472,912,913],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," primeiro no arquivo de entrada. Use\n",[472,916,917],{},"vueDnDKitDevtools({ inject: false })"," quando o plugin deve servir a aba, mas você instala o lado da\npágina você mesmo; ",[472,920,921],{},"serveTab()"," de ",[472,924,925],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," é o middleware que serve a aba.",[928,929,930],"note",{},[469,931,932,933,936,937,940,941,944],{},"Em um build de produção, ",[472,934,935],{},"app.use(DnDDevtools)"," e o import ",[472,938,939],{},"auto"," encolhem para quase nada: todo\nponto de entrada verifica ",[472,942,943],{},"process.env.NODE_ENV"," primeiro, e os bundlers descartam o resto. No\nservidor, eles não fazem nada.",[489,946,948],{"id":947},"open-it","Abrir a aba",[950,951,952,973,988],"ul",{},[953,954,955,958,959,963,964,963,967,970,971,877],"li",{},[477,956,957],{},"Vue DevTools",": ",[960,961],"kbd",{"value":962},"Alt"," + ",[960,965],{"value":966},"Shift",[960,968],{"value":969},"D",", ou o botão do Vue no\nrodapé da página, depois a aba ",[477,972,479],{},[953,974,975,958,978,963,980,963,982,984,985,987],{},[477,976,977],{},"Nuxt DevTools",[960,979],{"value":962},[960,981],{"value":966},[960,983],{"value":969},", ou o botão do Nuxt,\ndepois ",[477,986,479],{}," (na barra lateral ou no menu de itens extras dela).",[953,989,990,993,994,997],{},[477,991,992],{},"Uma janela própria",": abra ",[472,995,996],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," no seu servidor de\ndesenvolvimento, ou o botão ⧉ da aba. Prático em um segundo monitor. Com várias páginas abertas,\num seletor no topo escolhe qual observar.",[999,1000,1001],"warning",{},[469,1002,1003],{},"Mantenha a aba em uma janela própria, não em uma aba de navegador em segundo plano da mesma janela:\na página precisa continuar visível, e uma página escondida cancela os arrastes.",[489,1005,1007],{"id":1006},"the-tab-at-a-glance","A aba em resumo",[1009,1010,1011,1024],"table",{},[1012,1013,1014],"thead",{},[1015,1016,1017,1021],"tr",{},[1018,1019,1020],"th",{},"Parte",[1018,1022,1023],{},"O que contém",[1025,1026,1027,1044,1056,1071],"tbody",{},[1015,1028,1029,1033],{},[1030,1031,1032],"td",{},"Barra superior",[1030,1034,1035,1036,1039,1040,1043],{},"O que o arraste está fazendo agora (",[472,1037,1038],{},"dragging card-3 → done (accepts)","), a página observada, ",[477,1041,1042],{},"⌖ Pick",", a contagem de opções editadas com um reset, ⧉ (uma janela própria) e o tema.",[1015,1045,1046,1049],{},[1030,1047,1048],{},"Esquerda: o registro",[1030,1050,1051,1052,1055],{},"Todo provider como uma árvore: as listas, árvores, alvos de drop e draggables dele. ",[477,1053,1054],{},"☰"," o mostra ou esconde.",[1015,1057,1058,1068],{},[1030,1059,1060,1061,1064,1065],{},"Meio: ",[477,1062,1063],{},"Map"," e ",[477,1066,1067],{},"Log",[1030,1069,1070],{},"O minimapa ao vivo da página, ou o log dos arrastes.",[1015,1072,1073,1085],{},[1030,1074,1075,1076,771,1079,771,1082],{},"Direita: ",[477,1077,1078],{},"Drive",[477,1080,1081],{},"Options",[477,1083,1084],{},"State",[1030,1086,1087],{},"O joystick e os botões de mover, as opções do nó escolhido, e o que o provider sabe sobre ele.",[469,1089,1090],{},"Escolha um nó no registro ou um item no mapa, e o lado direito o acompanha.",[489,1092,1094],{"id":1093},"the-mini-map","O minimapa",[469,1096,1097],{},"Um card ao vivo por lista, árvore e alvo de drop, com cópias dos itens deles onde estão — os mesmos\nclones que o overlay mostraria, com o CSS da página. Durante um arraste, ele marca:",[950,1099,1100,1111,1114],{},[953,1101,1102,1103,1106,1107,1110],{},"as listas e os alvos que ",[477,1104,1105],{},"aceitam"," o arraste (azul) ou o ",[477,1108,1109],{},"recusam"," (vermelho);",[953,1112,1113],{},"o placeholder, e o alvo sob o ponteiro;",[953,1115,1116,1117,877],{},"o ponteiro, a caixa do overlay e a linha de inserção das listas com ",[472,1118,1119],{},"placeholder: 'indicator'",[469,1121,1122],{},"Um clique escolhe um item e o destaca na página; um clique duplo rola a página até ele. Use o mapa\nquando um drop não vai para onde você espera: ele mostra de relance quais listas aceitam o arraste.",[489,1124,1126],{"id":1125},"drive-the-joystick","Drive: o joystick",[469,1128,1129,1130,1132,1133,1064,1136,1139],{},"Escolha um item — no mapa, no registro ou com ",[477,1131,1042],{},", que captura a próxima pressão em um\ndraggable da página em vez de deixá-la agir — e empurre a alavanca do joystick. O item é pego e se\nmove naquela direção, mais rápido quanto mais longe a alavanca estiver do centro. Solte e ele\npara; ",[477,1134,1135],{},"Drop",[477,1137,1138],{},"Cancel"," encerram o arraste.",[469,1141,1142,1143,1146,1147,1152,1153,1064,1156,1159],{},"É um arraste por ponteiro de verdade de um sensor chamado ",[472,1144,1145],{},"devtools",", feito com a\n",[1148,1149,1151],"a",{"href":1150},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API pública de sensores",": as listas ordenam sob ele, os\ncontêineres rolam automaticamente nas bordas, e ",[472,1154,1155],{},"onBeforeDrop",[472,1157,1158],{},"onDrop"," rodam como em qualquer\narraste. Itens desativados não são pegos. Um arraste por teclado iniciado pela página também pode\nser conduzido.",[469,1161,1162,1163,1169],{},"Os itens de listas ordenáveis também ganham botões: para cima, para baixo, para o início, para o\nfim, para outra lista do grupo. Cada um é um arraste por teclado de\n",[1148,1164,1166],{"href":1165},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[472,1167,1168],{},"moveItem",". Embaixo do joystick, uma cópia grande do que o\noverlay mostra.",[1009,1171,1172,1182],{},[1012,1173,1174],{},[1015,1175,1176,1179],{},[1018,1177,1178],{},"Tecla, na aba",[1018,1180,1181],{},"Faz",[1025,1183,1184,1207,1217,1231,1241],{},[1015,1185,1186,1201],{},[1030,1187,1188,1189,1192,1193,1192,1196,1192,1199],{},"Setas ou ",[960,1190],{"value":1191},"W"," ",[960,1194],{"value":1195},"A",[960,1197],{"value":1198},"S",[960,1200],{"value":969},[1030,1202,1203,1204,1206],{},"Empurra a alavanca naquela direção, até a metade; com ",[960,1205],{"value":966},", até o fim",[1015,1208,1209,1214],{},[1030,1210,1211],{},[960,1212],{"value":1213},"G",[1030,1215,1216],{},"Pega o item escolhido",[1015,1218,1219,1228],{},[1030,1220,1221,1224,1225],{},[960,1222],{"value":1223},"Space"," \u002F ",[960,1226],{"value":1227},"Enter",[1030,1229,1230],{},"Solta",[1015,1232,1233,1238],{},[1030,1234,1235],{},[960,1236],{"value":1237},"Escape",[1030,1239,1240],{},"Cancela",[1015,1242,1243,1248],{},[1030,1244,1245],{},[960,1246],{"value":1247},"P",[1030,1249,1250],{},"Escolhe na página",[489,1252,1254],{"id":1253},"options","Opções",[469,1256,1257,1258,663],{},"Toda opção que não é um callback pode ser editada enquanto o app roda. Escolha o nó e abra\n",[477,1259,1081],{},[1009,1261,1262,1271],{},[1012,1263,1264],{},[1015,1265,1266,1269],{},[1018,1267,1268],{},"Nó",[1018,1270,1254],{},[1025,1272,1273,1315,1354,1372,1389],{},[1015,1274,1275,1278],{},[1030,1276,1277],{},"Provider",[1030,1279,1280,771,1283,771,1286,771,1289,1292,1293,771,1296,771,1299,771,1302,771,1305,771,1308,771,1311,1314],{},[472,1281,1282],{},"overlayFit",[472,1284,1285],{},"autoScroll",[472,1287,1288],{},"collision",[472,1290,1291],{},"modifiers"," (os da biblioteca, pelo nome), ",[472,1294,1295],{},"animation",[472,1297,1298],{},"dropAnimation",[472,1300,1301],{},"animateChanges",[472,1303,1304],{},"activation",[472,1306,1307],{},"keyboard",[472,1309,1310],{},"haptics",[472,1312,1313],{},"copyModifier","…",[1015,1316,1317,1320],{},[1030,1318,1319],{},"Lista",[1030,1321,1322,771,1325,771,1328,771,1331,771,1334,771,1337,771,1340,771,1343,771,1346,771,1348,771,1350,771,1352],{},[472,1323,1324],{},"disabled",[472,1326,1327],{},"strategy",[472,1329,1330],{},"placeholder",[472,1332,1333],{},"behavior",[472,1335,1336],{},"multiple",[472,1338,1339],{},"sort",[472,1341,1342],{},"dropOutside",[472,1344,1345],{},"acceptMode",[472,1347,1295],{},[472,1349,1301],{},[472,1351,1285],{},[472,1353,1291],{},[1015,1355,1356,1359],{},[1030,1357,1358],{},"Árvore",[1030,1360,1361,771,1363,771,1366,771,1369,1314],{},[472,1362,1330],{},[472,1364,1365],{},"indentation",[472,1367,1368],{},"nesting",[472,1370,1371],{},"maxDepth",[1015,1373,1374,1377],{},[1030,1375,1376],{},"Alvo de drop",[1030,1378,1379,771,1381,771,1384,771,1387],{},[472,1380,1324],{},[472,1382,1383],{},"priority",[472,1385,1386],{},"accept",[472,1388,1345],{},[1015,1390,1391,1394],{},[1030,1392,1393],{},"Item",[1030,1395,1396,771,1398,771,1401],{},[472,1397,1324],{},[472,1399,1400],{},"keyboardMode",[472,1402,1304],{},[469,1404,1405],{},"Uma edição vale na hora, só para esta página, e nunca é gravada no seu código: a biblioteca lê o\nnovo valor onde lê a opção. Ela dura até você resetá-la (↺ por opção, ou o reset da barra\nsuperior), o provider ser desmontado ou a página recarregar. Uma opção editada mostra ao lado o\nvalor do seu código. Os itens montados enquanto uma edição está ativa — linhas de uma lista\nvirtual — também a recebem.",[489,1407,1409],{"id":1408},"state","Estado",[469,1411,1412],{},"O que cada provider sabe, para o nó que você escolheu:",[950,1414,1415,1422,1433],{},[953,1416,1417,1418,1421],{},"a ",[477,1419,1420],{},"sessão de arraste",": o status, os ids, os itens e o sensor ativos, o alvo e se ele aceita, o\nponteiro, o overlay, a sessão do grupo ordenável e a linha de inserção;",[953,1423,1424,1425,1428,1429,1432],{},"uma ",[477,1426,1427],{},"lista",": a ordem dela e o rascunho; uma ",[477,1430,1431],{},"árvore",": as linhas dela;",[953,1434,1435,1436,1439,1440,1443],{},"um ",[477,1437,1438],{},"item",": o tipo, os dados e a posição dele; um ",[477,1441,1442],{},"alvo de drop",": as regras dele.",[469,1445,1446],{},"Os itens são montados e desmontados sem eventos: o registro se atualiza em até um segundo.",[489,1448,1067],{"id":1449},"log",[469,1451,1452],{},"Uma faixa por arraste, em ordem:",[1009,1454,1455,1465],{},[1012,1456,1457],{},[1015,1458,1459,1462],{},[1018,1460,1461],{},"Entrada",[1018,1463,1464],{},"O que diz",[1025,1466,1467,1477,1490,1503,1515,1533],{},[1015,1468,1469,1474],{},[1030,1470,1471],{},[472,1472,1473],{},"drag start",[1030,1475,1476],{},"Os ids, o sensor e se foi por toque, a lista de onde vem.",[1015,1478,1479,1487],{},[1030,1480,1481,771,1484],{},[472,1482,1483],{},"over",[472,1485,1486],{},"left",[1030,1488,1489],{},"Cada alvo em que entrou e de que saiu, e se ele aceita.",[1015,1491,1492,1497],{},[1030,1493,1494],{},[472,1495,1496],{},"release",[1030,1498,1499,1500,1502],{},"O alvo sobre o qual foi solto, enquanto o ",[472,1501,1155],{}," decide.",[1015,1504,1505,1509],{},[1030,1506,1507],{},[472,1508,1155],{},[1030,1510,1511,1512,1514],{},"O veredito: aceito, alguns aceitos, rejeitado por um hook, recusado pelo ",[472,1513,1386],{}," do alvo, e quanto tempo os hooks levaram.",[1015,1516,1517,1522],{},[1030,1518,1519],{},[472,1520,1521],{},"drop",[1030,1523,1524,1525,1528,1529,1532],{},"O alvo; para listas ordenáveis, o movimento, ",[472,1526,1527],{},"e.result",", e se ",[472,1530,1531],{},"preventDefault()"," foi chamado.",[1015,1534,1535,1540],{},[1030,1536,1537],{},[472,1538,1539],{},"cancel",[1030,1541,1542,1543,1546,1547,1549],{},"O motivo: cancelado (Escape, ",[472,1544,1545],{},"cancel()","), rejeitado por um hook, ou recusado pelo ",[472,1548,1386],{}," do alvo.",[469,1551,1552,1553,1064,1556,1559,1560,1563,1564,1567],{},"Também ",[472,1554,1555],{},"auto-scroll on",[472,1557,1558],{},"off",", os textos de ",[472,1561,1562],{},"announcement"," (escondidos por padrão) e, fora dos\narrastes, ",[472,1565,1566],{},"animate"," (mudanças nos itens de uma lista que nenhum arraste fez). Clique em uma entrada\npara ver os dados dela. Uma aba aberta depois recebe os arrastes até então.",[489,1569,1571],{"id":1570},"debug-a-drop-step-by-step","Depurar um drop, passo a passo",[469,1573,1574],{},"Um card não entra em uma coluna. Com a aba aberta:",[1576,1577,1578,1587,1604,1625],"ol",{},[953,1579,1580,1583,1584,1586],{},[477,1581,1582],{},"Reproduza"," à mão, ou com ",[477,1585,1078],{},", para que as suas mãos fiquem livres para a aba.",[953,1588,1589,1592,1593,1596,1597,1600,1601,1603],{},[477,1590,1591],{},"Observe o mapa"," enquanto o card está sobre a coluna. Vermelho significa que a lista recusa o\ncard: veja o ",[472,1594,1595],{},"group"," dela (",[472,1598,1599],{},"put",") ou o ",[472,1602,1386],{}," do alvo. Azul significa que ela aceita, e o\nproblema vem depois.",[953,1605,1606,1609,1610,1612,1613,1615,1616,1618,1619,1621,1622,1624],{},[477,1607,1608],{},"Leia o log"," desse arraste. ",[472,1611,1155],{}," diz quem disse não — um hook, ou o ",[472,1614,1386],{}," do\nalvo. Se o drop foi concluído mas os seus dados não mudaram, a entrada ",[472,1617,1521],{}," diz se\n",[472,1620,1531],{}," foi chamado e o que ",[472,1623,1527],{}," continha: uma lista controlada precisa\naplicá-lo ela mesma.",[953,1626,1627,1630,1631,1633,1634,1636,1637,771,1639,1641],{},[477,1628,1629],{},"Teste uma correção ao vivo"," em ",[477,1632,1081],{}," — um ",[472,1635,1345],{}," mais flexível, outra\n",[472,1638,1288],{},[472,1640,1119],{}," — e depois escreva no seu código a que funcionar.",[489,1643,1645],{"id":1644},"how-it-works","Como funciona",[469,1647,1648,1649,1652],{},"Os providers se reportam a um hook que o lado da página instala. Até uma aba observar a página,\neles só são registrados; depois disso, a página escuta como qualquer monitor e envia à aba o que\nela mostra — a cada 40 ms durante um arraste, duas vezes por segundo no resto do tempo — e para\nassim que nenhuma aba a observa por alguns segundos. A aba conversa com a página por um\n",[472,1650,1651],{},"BroadcastChannel"," da origem da página. Ela não muda nada além do que você pede: os arrastes, a\nseleção e as substituições de opções.",[1654,1655,1656],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s78Kj, html code.shiki .s78Kj{--shiki-light:#1F8A5B;--shiki-default:#1F8A5B;--shiki-dark:#42B883}html pre.shiki code .s6cML, html code.shiki .s6cML{--shiki-light:#5B5B63;--shiki-default:#5B5B63;--shiki-dark:#9F9FA9}html pre.shiki code .snmWg, html code.shiki .snmWg{--shiki-light:#27272A;--shiki-default:#27272A;--shiki-dark:#E4E4E7}html pre.shiki code .sytrG, html code.shiki .sytrG{--shiki-light:#85858D;--shiki-light-font-style:italic;--shiki-default:#85858D;--shiki-default-font-style:italic;--shiki-dark:#6E6E78;--shiki-dark-font-style:italic}html pre.shiki code .sVvmN, html code.shiki .sVvmN{--shiki-light:#7C4DCC;--shiki-default:#7C4DCC;--shiki-dark:#C3A6FF}",{"title":503,"searchDepth":593,"depth":593,"links":1658},[1659,1665,1666,1667,1668,1669,1670,1671,1672,1673],{"id":491,"depth":577,"text":290,"children":1660},[1661,1662,1663,1664],{"id":495,"depth":593,"text":496},{"id":536,"depth":593,"text":537},{"id":763,"depth":593,"text":764},{"id":778,"depth":593,"text":779},{"id":947,"depth":577,"text":948},{"id":1006,"depth":577,"text":1007},{"id":1093,"depth":577,"text":1094},{"id":1125,"depth":577,"text":1126},{"id":1253,"depth":577,"text":1254},{"id":1408,"depth":577,"text":1409},{"id":1449,"depth":577,"text":1067},{"id":1570,"depth":577,"text":1571},{"id":1644,"depth":577,"text":1645},"Uma aba Vue DnD Kit no Vue DevTools e no Nuxt DevTools — um minimapa ao vivo, um joystick que arrasta de verdade, edição de opções ao vivo e um log de cada arraste.","md",null,{"source":1678},"6f7e373d0b",{"icon":116},{"title":113,"description":1674},"21KQ-suQ97sqzwLlRHR_XuI9SKEIB5kyxOC18ePqzng",[1683,1685],{"title":356,"path":357,"stem":358,"description":1684,"icon":111},"Como a entrada vira um arraste — os sensores de ponteiro e de teclado, restrições de ativação, canDrag, sensores seus e arrastes que você roteiriza com @vue-dnd-kit\u002Factions.",{"title":363,"path":364,"stem":365,"description":1686,"icon":121},"O arrastar e soltar do próprio navegador, como arrastes da biblioteca — arquivos, links e texto de outros apps para alvos de drop e listas que abrem espaço para eles, itens arrastados para fora da página, e entre janelas do seu app.",1793588257959]
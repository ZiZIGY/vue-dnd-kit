,692,693,695,697,700],{"class":504,"line":505},[502,694,632],{"class":548},[502,696,635],{"class":548},[502,698,699],{"class":508}," defineNuxtConfig",[502,701,641],{"class":552},[502,703,704],{"class":504,"line":572},[502,705,706],{"class":647},"  \u002F\u002F With @vue-dnd-kit\u002Fdevtools installed, the tab appears in development.\n",[502,708,709,712,714,716,719],{"class":504,"line":588},[502,710,711],{"class":654},"  modules",[502,713,658],{"class":552},[502,715,661],{"class":552},[502,717,718],{"class":512},"'@vue-dnd-kit\u002Fnuxt'",[502,720,721],{"class":552},"],\n",[502,723,724],{"class":504,"line":603},[502,725,684],{"class":552},[464,727,728,729,732,733,736,737,740,741,744],{},"Com o Vite, o plugin faz três coisas no servidor de desenvolvimento (",[467,730,731],{},"vite serve","): serve a aba em\n",[467,734,735],{},"\u002F__vue-dnd-kit-devtools\u002F"," (sob a sua ",[467,738,739],{},"base","), a adiciona ao Vue DevTools e faz a página se\nreportar a ela antes de o seu app começar. Nenhum ",[467,742,743],{},"app.use()"," é necessário, e os builds não são\nafetados.",[464,746,747,748,751,752,755],{},"Com o Nuxt, o módulo ",[467,749,750],{},"@vue-dnd-kit\u002Fnuxt"," encontra o pacote, serve a aba, a adiciona ao Nuxt\nDevTools e instala o lado da página com um plugin de cliente. ",[467,753,754],{},"vueDndKit: { devtools: false }"," a\ndesliga.",[488,757,759],{"id":758},"_3-run-the-app-in-development","3. Rode o app em desenvolvimento",[464,761,762,763,766,767,770],{},"Inicie o servidor de desenvolvimento como sempre (",[467,764,765],{},"vite",", ",[467,768,769],{},"nuxt dev",") e abra o app: a aba está\npronta. Todo provider da página aparece nela, seja qual for o app em que ele é renderizado.",[488,772,774],{"id":773},"without-the-plugins","Sem os plugins",[464,776,777,778,781],{},"Para um servidor de desenvolvimento seu, ou uma página que o Vite não serve a partir de um\n",[467,779,780],{},"index.html"," (configurações de SSR), instale o lado da página você mesmo:",[493,783,786],{"className":538,"code":784,"filename":785,"language":541,"meta":498,"style":498},"import { createApp } from 'vue';\nimport { DnDDevtools } from '@vue-dnd-kit\u002Fdevtools';\nimport App from '.\u002FApp.vue';\n\nconst app = createApp(App);\napp.use(DnDDevtools); \u002F\u002F before mount: providers set up earlier aren't seen\napp.mount('#app');\n","main.ts",[467,787,788,806,824,838,842,865,887],{"__ignoreMap":498},[502,789,790,792,794,797,799,801,804],{"class":504,"line":505},[502,791,549],{"class":548},[502,793,553],{"class":552},[502,795,796],{"class":556}," createApp ",[502,798,560],{"class":552},[502,800,563],{"class":548},[502,802,803],{"class":512}," 'vue'",[502,805,569],{"class":552},[502,807,808,810,812,815,817,819,822],{"class":504,"line":572},[502,809,549],{"class":548},[502,811,553],{"class":552},[502,813,814],{"class":556}," DnDDevtools ",[502,816,560],{"class":552},[502,818,563],{"class":548},[502,820,821],{"class":512}," '@vue-dnd-kit\u002Fdevtools'",[502,823,569],{"class":552},[502,825,826,828,831,833,836],{"class":504,"line":588},[502,827,549],{"class":548},[502,829,830],{"class":556}," App ",[502,832,580],{"class":548},[502,834,835],{"class":512}," '.\u002FApp.vue'",[502,837,569],{"class":552},[502,839,840],{"class":504,"line":603},[502,841,626],{"emptyLinePlaceholder":625},[502,843,844,847,850,853,856,859,862],{"class":504,"line":622},[502,845,846],{"class":548},"const",[502,848,849],{"class":556}," app ",[502,851,852],{"class":552},"=",[502,854,855],{"class":508}," createApp",[502,857,858],{"class":552},"(",[502,860,861],{"class":556},"App",[502,863,864],{"class":552},");\n",[502,866,867,870,873,876,878,881,884],{"class":504,"line":629},[502,868,869],{"class":508},"app",[502,871,872],{"class":552},".",[502,874,875],{"class":508},"use",[502,877,858],{"class":552},[502,879,880],{"class":556},"DnDDevtools",[502,882,883],{"class":552},");",[502,885,886],{"class":647}," \u002F\u002F before mount: providers set up earlier aren't seen\n",[502,888,889,891,893,896,898,901],{"class":504,"line":644},[502,890,869],{"class":508},[502,892,872],{"class":552},[502,894,895],{"class":508},"mount",[502,897,858],{"class":552},[502,899,900],{"class":512},"'#app'",[502,902,864],{"class":552},[464,904,905,906,909,910,913,914,917,918,921],{},"Ou importe ",[467,907,908],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," primeiro no arquivo de entrada. Use\n",[467,911,912],{},"vueDnDKitDevtools({ inject: false })"," quando o plugin deve servir a aba, mas você instala o lado da\npágina você mesmo; ",[467,915,916],{},"serveTab()"," de ",[467,919,920],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," é o middleware que serve a aba.",[923,924,925],"note",{},[464,926,927,928,931,932,935,936,939],{},"Em um build de produção, ",[467,929,930],{},"app.use(DnDDevtools)"," e o import ",[467,933,934],{},"auto"," encolhem para quase nada: todo\nponto de entrada verifica ",[467,937,938],{},"process.env.NODE_ENV"," primeiro, e os bundlers descartam o resto. No\nservidor, eles não fazem nada.",[484,941,943],{"id":942},"open-it","Abrir a aba",[945,946,947,968,983],"ul",{},[948,949,950,953,954,958,959,958,962,965,966,872],"li",{},[472,951,952],{},"Vue DevTools",": ",[955,956],"kbd",{"value":957},"Alt"," + ",[955,960],{"value":961},"Shift",[955,963],{"value":964},"D",", ou o botão do Vue no\nrodapé da página, depois a aba ",[472,967,474],{},[948,969,970,953,973,958,975,958,977,979,980,982],{},[472,971,972],{},"Nuxt DevTools",[955,974],{"value":957},[955,976],{"value":961},[955,978],{"value":964},", ou o botão do Nuxt,\ndepois ",[472,981,474],{}," (na barra lateral ou no menu de itens extras dela).",[948,984,985,988,989,992],{},[472,986,987],{},"Uma janela própria",": abra ",[467,990,991],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," no seu servidor de\ndesenvolvimento, ou o botão ⧉ da aba. Prático em um segundo monitor. Com várias páginas abertas,\num seletor no topo escolhe qual observar.",[994,995,996],"warning",{},[464,997,998],{},"Mantenha a aba em uma janela própria, não em uma aba de navegador em segundo plano da mesma janela:\na página precisa continuar visível, e uma página escondida cancela os arrastes.",[484,1000,1002],{"id":1001},"the-tab-at-a-glance","A aba em resumo",[1004,1005,1006,1019],"table",{},[1007,1008,1009],"thead",{},[1010,1011,1012,1016],"tr",{},[1013,1014,1015],"th",{},"Parte",[1013,1017,1018],{},"O que contém",[1020,1021,1022,1039,1051,1066],"tbody",{},[1010,1023,1024,1028],{},[1025,1026,1027],"td",{},"Barra superior",[1025,1029,1030,1031,1034,1035,1038],{},"O que o arraste está fazendo agora (",[467,1032,1033],{},"dragging card-3 → done (accepts)","), a página observada, ",[472,1036,1037],{},"⌖ Pick",", a contagem de opções editadas com um reset, ⧉ (uma janela própria) e o tema.",[1010,1040,1041,1044],{},[1025,1042,1043],{},"Esquerda: o registro",[1025,1045,1046,1047,1050],{},"Todo provider como uma árvore: as listas, árvores, alvos de drop e draggables dele. ",[472,1048,1049],{},"☰"," o mostra ou esconde.",[1010,1052,1053,1063],{},[1025,1054,1055,1056,1059,1060],{},"Meio: ",[472,1057,1058],{},"Map"," e ",[472,1061,1062],{},"Log",[1025,1064,1065],{},"O minimapa ao vivo da página, ou o log dos arrastes.",[1010,1067,1068,1080],{},[1025,1069,1070,1071,766,1074,766,1077],{},"Direita: ",[472,1072,1073],{},"Drive",[472,1075,1076],{},"Options",[472,1078,1079],{},"State",[1025,1081,1082],{},"O joystick e os botões de mover, as opções do nó escolhido, e o que o provider sabe sobre ele.",[464,1084,1085],{},"Escolha um nó no registro ou um item no mapa, e o lado direito o acompanha.",[484,1087,1089],{"id":1088},"the-mini-map","O minimapa",[464,1091,1092],{},"Um card ao vivo por lista, árvore e alvo de drop, com cópias dos itens deles onde estão — os mesmos\nclones que o overlay mostraria, com o CSS da página. Durante um arraste, ele marca:",[945,1094,1095,1106,1109],{},[948,1096,1097,1098,1101,1102,1105],{},"as listas e os alvos que ",[472,1099,1100],{},"aceitam"," o arraste (azul) ou o ",[472,1103,1104],{},"recusam"," (vermelho);",[948,1107,1108],{},"o placeholder, e o alvo sob o ponteiro;",[948,1110,1111,1112,872],{},"o ponteiro, a caixa do overlay e a linha de inserção das listas com ",[467,1113,1114],{},"placeholder: 'indicator'",[464,1116,1117],{},"Um clique escolhe um item e o destaca na página; um clique duplo rola a página até ele. Use o mapa\nquando um drop não vai para onde você espera: ele mostra de relance quais listas aceitam o arraste.",[484,1119,1121],{"id":1120},"drive-the-joystick","Drive: o joystick",[464,1123,1124,1125,1127,1128,1059,1131,1134],{},"Escolha um item — no mapa, no registro ou com ",[472,1126,1037],{},", que captura a próxima pressão em um\ndraggable da página em vez de deixá-la agir — e empurre a alavanca do joystick. O item é pego e se\nmove naquela direção, mais rápido quanto mais longe a alavanca estiver do centro. Solte e ele\npara; ",[472,1129,1130],{},"Drop",[472,1132,1133],{},"Cancel"," encerram o arraste.",[464,1136,1137,1138,1141,1142,1147,1148,1059,1151,1154],{},"É um arraste por ponteiro de verdade de um sensor chamado ",[467,1139,1140],{},"devtools",", feito com a\n",[1143,1144,1146],"a",{"href":1145},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API pública de sensores",": as listas ordenam sob ele, os\ncontêineres rolam automaticamente nas bordas, e ",[467,1149,1150],{},"onBeforeDrop",[467,1152,1153],{},"onDrop"," rodam como em qualquer\narraste. Itens desativados não são pegos. Um arraste por teclado iniciado pela página também pode\nser conduzido.",[464,1156,1157,1158,1164],{},"Os itens de listas ordenáveis também ganham botões: para cima, para baixo, para o início, para o\nfim, para outra lista do grupo. Cada um é um arraste por teclado de\n",[1143,1159,1161],{"href":1160},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[467,1162,1163],{},"moveItem",". Embaixo do joystick, uma cópia grande do que o\noverlay mostra.",[1004,1166,1167,1177],{},[1007,1168,1169],{},[1010,1170,1171,1174],{},[1013,1172,1173],{},"Tecla, na aba",[1013,1175,1176],{},"Faz",[1020,1178,1179,1202,1212,1226,1236],{},[1010,1180,1181,1196],{},[1025,1182,1183,1184,1187,1188,1187,1191,1187,1194],{},"Setas ou ",[955,1185],{"value":1186},"W"," ",[955,1189],{"value":1190},"A",[955,1192],{"value":1193},"S",[955,1195],{"value":964},[1025,1197,1198,1199,1201],{},"Empurra a alavanca naquela direção, até a metade; com ",[955,1200],{"value":961},", até o fim",[1010,1203,1204,1209],{},[1025,1205,1206],{},[955,1207],{"value":1208},"G",[1025,1210,1211],{},"Pega o item escolhido",[1010,1213,1214,1223],{},[1025,1215,1216,1219,1220],{},[955,1217],{"value":1218},"Space"," \u002F ",[955,1221],{"value":1222},"Enter",[1025,1224,1225],{},"Solta",[1010,1227,1228,1233],{},[1025,1229,1230],{},[955,1231],{"value":1232},"Escape",[1025,1234,1235],{},"Cancela",[1010,1237,1238,1243],{},[1025,1239,1240],{},[955,1241],{"value":1242},"P",[1025,1244,1245],{},"Escolhe na página",[484,1247,1249],{"id":1248},"options","Opções",[464,1251,1252,1253,658],{},"Toda opção que não é um callback pode ser editada enquanto o app roda. Escolha o nó e abra\n",[472,1254,1076],{},[1004,1256,1257,1266],{},[1007,1258,1259],{},[1010,1260,1261,1264],{},[1013,1262,1263],{},"Nó",[1013,1265,1249],{},[1020,1267,1268,1310,1349,1367,1384],{},[1010,1269,1270,1273],{},[1025,1271,1272],{},"Provider",[1025,1274,1275,766,1278,766,1281,766,1284,1287,1288,766,1291,766,1294,766,1297,766,1300,766,1303,766,1306,1309],{},[467,1276,1277],{},"overlayFit",[467,1279,1280],{},"autoScroll",[467,1282,1283],{},"collision",[467,1285,1286],{},"modifiers"," (os da biblioteca, pelo nome), ",[467,1289,1290],{},"animation",[467,1292,1293],{},"dropAnimation",[467,1295,1296],{},"animate",[467,1298,1299],{},"activation",[467,1301,1302],{},"keyboard",[467,1304,1305],{},"haptics",[467,1307,1308],{},"copyModifier","…",[1010,1311,1312,1315],{},[1025,1313,1314],{},"Lista",[1025,1316,1317,766,1320,766,1323,766,1326,766,1329,766,1332,766,1335,766,1338,766,1341,766,1343,766,1345,766,1347],{},[467,1318,1319],{},"disabled",[467,1321,1322],{},"strategy",[467,1324,1325],{},"placeholder",[467,1327,1328],{},"behavior",[467,1330,1331],{},"multiple",[467,1333,1334],{},"sort",[467,1336,1337],{},"dropOutside",[467,1339,1340],{},"acceptMode",[467,1342,1290],{},[467,1344,1296],{},[467,1346,1280],{},[467,1348,1286],{},[1010,1350,1351,1354],{},[1025,1352,1353],{},"Árvore",[1025,1355,1356,766,1358,766,1361,766,1364,1309],{},[467,1357,1325],{},[467,1359,1360],{},"indentation",[467,1362,1363],{},"nesting",[467,1365,1366],{},"maxDepth",[1010,1368,1369,1372],{},[1025,1370,1371],{},"Alvo de drop",[1025,1373,1374,766,1376,766,1379,766,1382],{},[467,1375,1319],{},[467,1377,1378],{},"priority",[467,1380,1381],{},"accept",[467,1383,1340],{},[1010,1385,1386,1389],{},[1025,1387,1388],{},"Item",[1025,1390,1391,766,1393,766,1395],{},[467,1392,1319],{},[467,1394,1302],{},[467,1396,1299],{},[464,1398,1399],{},"Uma edição vale na hora, só para esta página, e nunca é gravada no seu código: a biblioteca lê o\nnovo valor onde lê a opção. Ela dura até você resetá-la (↺ por opção, ou o reset da barra\nsuperior), o provider ser desmontado ou a página recarregar. Uma opção editada mostra ao lado o\nvalor do seu código. Os itens montados enquanto uma edição está ativa — linhas de uma lista\nvirtual — também a recebem.",[484,1401,1403],{"id":1402},"state","Estado",[464,1405,1406],{},"O que cada provider sabe, para o nó que você escolheu:",[945,1408,1409,1416,1427],{},[948,1410,1411,1412,1415],{},"a ",[472,1413,1414],{},"sessão de arraste",": o status, os ids, os itens e o sensor ativos, o alvo e se ele aceita, o\nponteiro, o overlay, a sessão do grupo ordenável e a linha de inserção;",[948,1417,1418,1419,1422,1423,1426],{},"uma ",[472,1420,1421],{},"lista",": a ordem dela e o rascunho; uma ",[472,1424,1425],{},"árvore",": as linhas dela;",[948,1428,1429,1430,1433,1434,1437],{},"um ",[472,1431,1432],{},"item",": o tipo, os dados e a posição dele; um ",[472,1435,1436],{},"alvo de drop",": as regras dele.",[464,1439,1440],{},"Os itens são montados e desmontados sem eventos: o registro se atualiza em até um segundo.",[484,1442,1062],{"id":1443},"log",[464,1445,1446],{},"Uma faixa por arraste, em ordem:",[1004,1448,1449,1459],{},[1007,1450,1451],{},[1010,1452,1453,1456],{},[1013,1454,1455],{},"Entrada",[1013,1457,1458],{},"O que diz",[1020,1460,1461,1471,1484,1497,1509,1527],{},[1010,1462,1463,1468],{},[1025,1464,1465],{},[467,1466,1467],{},"drag start",[1025,1469,1470],{},"Os ids, o sensor e se foi por toque, a lista de onde vem.",[1010,1472,1473,1481],{},[1025,1474,1475,766,1478],{},[467,1476,1477],{},"over",[467,1479,1480],{},"left",[1025,1482,1483],{},"Cada alvo em que entrou e de que saiu, e se ele aceita.",[1010,1485,1486,1491],{},[1025,1487,1488],{},[467,1489,1490],{},"release",[1025,1492,1493,1494,1496],{},"O alvo sobre o qual foi solto, enquanto o ",[467,1495,1150],{}," decide.",[1010,1498,1499,1503],{},[1025,1500,1501],{},[467,1502,1150],{},[1025,1504,1505,1506,1508],{},"O veredito: aceito, alguns aceitos, rejeitado por um hook, recusado pelo ",[467,1507,1381],{}," do alvo, e quanto tempo os hooks levaram.",[1010,1510,1511,1516],{},[1025,1512,1513],{},[467,1514,1515],{},"drop",[1025,1517,1518,1519,1522,1523,1526],{},"O alvo; para listas ordenáveis, o movimento, ",[467,1520,1521],{},"e.result",", e se ",[467,1524,1525],{},"preventDefault()"," foi chamado.",[1010,1528,1529,1534],{},[1025,1530,1531],{},[467,1532,1533],{},"cancel",[1025,1535,1536,1537,1540,1541,1543],{},"O motivo: cancelado (Escape, ",[467,1538,1539],{},"cancel()","), rejeitado por um hook, ou recusado pelo ",[467,1542,1381],{}," do alvo.",[464,1545,1546,1547,1059,1550,1553,1554,1557,1558,1560],{},"Também ",[467,1548,1549],{},"auto-scroll on",[467,1551,1552],{},"off",", os textos de ",[467,1555,1556],{},"announcement"," (escondidos por padrão) e, fora dos\narrastes, ",[467,1559,1296],{}," (mudanças nos itens de uma lista que nenhum arraste fez). Clique em uma entrada\npara ver os dados dela. Uma aba aberta depois recebe os arrastes até então.",[484,1562,1564],{"id":1563},"debug-a-drop-step-by-step","Depurar um drop, passo a passo",[464,1566,1567],{},"Um card não entra em uma coluna. Com a aba aberta:",[1569,1570,1571,1580,1597,1618],"ol",{},[948,1572,1573,1576,1577,1579],{},[472,1574,1575],{},"Reproduza"," à mão, ou com ",[472,1578,1073],{},", para que as suas mãos fiquem livres para a aba.",[948,1581,1582,1585,1586,1589,1590,1593,1594,1596],{},[472,1583,1584],{},"Observe o mapa"," enquanto o card está sobre a coluna. Vermelho significa que a lista recusa o\ncard: veja o ",[467,1587,1588],{},"group"," dela (",[467,1591,1592],{},"put",") ou o ",[467,1595,1381],{}," do alvo. Azul significa que ela aceita, e o\nproblema vem depois.",[948,1598,1599,1602,1603,1605,1606,1608,1609,1611,1612,1614,1615,1617],{},[472,1600,1601],{},"Leia o log"," desse arraste. ",[467,1604,1150],{}," diz quem disse não — um hook, ou o ",[467,1607,1381],{}," do\nalvo. Se o drop foi concluído mas os seus dados não mudaram, a entrada ",[467,1610,1515],{}," diz se\n",[467,1613,1525],{}," foi chamado e o que ",[467,1616,1521],{}," continha: uma lista controlada precisa\naplicá-lo ela mesma.",[948,1619,1620,1623,1624,1626,1627,1629,1630,766,1632,1634],{},[472,1621,1622],{},"Teste uma correção ao vivo"," em ",[472,1625,1076],{}," — um ",[467,1628,1340],{}," mais flexível, outra\n",[467,1631,1283],{},[467,1633,1114],{}," — e depois escreva no seu código a que funcionar.",[484,1636,1638],{"id":1637},"how-it-works","Como funciona",[464,1640,1641,1642,1645],{},"Os providers se reportam a um hook que o lado da página instala. Até uma aba observar a página,\neles só são registrados; depois disso, a página escuta como qualquer monitor e envia à aba o que\nela mostra — a cada 40 ms durante um arraste, duas vezes por segundo no resto do tempo — e para\nassim que nenhuma aba a observa por alguns segundos. A aba conversa com a página por um\n",[467,1643,1644],{},"BroadcastChannel"," da origem da página. Ela não muda nada além do que você pede: os arrastes, a\nseleção e as substituições de opções.",[1647,1648,1649],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s78Kj, html code.shiki .s78Kj{--shiki-light:#1F8A5B;--shiki-default:#1F8A5B;--shiki-dark:#42B883}html pre.shiki code .s6cML, html code.shiki .s6cML{--shiki-light:#5B5B63;--shiki-default:#5B5B63;--shiki-dark:#9F9FA9}html pre.shiki code .snmWg, html code.shiki .snmWg{--shiki-light:#27272A;--shiki-default:#27272A;--shiki-dark:#E4E4E7}html pre.shiki code .sytrG, html code.shiki .sytrG{--shiki-light:#85858D;--shiki-light-font-style:italic;--shiki-default:#85858D;--shiki-default-font-style:italic;--shiki-dark:#6E6E78;--shiki-dark-font-style:italic}html pre.shiki code .sVvmN, html code.shiki .sVvmN{--shiki-light:#7C4DCC;--shiki-default:#7C4DCC;--shiki-dark:#C3A6FF}",{"title":498,"searchDepth":588,"depth":588,"links":1651},[1652,1658,1659,1660,1661,1662,1663,1664,1665,1666],{"id":486,"depth":572,"text":285,"children":1653},[1654,1655,1656,1657],{"id":490,"depth":588,"text":491},{"id":531,"depth":588,"text":532},{"id":758,"depth":588,"text":759},{"id":773,"depth":588,"text":774},{"id":942,"depth":572,"text":943},{"id":1001,"depth":572,"text":1002},{"id":1088,"depth":572,"text":1089},{"id":1120,"depth":572,"text":1121},{"id":1248,"depth":572,"text":1249},{"id":1402,"depth":572,"text":1403},{"id":1443,"depth":572,"text":1062},{"id":1563,"depth":572,"text":1564},{"id":1637,"depth":572,"text":1638},"Uma aba Vue DnD Kit no Vue DevTools e no Nuxt DevTools — um minimapa ao vivo, um joystick que arrasta de verdade, edição de opções ao vivo e um log de cada arraste.","md",null,{"source":1671},"18136c4536",{"icon":116},{"title":113,"description":1667},"Dq1zgju6GtNAYfyA58Izeldw1_Pwy_N7d0Nf0ZXn_XA",[1676,1678],{"title":351,"path":352,"stem":353,"description":1677,"icon":111},"Como a entrada vira um arraste — os sensores de ponteiro e de teclado, restrições de ativação, canDrag, sensores seus e arrastes que você roteiriza com @vue-dnd-kit\u002Factions.",{"title":358,"path":359,"stem":360,"description":1679,"icon":121},"O arrastar e soltar do próprio navegador, como arrastes da biblioteca — arquivos, links e texto de outros apps para alvos de drop e listas que abrem espaço para eles, itens arrastados para fora da página, e entre janelas do seu app.",1793581602808]
47,"code":696,"filename":697,"language":550,"meta":507,"style":507},"export default defineNuxtConfig({\n  \u002F\u002F With @vue-dnd-kit\u002Fdevtools installed, the tab appears in development.\n  modules: ['@vue-dnd-kit\u002Fnuxt'],\n});\n","nuxt.config.ts",[476,699,700,711,716,731],{"__ignoreMap":507},[511,701,702,704,706,709],{"class":513,"line":514},[511,703,641],{"class":557},[511,705,644],{"class":557},[511,707,708],{"class":517}," defineNuxtConfig",[511,710,650],{"class":561},[511,712,713],{"class":513,"line":581},[511,714,715],{"class":656},"  \u002F\u002F With @vue-dnd-kit\u002Fdevtools installed, the tab appears in development.\n",[511,717,718,721,723,725,728],{"class":513,"line":597},[511,719,720],{"class":663},"  modules",[511,722,667],{"class":561},[511,724,670],{"class":561},[511,726,727],{"class":521},"'@vue-dnd-kit\u002Fnuxt'",[511,729,730],{"class":561},"],\n",[511,732,733],{"class":513,"line":612},[511,734,693],{"class":561},[473,736,737,738,741,742,745,746,749,750,753],{},"Com o Vite, o plugin faz três coisas no servidor de desenvolvimento (",[476,739,740],{},"vite serve","): serve a aba em\n",[476,743,744],{},"\u002F__vue-dnd-kit-devtools\u002F"," (sob a sua ",[476,747,748],{},"base","), a adiciona ao Vue DevTools e faz a página se\nreportar a ela antes de o seu app começar. Nenhum ",[476,751,752],{},"app.use()"," é necessário, e os builds não são\nafetados.",[473,755,756,757,760,761,764],{},"Com o Nuxt, o módulo ",[476,758,759],{},"@vue-dnd-kit\u002Fnuxt"," encontra o pacote, serve a aba, a adiciona ao Nuxt\nDevTools e instala o lado da página com um plugin de cliente. ",[476,762,763],{},"vueDndKit: { devtools: false }"," a\ndesliga.",[497,766,768],{"id":767},"_3-run-the-app-in-development","3. Rode o app em desenvolvimento",[473,770,771,772,775,776,779],{},"Inicie o servidor de desenvolvimento como sempre (",[476,773,774],{},"vite",", ",[476,777,778],{},"nuxt dev",") e abra o app: a aba está\npronta. Todo provider da página aparece nela, seja qual for o app em que ele é renderizado.",[497,781,783],{"id":782},"without-the-plugins","Sem os plugins",[473,785,786,787,790],{},"Para um servidor de desenvolvimento seu, ou uma página que o Vite não serve a partir de um\n",[476,788,789],{},"index.html"," (configurações de SSR), instale o lado da página você mesmo:",[502,792,795],{"className":547,"code":793,"filename":794,"language":550,"meta":507,"style":507},"import { createApp } from 'vue';\nimport { DnDDevtools } from '@vue-dnd-kit\u002Fdevtools';\nimport App from '.\u002FApp.vue';\n\nconst app = createApp(App);\napp.use(DnDDevtools); \u002F\u002F before mount: providers set up earlier aren't seen\napp.mount('#app');\n","main.ts",[476,796,797,815,833,847,851,874,896],{"__ignoreMap":507},[511,798,799,801,803,806,808,810,813],{"class":513,"line":514},[511,800,558],{"class":557},[511,802,562],{"class":561},[511,804,805],{"class":565}," createApp ",[511,807,569],{"class":561},[511,809,572],{"class":557},[511,811,812],{"class":521}," 'vue'",[511,814,578],{"class":561},[511,816,817,819,821,824,826,828,831],{"class":513,"line":581},[511,818,558],{"class":557},[511,820,562],{"class":561},[511,822,823],{"class":565}," DnDDevtools ",[511,825,569],{"class":561},[511,827,572],{"class":557},[511,829,830],{"class":521}," '@vue-dnd-kit\u002Fdevtools'",[511,832,578],{"class":561},[511,834,835,837,840,842,845],{"class":513,"line":597},[511,836,558],{"class":557},[511,838,839],{"class":565}," App ",[511,841,589],{"class":557},[511,843,844],{"class":521}," '.\u002FApp.vue'",[511,846,578],{"class":561},[511,848,849],{"class":513,"line":612},[511,850,635],{"emptyLinePlaceholder":634},[511,852,853,856,859,862,865,868,871],{"class":513,"line":631},[511,854,855],{"class":557},"const",[511,857,858],{"class":565}," app ",[511,860,861],{"class":561},"=",[511,863,864],{"class":517}," createApp",[511,866,867],{"class":561},"(",[511,869,870],{"class":565},"App",[511,872,873],{"class":561},");\n",[511,875,876,879,882,885,887,890,893],{"class":513,"line":638},[511,877,878],{"class":517},"app",[511,880,881],{"class":561},".",[511,883,884],{"class":517},"use",[511,886,867],{"class":561},[511,888,889],{"class":565},"DnDDevtools",[511,891,892],{"class":561},");",[511,894,895],{"class":656}," \u002F\u002F before mount: providers set up earlier aren't seen\n",[511,897,898,900,902,905,907,910],{"class":513,"line":653},[511,899,878],{"class":517},[511,901,881],{"class":561},[511,903,904],{"class":517},"mount",[511,906,867],{"class":561},[511,908,909],{"class":521},"'#app'",[511,911,873],{"class":561},[473,913,914,915,918,919,922,923,926,927,930],{},"Ou importe ",[476,916,917],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," primeiro no arquivo de entrada. Use\n",[476,920,921],{},"vueDnDKitDevtools({ inject: false })"," quando o plugin deve servir a aba, mas você instala o lado da\npágina você mesmo; ",[476,924,925],{},"serveTab()"," de ",[476,928,929],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," é o middleware que serve a aba.",[932,933,934],"note",{},[473,935,936,937,940,941,944,945,948],{},"Em um build de produção, ",[476,938,939],{},"app.use(DnDDevtools)"," e o import ",[476,942,943],{},"auto"," encolhem para quase nada: todo\nponto de entrada verifica ",[476,946,947],{},"process.env.NODE_ENV"," primeiro, e os bundlers descartam o resto. No\nservidor, eles não fazem nada.",[493,950,952],{"id":951},"open-it","Abrir a aba",[954,955,956,977,992],"ul",{},[957,958,959,962,963,967,968,967,971,974,975,881],"li",{},[481,960,961],{},"Vue DevTools",": ",[964,965],"kbd",{"value":966},"Alt"," + ",[964,969],{"value":970},"Shift",[964,972],{"value":973},"D",", ou o botão do Vue no\nrodapé da página, depois a aba ",[481,976,483],{},[957,978,979,962,982,967,984,967,986,988,989,991],{},[481,980,981],{},"Nuxt DevTools",[964,983],{"value":966},[964,985],{"value":970},[964,987],{"value":973},", ou o botão do Nuxt,\ndepois ",[481,990,483],{}," (na barra lateral ou no menu de itens extras dela).",[957,993,994,997,998,1001],{},[481,995,996],{},"Uma janela própria",": abra ",[476,999,1000],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," no seu servidor de\ndesenvolvimento, ou o botão ⧉ da aba. Prático em um segundo monitor. Com várias páginas abertas,\num seletor no topo escolhe qual observar.",[1003,1004,1005],"warning",{},[473,1006,1007],{},"Mantenha a aba em uma janela própria, não em uma aba de navegador em segundo plano da mesma janela:\na página precisa continuar visível, e uma página escondida cancela os arrastes.",[493,1009,1011],{"id":1010},"the-tab-at-a-glance","A aba em resumo",[1013,1014,1015,1028],"table",{},[1016,1017,1018],"thead",{},[1019,1020,1021,1025],"tr",{},[1022,1023,1024],"th",{},"Parte",[1022,1026,1027],{},"O que contém",[1029,1030,1031,1048,1060,1075],"tbody",{},[1019,1032,1033,1037],{},[1034,1035,1036],"td",{},"Barra superior",[1034,1038,1039,1040,1043,1044,1047],{},"O que o arraste está fazendo agora (",[476,1041,1042],{},"dragging card-3 → done (accepts)","), a página observada, ",[481,1045,1046],{},"⌖ Pick",", a contagem de opções editadas com um reset, ⧉ (uma janela própria) e o tema.",[1019,1049,1050,1053],{},[1034,1051,1052],{},"Esquerda: o registro",[1034,1054,1055,1056,1059],{},"Todo provider como uma árvore: as listas, árvores, alvos de drop e draggables dele. ",[481,1057,1058],{},"☰"," o mostra ou esconde.",[1019,1061,1062,1072],{},[1034,1063,1064,1065,1068,1069],{},"Meio: ",[481,1066,1067],{},"Map"," e ",[481,1070,1071],{},"Log",[1034,1073,1074],{},"O minimapa ao vivo da página, ou o log dos arrastes.",[1019,1076,1077,1089],{},[1034,1078,1079,1080,775,1083,775,1086],{},"Direita: ",[481,1081,1082],{},"Drive",[481,1084,1085],{},"Options",[481,1087,1088],{},"State",[1034,1090,1091],{},"O joystick e os botões de mover, as opções do nó escolhido, e o que o provider sabe sobre ele.",[473,1093,1094],{},"Escolha um nó no registro ou um item no mapa, e o lado direito o acompanha.",[493,1096,1098],{"id":1097},"the-mini-map","O minimapa",[473,1100,1101],{},"Um card ao vivo por lista, árvore e alvo de drop, com cópias dos itens deles onde estão — os mesmos\nclones que o overlay mostraria, com o CSS da página. Durante um arraste, ele marca:",[954,1103,1104,1115,1118],{},[957,1105,1106,1107,1110,1111,1114],{},"as listas e os alvos que ",[481,1108,1109],{},"aceitam"," o arraste (azul) ou o ",[481,1112,1113],{},"recusam"," (vermelho);",[957,1116,1117],{},"o placeholder, e o alvo sob o ponteiro;",[957,1119,1120,1121,881],{},"o ponteiro, a caixa do overlay e a linha de inserção das listas com ",[476,1122,1123],{},"placeholder: 'indicator'",[473,1125,1126],{},"Um clique escolhe um item e o destaca na página; um clique duplo rola a página até ele. Use o mapa\nquando um drop não vai para onde você espera: ele mostra de relance quais listas aceitam o arraste.",[493,1128,1130],{"id":1129},"drive-the-joystick","Drive: o joystick",[473,1132,1133,1134,1136,1137,1068,1140,1143],{},"Escolha um item — no mapa, no registro ou com ",[481,1135,1046],{},", que captura a próxima pressão em um\ndraggable da página em vez de deixá-la agir — e empurre a alavanca do joystick. O item é pego e se\nmove naquela direção, mais rápido quanto mais longe a alavanca estiver do centro. Solte e ele\npara; ",[481,1138,1139],{},"Drop",[481,1141,1142],{},"Cancel"," encerram o arraste.",[473,1145,1146,1147,1150,1151,1156,1157,1068,1160,1163],{},"É um arraste por ponteiro de verdade de um sensor chamado ",[476,1148,1149],{},"devtools",", feito com a\n",[1152,1153,1155],"a",{"href":1154},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API pública de sensores",": as listas ordenam sob ele, os\ncontêineres rolam automaticamente nas bordas, e ",[476,1158,1159],{},"onBeforeDrop",[476,1161,1162],{},"onDrop"," rodam como em qualquer\narraste. Itens desativados não são pegos. Um arraste por teclado iniciado pela página também pode\nser conduzido.",[473,1165,1166,1167,1173],{},"Os itens de listas ordenáveis também ganham botões: para cima, para baixo, para o início, para o\nfim, para outra lista do grupo. Cada um é um arraste por teclado de\n",[1152,1168,1170],{"href":1169},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[476,1171,1172],{},"moveItem",". Embaixo do joystick, uma cópia grande do que o\noverlay mostra.",[1013,1175,1176,1186],{},[1016,1177,1178],{},[1019,1179,1180,1183],{},[1022,1181,1182],{},"Tecla, na aba",[1022,1184,1185],{},"Faz",[1029,1187,1188,1211,1221,1235,1245],{},[1019,1189,1190,1205],{},[1034,1191,1192,1193,1196,1197,1196,1200,1196,1203],{},"Setas ou ",[964,1194],{"value":1195},"W"," ",[964,1198],{"value":1199},"A",[964,1201],{"value":1202},"S",[964,1204],{"value":973},[1034,1206,1207,1208,1210],{},"Empurra a alavanca naquela direção, até a metade; com ",[964,1209],{"value":970},", até o fim",[1019,1212,1213,1218],{},[1034,1214,1215],{},[964,1216],{"value":1217},"G",[1034,1219,1220],{},"Pega o item escolhido",[1019,1222,1223,1232],{},[1034,1224,1225,1228,1229],{},[964,1226],{"value":1227},"Space"," \u002F ",[964,1230],{"value":1231},"Enter",[1034,1233,1234],{},"Solta",[1019,1236,1237,1242],{},[1034,1238,1239],{},[964,1240],{"value":1241},"Escape",[1034,1243,1244],{},"Cancela",[1019,1246,1247,1252],{},[1034,1248,1249],{},[964,1250],{"value":1251},"P",[1034,1253,1254],{},"Escolhe na página",[493,1256,1258],{"id":1257},"options","Opções",[473,1260,1261,1262,667],{},"Toda opção que não é um callback pode ser editada enquanto o app roda. Escolha o nó e abra\n",[481,1263,1085],{},[1013,1265,1266,1275],{},[1016,1267,1268],{},[1019,1269,1270,1273],{},[1022,1271,1272],{},"Nó",[1022,1274,1258],{},[1029,1276,1277,1319,1358,1376,1393],{},[1019,1278,1279,1282],{},[1034,1280,1281],{},"Provider",[1034,1283,1284,775,1287,775,1290,775,1293,1296,1297,775,1300,775,1303,775,1306,775,1309,775,1312,775,1315,1318],{},[476,1285,1286],{},"overlayFit",[476,1288,1289],{},"autoScroll",[476,1291,1292],{},"collision",[476,1294,1295],{},"modifiers"," (os da biblioteca, pelo nome), ",[476,1298,1299],{},"animation",[476,1301,1302],{},"dropAnimation",[476,1304,1305],{},"animateChanges",[476,1307,1308],{},"activation",[476,1310,1311],{},"keyboard",[476,1313,1314],{},"haptics",[476,1316,1317],{},"copyModifier","…",[1019,1320,1321,1324],{},[1034,1322,1323],{},"Lista",[1034,1325,1326,775,1329,775,1332,775,1335,775,1338,775,1341,775,1344,775,1347,775,1350,775,1352,775,1354,775,1356],{},[476,1327,1328],{},"disabled",[476,1330,1331],{},"strategy",[476,1333,1334],{},"placeholder",[476,1336,1337],{},"behavior",[476,1339,1340],{},"multiple",[476,1342,1343],{},"sort",[476,1345,1346],{},"dropOutside",[476,1348,1349],{},"acceptMode",[476,1351,1299],{},[476,1353,1305],{},[476,1355,1289],{},[476,1357,1295],{},[1019,1359,1360,1363],{},[1034,1361,1362],{},"Árvore",[1034,1364,1365,775,1367,775,1370,775,1373,1318],{},[476,1366,1334],{},[476,1368,1369],{},"indentation",[476,1371,1372],{},"nesting",[476,1374,1375],{},"maxDepth",[1019,1377,1378,1381],{},[1034,1379,1380],{},"Alvo de drop",[1034,1382,1383,775,1385,775,1388,775,1391],{},[476,1384,1328],{},[476,1386,1387],{},"priority",[476,1389,1390],{},"accept",[476,1392,1349],{},[1019,1394,1395,1398],{},[1034,1396,1397],{},"Item",[1034,1399,1400,775,1402,775,1405],{},[476,1401,1328],{},[476,1403,1404],{},"keyboardMode",[476,1406,1308],{},[473,1408,1409],{},"Uma edição vale na hora, só para esta página, e nunca é gravada no seu código: a biblioteca lê o\nnovo valor onde lê a opção. Ela dura até você resetá-la (↺ por opção, ou o reset da barra\nsuperior), o provider ser desmontado ou a página recarregar. Uma opção editada mostra ao lado o\nvalor do seu código. Os itens montados enquanto uma edição está ativa — linhas de uma lista\nvirtual — também a recebem.",[493,1411,1413],{"id":1412},"state","Estado",[473,1415,1416],{},"O que cada provider sabe, para o nó que você escolheu:",[954,1418,1419,1426,1437],{},[957,1420,1421,1422,1425],{},"a ",[481,1423,1424],{},"sessão de arraste",": o status, os ids, os itens e o sensor ativos, o alvo e se ele aceita, o\nponteiro, o overlay, a sessão do grupo ordenável e a linha de inserção;",[957,1427,1428,1429,1432,1433,1436],{},"uma ",[481,1430,1431],{},"lista",": a ordem dela e o rascunho; uma ",[481,1434,1435],{},"árvore",": as linhas dela;",[957,1438,1439,1440,1443,1444,1447],{},"um ",[481,1441,1442],{},"item",": o tipo, os dados e a posição dele; um ",[481,1445,1446],{},"alvo de drop",": as regras dele.",[473,1449,1450],{},"Os itens são montados e desmontados sem eventos: o registro se atualiza em até um segundo.",[493,1452,1071],{"id":1453},"log",[473,1455,1456],{},"Uma faixa por arraste, em ordem:",[1013,1458,1459,1469],{},[1016,1460,1461],{},[1019,1462,1463,1466],{},[1022,1464,1465],{},"Entrada",[1022,1467,1468],{},"O que diz",[1029,1470,1471,1481,1494,1507,1519,1537],{},[1019,1472,1473,1478],{},[1034,1474,1475],{},[476,1476,1477],{},"drag start",[1034,1479,1480],{},"Os ids, o sensor e se foi por toque, a lista de onde vem.",[1019,1482,1483,1491],{},[1034,1484,1485,775,1488],{},[476,1486,1487],{},"over",[476,1489,1490],{},"left",[1034,1492,1493],{},"Cada alvo em que entrou e de que saiu, e se ele aceita.",[1019,1495,1496,1501],{},[1034,1497,1498],{},[476,1499,1500],{},"release",[1034,1502,1503,1504,1506],{},"O alvo sobre o qual foi solto, enquanto o ",[476,1505,1159],{}," decide.",[1019,1508,1509,1513],{},[1034,1510,1511],{},[476,1512,1159],{},[1034,1514,1515,1516,1518],{},"O veredito: aceito, alguns aceitos, rejeitado por um hook, recusado pelo ",[476,1517,1390],{}," do alvo, e quanto tempo os hooks levaram.",[1019,1520,1521,1526],{},[1034,1522,1523],{},[476,1524,1525],{},"drop",[1034,1527,1528,1529,1532,1533,1536],{},"O alvo; para listas ordenáveis, o movimento, ",[476,1530,1531],{},"e.result",", e se ",[476,1534,1535],{},"preventDefault()"," foi chamado.",[1019,1538,1539,1544],{},[1034,1540,1541],{},[476,1542,1543],{},"cancel",[1034,1545,1546,1547,1550,1551,1553],{},"O motivo: cancelado (Escape, ",[476,1548,1549],{},"cancel()","), rejeitado por um hook, ou recusado pelo ",[476,1552,1390],{}," do alvo.",[473,1555,1556,1557,1068,1560,1563,1564,1567,1568,1571],{},"Também ",[476,1558,1559],{},"auto-scroll on",[476,1561,1562],{},"off",", os textos de ",[476,1565,1566],{},"announcement"," (escondidos por padrão) e, fora dos\narrastes, ",[476,1569,1570],{},"animate"," (mudanças nos itens de uma lista que nenhum arraste fez). Clique em uma entrada\npara ver os dados dela. Uma aba aberta depois recebe os arrastes até então.",[493,1573,1575],{"id":1574},"debug-a-drop-step-by-step","Depurar um drop, passo a passo",[473,1577,1578],{},"Um card não entra em uma coluna. Com a aba aberta:",[1580,1581,1582,1591,1608,1629],"ol",{},[957,1583,1584,1587,1588,1590],{},[481,1585,1586],{},"Reproduza"," à mão, ou com ",[481,1589,1082],{},", para que as suas mãos fiquem livres para a aba.",[957,1592,1593,1596,1597,1600,1601,1604,1605,1607],{},[481,1594,1595],{},"Observe o mapa"," enquanto o card está sobre a coluna. Vermelho significa que a lista recusa o\ncard: veja o ",[476,1598,1599],{},"group"," dela (",[476,1602,1603],{},"put",") ou o ",[476,1606,1390],{}," do alvo. Azul significa que ela aceita, e o\nproblema vem depois.",[957,1609,1610,1613,1614,1616,1617,1619,1620,1622,1623,1625,1626,1628],{},[481,1611,1612],{},"Leia o log"," desse arraste. ",[476,1615,1159],{}," diz quem disse não — um hook, ou o ",[476,1618,1390],{}," do\nalvo. Se o drop foi concluído mas os seus dados não mudaram, a entrada ",[476,1621,1525],{}," diz se\n",[476,1624,1535],{}," foi chamado e o que ",[476,1627,1531],{}," continha: uma lista controlada precisa\naplicá-lo ela mesma.",[957,1630,1631,1634,1635,1637,1638,1640,1641,775,1643,1645],{},[481,1632,1633],{},"Teste uma correção ao vivo"," em ",[481,1636,1085],{}," — um ",[476,1639,1349],{}," mais flexível, outra\n",[476,1642,1292],{},[476,1644,1123],{}," — e depois escreva no seu código a que funcionar.",[493,1647,1649],{"id":1648},"how-it-works","Como funciona",[473,1651,1652,1653,1656],{},"Os providers se reportam a um hook que o lado da página instala. Até uma aba observar a página,\neles só são registrados; depois disso, a página escuta como qualquer monitor e envia à aba o que\nela mostra — a cada 40 ms durante um arraste, duas vezes por segundo no resto do tempo — e para\nassim que nenhuma aba a observa por alguns segundos. A aba conversa com a página por um\n",[476,1654,1655],{},"BroadcastChannel"," da origem da página. Ela não muda nada além do que você pede: os arrastes, a\nseleção e as substituições de opções.",[1658,1659,1660],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s78Kj, html code.shiki .s78Kj{--shiki-light:#1F8A5B;--shiki-default:#1F8A5B;--shiki-dark:#42B883}html pre.shiki code .s6cML, html code.shiki .s6cML{--shiki-light:#5B5B63;--shiki-default:#5B5B63;--shiki-dark:#9F9FA9}html pre.shiki code .snmWg, html code.shiki .snmWg{--shiki-light:#27272A;--shiki-default:#27272A;--shiki-dark:#E4E4E7}html pre.shiki code .sytrG, html code.shiki .sytrG{--shiki-light:#85858D;--shiki-light-font-style:italic;--shiki-default:#85858D;--shiki-default-font-style:italic;--shiki-dark:#6E6E78;--shiki-dark-font-style:italic}html pre.shiki code .sVvmN, html code.shiki .sVvmN{--shiki-light:#7C4DCC;--shiki-default:#7C4DCC;--shiki-dark:#C3A6FF}",{"title":507,"searchDepth":597,"depth":597,"links":1662},[1663,1669,1670,1671,1672,1673,1674,1675,1676,1677],{"id":495,"depth":581,"text":294,"children":1664},[1665,1666,1667,1668],{"id":499,"depth":597,"text":500},{"id":540,"depth":597,"text":541},{"id":767,"depth":597,"text":768},{"id":782,"depth":597,"text":783},{"id":951,"depth":581,"text":952},{"id":1010,"depth":581,"text":1011},{"id":1097,"depth":581,"text":1098},{"id":1129,"depth":581,"text":1130},{"id":1257,"depth":581,"text":1258},{"id":1412,"depth":581,"text":1413},{"id":1453,"depth":581,"text":1071},{"id":1574,"depth":581,"text":1575},{"id":1648,"depth":581,"text":1649},"Uma aba Vue DnD Kit no Vue DevTools e no Nuxt DevTools — um minimapa ao vivo, um joystick que arrasta de verdade, edição de opções ao vivo e um log de cada arraste.","md",null,{"source":1682},"6f7e373d0b",{"icon":116},{"title":113,"description":1678},"21KQ-suQ97sqzwLlRHR_XuI9SKEIB5kyxOC18ePqzng",[1687,1689],{"title":360,"path":361,"stem":362,"description":1688,"icon":111},"Como a entrada vira um arraste — os sensores de ponteiro e de teclado, restrições de ativação, canDrag, sensores seus e arrastes que você roteiriza com @vue-dnd-kit\u002Factions.",{"title":367,"path":368,"stem":369,"description":1690,"icon":121},"O arrastar e soltar do próprio navegador, como arrastes da biblioteca — arquivos, links e texto de outros apps para alvos de drop e listas que abrem espaço para eles, itens arrastados para fora da página, e entre janelas do seu app.",1793592033838]
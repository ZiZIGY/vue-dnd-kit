{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client", "node"],
    "paths": {
      "@vue-dnd-kit/core": ["../packages/core/src/index.ts"],
      "@vue-dnd-kit/core/devtools": ["../packages/core/src/devtools/index.ts"],
      "@vue-dnd-kit/actions": ["../packages/actions/src/index.ts"],
      "@vue-dnd-kit/devtools": ["../packages/devtools/src/index.ts"],
      "vue": ["./node_modules/vue"],
      "@vueuse/core": ["./node_modules/@vueuse/core"],
      "@vue/devtools-api": ["./node_modules/@vue/devtools-api"],
      // Nuxt UI theme types, generated by its Vite plugin when the dev server or a build runs.
      "#build/ui": ["./node_modules/.nuxt-ui/ui"],
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "kits/**/*.ts", "kits/**/*.vue", "e2e/**/*.ts", "*.config.ts"]
}

4,"toc":1673},"minimark",[485,502,505,509,514,545,551,555,748,767,778,782,793,797,804,925,944,962,966,1015,1021,1025,1105,1108,1112,1115,1137,1140,1144,1157,1177,1187,1268,1271,1277,1420,1423,1426,1429,1460,1463,1466,1469,1566,1584,1588,1591,1658,1662,1669],[486,487,488,492,493,497,498,501],"p",{},[489,490,491],"code",{},"@vue-dnd-kit\u002Fdevtools"," ajoute un onglet ",[494,495,496],"strong",{},"Vue DnD Kit"," aux Vue DevTools\n(",[489,499,500],{},"vite-plugin-vue-devtools",") et aux Nuxt DevTools. Il montre chaque liste, arbre et cible de\ndépôt de la page dans une mini-carte en direct, fait glisser n'importe quel item avec un\njoystick, modifie les options pendant que l'application tourne, et journalise ce que chaque\nglissement a fait. Il ne fonctionne qu'en développement : rien n'en arrive dans un build de\nproduction.",[486,503,504],{},"L'onglet est une page à part entière, servie par votre serveur de développement à côté de votre\napplication : il ne peut donc pas tourner dans cette documentation. Trois étapes suffisent à le\nmettre en place.",[506,507,21],"h2",{"id":508},"install",[510,511,513],"h3",{"id":512},"_1-add-the-packages","1. Ajouter les paquets",[515,516,521],"pre",{"className":517,"code":518,"language":519,"meta":520,"style":520},"language-bash shiki shiki-themes dnd-light dnd-light dnd-dark","npm i -D @vue-dnd-kit\u002Fdevtools @vue-dnd-kit\u002Factions\n","bash","",[489,522,523],{"__ignoreMap":520},[524,525,528,532,536,539,542],"span",{"class":526,"line":527},"line",1,[524,529,531],{"class":530},"sbwC8","npm",[524,533,535],{"class":534},"sN8r7"," i",[524,537,538],{"class":534}," -D",[524,540,541],{"class":534}," @vue-dnd-kit\u002Fdevtools",[524,543,544],{"class":534}," @vue-dnd-kit\u002Factions\n",[486,546,547,550],{},[489,548,549],{},"@vue-dnd-kit\u002Factions"," est une peer dependency : les déplacements de l'onglet passent par lui.\nnpm 7+ et pnpm l'installent d'eux-mêmes ; avec Yarn 1, ajoutez-le.",[510,552,554],{"id":553},"_2-add-the-plugin","2. Ajouter le plugin",[556,557,558,707],"code-group",{},[515,559,564],{"className":560,"code":561,"filename":562,"language":563,"meta":520,"style":520},"language-ts shiki shiki-themes dnd-light dnd-light dnd-dark","import { defineConfig } from 'vite';\nimport vue from '@vitejs\u002Fplugin-vue';\nimport vueDevTools from 'vite-plugin-vue-devtools';\nimport { vueDnDKitDevtools } from '@vue-dnd-kit\u002Fdevtools\u002Fvite';\n\nexport default defineConfig({\n  \u002F\u002F Next to the Vue DevTools plugin: the tab joins its sidebar.\n  plugins: [vueDevTools(), vueDnDKitDevtools(), vue()],\n});\n","vite.config.ts","ts",[489,565,566,592,608,623,642,649,664,671,701],{"__ignoreMap":520},[524,567,568,572,576,580,583,586,589],{"class":526,"line":527},[524,569,571],{"class":570},"s78Kj","import",[524,573,575],{"class":574},"s6cML"," {",[524,577,579],{"class":578},"snmWg"," defineConfig ",[524,581,582],{"class":574},"}",[524,584,585],{"class":570}," from",[524,587,588],{"class":534}," 'vite'",[524,590,591],{"class":574},";\n",[524,593,595,597,600,603,606],{"class":526,"line":594},2,[524,596,571],{"class":570},[524,598,599],{"class":578}," vue ",[524,601,602],{"class":570},"from",[524,604,605],{"class":534}," '@vitejs\u002Fplugin-vue'",[524,607,591],{"class":574},[524,609,611,613,616,618,621],{"class":526,"line":610},3,[524,612,571],{"class":570},[524,614,615],{"class":578}," vueDevTools ",[524,617,602],{"class":570},[524,619,620],{"class":534}," 'vite-plugin-vue-devtools'",[524,622,591],{"class":574},[524,624,626,628,630,633,635,637,640],{"class":526,"line":625},4,[524,627,571],{"class":570},[524,629,575],{"class":574},[524,631,632],{"class":578}," vueDnDKitDevtools ",[524,634,582],{"class":574},[524,636,585],{"class":570},[524,638,639],{"class":534}," '@vue-dnd-kit\u002Fdevtools\u002Fvite'",[524,641,591],{"class":574},[524,643,645],{"class":526,"line":644},5,[524,646,648],{"emptyLinePlaceholder":647},true,"\n",[524,650,652,655,658,661],{"class":526,"line":651},6,[524,653,654],{"class":570},"export",[524,656,657],{"class":570}," default",[524,659,660],{"class":530}," defineConfig",[524,662,663],{"class":574},"({\n",[524,665,667],{"class":526,"line":666},7,[524,668,670],{"class":669},"sytrG","  \u002F\u002F Next to the Vue DevTools plugin: the tab joins its sidebar.\n",[524,672,674,678,681,684,687,690,693,695,698],{"class":526,"line":673},8,[524,675,677],{"class":676},"sVvmN","  plugins",[524,679,680],{"class":574},":",[524,682,683],{"class":574}," [",[524,685,686],{"class":530},"vueDevTools",[524,688,689],{"class":574},"(),",[524,691,692],{"class":530}," vueDnDKitDevtools",[524,694,689],{"class":574},[524,696,697],{"class":530}," vue",[524,699,700],{"class":574},"()],\n",[524,702,704],{"class":526,"line":703},9,[524,705,706],{"class":574},"});\n",[515,708,711],{"className":560,"code":709,"filename":710,"language":563,"meta":520,"style":520},"export default defineNuxtConfig({\n  \u002F\u002F With @vue-dnd-kit\u002Fdevtools installed, the tab appears in development.\n  modules: ['@vue-dnd-kit\u002Fnuxt'],\n});\n","nuxt.config.ts",[489,712,713,724,729,744],{"__ignoreMap":520},[524,714,715,717,719,722],{"class":526,"line":527},[524,716,654],{"class":570},[524,718,657],{"class":570},[524,720,721],{"class":530}," defineNuxtConfig",[524,723,663],{"class":574},[524,725,726],{"class":526,"line":594},[524,727,728],{"class":669},"  \u002F\u002F With @vue-dnd-kit\u002Fdevtools installed, the tab appears in development.\n",[524,730,731,734,736,738,741],{"class":526,"line":610},[524,732,733],{"class":676},"  modules",[524,735,680],{"class":574},[524,737,683],{"class":574},[524,739,740],{"class":534},"'@vue-dnd-kit\u002Fnuxt'",[524,742,743],{"class":574},"],\n",[524,745,746],{"class":526,"line":625},[524,747,706],{"class":574},[486,749,750,751,754,755,758,759,762,763,766],{},"Avec Vite, le plugin fait trois choses sur le serveur de développement (",[489,752,753],{},"vite serve",") : il sert\nl'onglet à ",[489,756,757],{},"\u002F__vue-dnd-kit-devtools\u002F"," (sous votre ",[489,760,761],{},"base","), l'ajoute aux Vue DevTools, et fait en\nsorte que la page lui rende compte avant le démarrage de votre application. Aucun ",[489,764,765],{},"app.use()","\nn'est nécessaire, et les builds ne sont pas touchés.",[486,768,769,770,773,774,777],{},"Avec Nuxt, le module ",[489,771,772],{},"@vue-dnd-kit\u002Fnuxt"," trouve le paquet, sert l'onglet, l'ajoute aux Nuxt\nDevTools et installe le côté page avec un plugin client. ",[489,775,776],{},"vueDndKit: { devtools: false }"," le\ndésactive.",[510,779,781],{"id":780},"_3-run-the-app-in-development","3. Lancer l'application en développement",[486,783,784,785,788,789,792],{},"Démarrez le serveur de développement comme d'habitude (",[489,786,787],{},"vite",", ",[489,790,791],{},"nuxt dev",") et ouvrez\nl'application : l'onglet est prêt. Chaque provider de la page s'y affiche, quelle que soit\nl'application dans laquelle il est rendu.",[510,794,796],{"id":795},"without-the-plugins","Sans les plugins",[486,798,799,800,803],{},"Pour votre propre serveur de développement, ou une page que Vite ne sert pas à partir d'un\n",[489,801,802],{},"index.html"," (configurations SSR), installez vous-même le côté page :",[515,805,808],{"className":560,"code":806,"filename":807,"language":563,"meta":520,"style":520},"import { createApp } from 'vue';\nimport { DnDDevtools } from '@vue-dnd-kit\u002Fdevtools';\nimport App from '.\u002FApp.vue';\n\nconst app = createApp(App);\napp.use(DnDDevtools); \u002F\u002F before mount: providers set up earlier aren't seen\napp.mount('#app');\n","main.ts",[489,809,810,828,846,860,864,887,909],{"__ignoreMap":520},[524,811,812,814,816,819,821,823,826],{"class":526,"line":527},[524,813,571],{"class":570},[524,815,575],{"class":574},[524,817,818],{"class":578}," createApp ",[524,820,582],{"class":574},[524,822,585],{"class":570},[524,824,825],{"class":534}," 'vue'",[524,827,591],{"class":574},[524,829,830,832,834,837,839,841,844],{"class":526,"line":594},[524,831,571],{"class":570},[524,833,575],{"class":574},[524,835,836],{"class":578}," DnDDevtools ",[524,838,582],{"class":574},[524,840,585],{"class":570},[524,842,843],{"class":534}," '@vue-dnd-kit\u002Fdevtools'",[524,845,591],{"class":574},[524,847,848,850,853,855,858],{"class":526,"line":610},[524,849,571],{"class":570},[524,851,852],{"class":578}," App ",[524,854,602],{"class":570},[524,856,857],{"class":534}," '.\u002FApp.vue'",[524,859,591],{"class":574},[524,861,862],{"class":526,"line":625},[524,863,648],{"emptyLinePlaceholder":647},[524,865,866,869,872,875,878,881,884],{"class":526,"line":644},[524,867,868],{"class":570},"const",[524,870,871],{"class":578}," app ",[524,873,874],{"class":574},"=",[524,876,877],{"class":530}," createApp",[524,879,880],{"class":574},"(",[524,882,883],{"class":578},"App",[524,885,886],{"class":574},");\n",[524,888,889,892,895,898,900,903,906],{"class":526,"line":651},[524,890,891],{"class":530},"app",[524,893,894],{"class":574},".",[524,896,897],{"class":530},"use",[524,899,880],{"class":574},[524,901,902],{"class":578},"DnDDevtools",[524,904,905],{"class":574},");",[524,907,908],{"class":669}," \u002F\u002F before mount: providers set up earlier aren't seen\n",[524,910,911,913,915,918,920,923],{"class":526,"line":666},[524,912,891],{"class":530},[524,914,894],{"class":574},[524,916,917],{"class":530},"mount",[524,919,880],{"class":574},[524,921,922],{"class":534},"'#app'",[524,924,886],{"class":574},[486,926,927,928,931,932,935,936,939,940,943],{},"Ou importez ",[489,929,930],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," en premier dans le fichier d'entrée. Utilisez\n",[489,933,934],{},"vueDnDKitDevtools({ inject: false })"," quand le plugin doit servir l'onglet mais que vous\ninstallez vous-même le côté page ; ",[489,937,938],{},"serveTab()"," de ",[489,941,942],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," est le middleware\nqui sert l'onglet.",[945,946,947],"note",{},[486,948,949,950,953,954,957,958,961],{},"Dans un build de production, ",[489,951,952],{},"app.use(DnDDevtools)"," et l'import ",[489,955,956],{},"auto"," se réduisent à presque\nrien : chaque point d'entrée vérifie d'abord ",[489,959,960],{},"process.env.NODE_ENV",", et les bundlers éliminent le\nreste. Sur le serveur, ils ne font rien.",[506,963,965],{"id":964},"open-it","L'ouvrir",[967,968,969,990,1005],"ul",{},[970,971,972,975,976,980,981,980,984,987,988,894],"li",{},[494,973,974],{},"Vue DevTools"," : ",[977,978],"kbd",{"value":979},"Alt"," + ",[977,982],{"value":983},"Shift",[977,985],{"value":986},"D",", ou le bouton Vue\nen bas de la page, puis l'onglet ",[494,989,496],{},[970,991,992,975,995,980,997,980,999,1001,1002,1004],{},[494,993,994],{},"Nuxt DevTools",[977,996],{"value":979},[977,998],{"value":983},[977,1000],{"value":986},", ou le bouton\nNuxt, puis ",[494,1003,496],{}," (dans la barre latérale ou son menu de débordement).",[970,1006,1007,1010,1011,1014],{},[494,1008,1009],{},"Une fenêtre à part"," : ouvrez ",[489,1012,1013],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," sur votre\nserveur de développement, ou le bouton ⧉ de l'onglet. Pratique sur un second écran. Avec\nplusieurs pages ouvertes, un sélecteur en haut choisit celle à observer.",[1016,1017,1018],"warning",{},[486,1019,1020],{},"Gardez l'onglet dans une fenêtre à part, pas dans un onglet de navigateur en arrière-plan de la\nmême fenêtre : la page doit rester visible, et une page masquée annule les glissements.",[506,1022,1024],{"id":1023},"the-tab-at-a-glance","L'onglet en un coup d'œil",[1026,1027,1028,1041],"table",{},[1029,1030,1031],"thead",{},[1032,1033,1034,1038],"tr",{},[1035,1036,1037],"th",{},"Partie",[1035,1039,1040],{},"Ce qu'elle contient",[1042,1043,1044,1061,1073,1088],"tbody",{},[1032,1045,1046,1050],{},[1047,1048,1049],"td",{},"Barre du haut",[1047,1051,1052,1053,1056,1057,1060],{},"Ce que fait le glissement en ce moment (",[489,1054,1055],{},"dragging card-3 → done (accepts)","), la page observée, ",[494,1058,1059],{},"⌖ Pick",", le nombre d'options modifiées avec une réinitialisation, ⧉ (une fenêtre à part) et le thème.",[1032,1062,1063,1066],{},[1047,1064,1065],{},"À gauche : le registre",[1047,1067,1068,1069,1072],{},"Chaque provider sous forme d'arbre : ses listes, arbres, cibles de dépôt et éléments déplaçables. ",[494,1070,1071],{},"☰"," l'affiche ou le masque.",[1032,1074,1075,1085],{},[1047,1076,1077,1078,1081,1082],{},"Au milieu : ",[494,1079,1080],{},"Map"," et ",[494,1083,1084],{},"Log",[1047,1086,1087],{},"La mini-carte en direct de la page, ou le journal des glissements.",[1032,1089,1090,1102],{},[1047,1091,1092,1093,788,1096,788,1099],{},"À droite : ",[494,1094,1095],{},"Drive",[494,1097,1098],{},"Options",[494,1100,1101],{},"State",[1047,1103,1104],{},"Le joystick et les boutons de déplacement, les options du nœud choisi, et ce que le provider en sait.",[486,1106,1107],{},"Choisissez un nœud dans le registre ou un item sur la carte, et la partie droite le suit.",[506,1109,1111],{"id":1110},"the-mini-map","La mini-carte",[486,1113,1114],{},"Une carte en direct par liste, arbre et cible de dépôt, avec des copies de leurs items là où ils\nsont — les mêmes clones que montrerait l'overlay, avec le CSS de la page. Pendant un glissement,\nelle marque :",[967,1116,1117,1128,1131],{},[970,1118,1119,1120,1123,1124,1127],{},"les listes et les cibles qui ",[494,1121,1122],{},"acceptent"," le glissement (en bleu) ou le ",[494,1125,1126],{},"refusent"," (en\nrouge) ;",[970,1129,1130],{},"le placeholder, et la cible sous le pointeur ;",[970,1132,1133,1134,894],{},"le pointeur, la boîte de l'overlay, et la ligne d'insertion des listes en\n",[489,1135,1136],{},"placeholder: 'indicator'",[486,1138,1139],{},"Un clic choisit un item et le met en évidence sur la page ; un double clic fait défiler la page\njusqu'à lui. Utilisez la carte quand un dépôt ne va pas là où vous l'attendez : elle montre d'un\ncoup d'œil quelles listes acceptent le glissement.",[506,1141,1143],{"id":1142},"drive-the-joystick","Drive : le joystick",[486,1145,1146,1147,1149,1150,1081,1153,1156],{},"Choisissez un item — sur la carte, dans le registre, ou avec ",[494,1148,1059],{},", qui prend l'appui\nsuivant sur un élément déplaçable de la page au lieu de le laisser agir — et poussez le bouton du\njoystick. L'item est saisi et se déplace dans ce sens, d'autant plus vite que le bouton est loin\ndu centre. Relâchez et il s'arrête ; ",[494,1151,1152],{},"Drop",[494,1154,1155],{},"Cancel"," terminent le glissement.",[486,1158,1159,1160,1163,1164,1169,1170,1081,1173,1176],{},"C'est un vrai glissement au pointeur d'un capteur nommé ",[489,1161,1162],{},"devtools",", fait avec\nl'",[1165,1166,1168],"a",{"href":1167},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API publique des capteurs"," : les listes se trient\nen dessous, les conteneurs défilent automatiquement à leurs bords, et ",[489,1171,1172],{},"onBeforeDrop",[489,1174,1175],{},"onDrop","\ns'exécutent comme pour n'importe quel glissement. Les items désactivés ne sont pas saisis. Un\nglissement au clavier démarré par la page peut aussi être dirigé.",[486,1178,1179,1180,1186],{},"Les items des listes triables ont aussi des boutons : vers le haut, vers le bas, au début, à la\nfin, vers une autre liste du groupe. Chacun est un glissement au clavier de\n",[1165,1181,1183],{"href":1182},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[489,1184,1185],{},"moveItem",". Sous le joystick, une grande copie de ce\nque montre l'overlay.",[1026,1188,1189,1199],{},[1029,1190,1191],{},[1032,1192,1193,1196],{},[1035,1194,1195],{},"Touche, dans l'onglet",[1035,1197,1198],{},"Effet",[1042,1200,1201,1224,1234,1248,1258],{},[1032,1202,1203,1218],{},[1047,1204,1205,1206,1209,1210,1209,1213,1209,1216],{},"Flèches ou ",[977,1207],{"value":1208},"W"," ",[977,1211],{"value":1212},"A",[977,1214],{"value":1215},"S",[977,1217],{"value":986},[1047,1219,1220,1221,1223],{},"Pousse le bouton dans ce sens, à mi-course ; avec ",[977,1222],{"value":983},", jusqu'au bout",[1032,1225,1226,1231],{},[1047,1227,1228],{},[977,1229],{"value":1230},"G",[1047,1232,1233],{},"Saisit l'item choisi",[1032,1235,1236,1245],{},[1047,1237,1238,1241,1242],{},[977,1239],{"value":1240},"Space"," \u002F ",[977,1243],{"value":1244},"Enter",[1047,1246,1247],{},"Dépose",[1032,1249,1250,1255],{},[1047,1251,1252],{},[977,1253],{"value":1254},"Escape",[1047,1256,1257],{},"Annule",[1032,1259,1260,1265],{},[1047,1261,1262],{},[977,1263],{"value":1264},"P",[1047,1266,1267],{},"Choisit sur la page",[506,1269,1098],{"id":1270},"options",[486,1272,1273,1274,1276],{},"Chaque option qui n'est pas un callback peut être modifiée pendant que l'application tourne.\nChoisissez le nœud et ouvrez ",[494,1275,1098],{}," :",[1026,1278,1279,1288],{},[1029,1280,1281],{},[1032,1282,1283,1286],{},[1035,1284,1285],{},"Nœud",[1035,1287,1098],{},[1042,1289,1290,1332,1371,1389,1406],{},[1032,1291,1292,1295],{},[1047,1293,1294],{},"Provider",[1047,1296,1297,788,1300,788,1303,788,1306,1309,1310,788,1313,788,1316,788,1319,788,1322,788,1325,788,1328,1331],{},[489,1298,1299],{},"overlayFit",[489,1301,1302],{},"autoScroll",[489,1304,1305],{},"collision",[489,1307,1308],{},"modifiers"," (ceux de la bibliothèque, par nom), ",[489,1311,1312],{},"animation",[489,1314,1315],{},"dropAnimation",[489,1317,1318],{},"animateChanges",[489,1320,1321],{},"activation",[489,1323,1324],{},"keyboard",[489,1326,1327],{},"haptics",[489,1329,1330],{},"copyModifier","…",[1032,1333,1334,1337],{},[1047,1335,1336],{},"Liste",[1047,1338,1339,788,1342,788,1345,788,1348,788,1351,788,1354,788,1357,788,1360,788,1363,788,1365,788,1367,788,1369],{},[489,1340,1341],{},"disabled",[489,1343,1344],{},"strategy",[489,1346,1347],{},"placeholder",[489,1349,1350],{},"behavior",[489,1352,1353],{},"multiple",[489,1355,1356],{},"sort",[489,1358,1359],{},"dropOutside",[489,1361,1362],{},"acceptMode",[489,1364,1312],{},[489,1366,1318],{},[489,1368,1302],{},[489,1370,1308],{},[1032,1372,1373,1376],{},[1047,1374,1375],{},"Arbre",[1047,1377,1378,788,1380,788,1383,788,1386,1331],{},[489,1379,1347],{},[489,1381,1382],{},"indentation",[489,1384,1385],{},"nesting",[489,1387,1388],{},"maxDepth",[1032,1390,1391,1394],{},[1047,1392,1393],{},"Cible de dépôt",[1047,1395,1396,788,1398,788,1401,788,1404],{},[489,1397,1341],{},[489,1399,1400],{},"priority",[489,1402,1403],{},"accept",[489,1405,1362],{},[1032,1407,1408,1411],{},[1047,1409,1410],{},"Item",[1047,1412,1413,788,1415,788,1418],{},[489,1414,1341],{},[489,1416,1417],{},"keyboardMode",[489,1419,1321],{},[486,1421,1422],{},"Une modification s'applique tout de suite, à cette page uniquement, et n'est jamais écrite dans\nvotre code : la bibliothèque lit la nouvelle valeur là où elle lit l'option. Elle dure jusqu'à ce\nque vous la réinitialisiez (↺ par option, ou la réinitialisation de la barre du haut), que le\nprovider soit démonté ou que la page soit rechargée. Une option modifiée affiche à côté d'elle la\nvaleur de votre code. Les items montés pendant qu'une modification est active — les lignes d'une\nliste virtuelle — la reçoivent aussi.",[506,1424,1101],{"id":1425},"state",[486,1427,1428],{},"Ce que sait chaque provider, pour le nœud que vous avez choisi :",[967,1430,1431,1438,1449],{},[970,1432,1433,1434,1437],{},"la ",[494,1435,1436],{},"session de glissement"," : le statut, les ids, items et capteur actifs, la cible et si elle\naccepte, le pointeur, l'overlay, la session du groupe triable et la ligne d'insertion ;",[970,1439,1440,1441,1444,1445,1448],{},"une ",[494,1442,1443],{},"liste"," : son ordre et son brouillon ; un ",[494,1446,1447],{},"arbre"," : ses lignes ;",[970,1450,1451,1452,1455,1456,1459],{},"un ",[494,1453,1454],{},"item"," : son type, ses données et sa position ; une ",[494,1457,1458],{},"cible de dépôt"," : ses règles.",[486,1461,1462],{},"Les items se montent et se démontent sans événements : le registre se met à jour en moins d'une\nseconde.",[506,1464,1084],{"id":1465},"log",[486,1467,1468],{},"Une bande par glissement, dans l'ordre :",[1026,1470,1471,1481],{},[1029,1472,1473],{},[1032,1474,1475,1478],{},[1035,1476,1477],{},"Entrée",[1035,1479,1480],{},"Ce qu'elle indique",[1042,1482,1483,1493,1506,1519,1531,1549],{},[1032,1484,1485,1490],{},[1047,1486,1487],{},[489,1488,1489],{},"drag start",[1047,1491,1492],{},"Les ids, le capteur et s'il s'agit du toucher, la liste d'origine.",[1032,1494,1495,1503],{},[1047,1496,1497,788,1500],{},[489,1498,1499],{},"over",[489,1501,1502],{},"left",[1047,1504,1505],{},"Chaque cible où il entre et d'où il sort, et si elle accepte.",[1032,1507,1508,1513],{},[1047,1509,1510],{},[489,1511,1512],{},"release",[1047,1514,1515,1516,1518],{},"La cible au-dessus de laquelle il a été relâché, pendant qu'",[489,1517,1172],{}," décide.",[1032,1520,1521,1525],{},[1047,1522,1523],{},[489,1524,1172],{},[1047,1526,1527,1528,1530],{},"Le verdict : accepté, partiellement accepté, refusé par un hook, refusé par l'",[489,1529,1403],{}," de la cible, et le temps qu'ont pris les hooks.",[1032,1532,1533,1538],{},[1047,1534,1535],{},[489,1536,1537],{},"drop",[1047,1539,1540,1541,1544,1545,1548],{},"La cible ; pour les listes triables, le déplacement, ",[489,1542,1543],{},"e.result",", et si ",[489,1546,1547],{},"preventDefault()"," a été appelé.",[1032,1550,1551,1556],{},[1047,1552,1553],{},[489,1554,1555],{},"cancel",[1047,1557,1558,1559,1562,1563,1565],{},"Pourquoi : annulé (Escape, ",[489,1560,1561],{},"cancel()","), refusé par un hook, ou refusé par l'",[489,1564,1403],{}," de la cible.",[486,1567,1568,1569,1081,1572,1575,1576,1579,1580,1583],{},"Aussi ",[489,1570,1571],{},"auto-scroll on",[489,1573,1574],{},"off",", les textes des ",[489,1577,1578],{},"announcement"," (masqués par défaut) et, en dehors\ndes glissements, ",[489,1581,1582],{},"animate"," (les changements des items d'une liste qui ne viennent pas d'un\nglissement). Cliquez sur une entrée pour voir ses données. Un onglet ouvert plus tard reçoit les\nglissements déjà faits.",[506,1585,1587],{"id":1586},"debug-a-drop-step-by-step","Déboguer un dépôt, pas à pas",[486,1589,1590],{},"Une carte refuse d'aller dans une colonne. Avec l'onglet ouvert :",[1592,1593,1594,1603,1620,1641],"ol",{},[970,1595,1596,1599,1600,1602],{},[494,1597,1598],{},"Reproduisez-le"," à la main, ou avec ",[494,1601,1095],{}," pour garder les mains libres pour l'onglet.",[970,1604,1605,1608,1609,1612,1613,1616,1617,1619],{},[494,1606,1607],{},"Observez la carte"," pendant que la carte est au-dessus de la colonne. Du rouge signifie que la\nliste refuse la carte : regardez son ",[489,1610,1611],{},"group"," (",[489,1614,1615],{},"put",") ou l'",[489,1618,1403],{}," de la cible. Du bleu\nsignifie qu'elle l'accepte, et que le problème vient plus tard.",[970,1621,1622,1625,1626,1628,1629,1631,1632,1634,1635,1637,1638,1640],{},[494,1623,1624],{},"Lisez le journal"," de ce glissement. ",[489,1627,1172],{}," dit qui a dit non — un hook, ou\nl'",[489,1630,1403],{}," de la cible. Si le dépôt a abouti mais que vos données n'ont pas changé, l'entrée\n",[489,1633,1537],{}," indique si ",[489,1636,1547],{}," a été appelé et ce que contenait ",[489,1639,1543],{}," : une liste\ncontrôlée doit l'appliquer elle-même.",[970,1642,1643,1646,1647,1649,1650,1652,1653,788,1655,1657],{},[494,1644,1645],{},"Essayez un correctif en direct"," dans ",[494,1648,1098],{}," — un ",[489,1651,1362],{}," plus souple, une autre\n",[489,1654,1305],{},[489,1656,1136],{}," — puis écrivez dans votre code celui qui fonctionne.",[506,1659,1661],{"id":1660},"how-it-works","Comment ça marche",[486,1663,1664,1665,1668],{},"Les providers rendent compte à un hook qu'installe le côté page. Tant qu'aucun onglet n'observe\nla page, ils sont seulement enregistrés ; ensuite, la page écoute comme n'importe quel moniteur et\nenvoie à l'onglet ce qu'il affiche — toutes les 40 ms pendant un glissement, deux fois par seconde\nsinon — et s'arrête quand aucun onglet ne l'a observée depuis quelques secondes. L'onglet parle à\nla page via un ",[489,1666,1667],{},"BroadcastChannel"," de l'origine de la page. Il ne change rien d'autre que ce que\nvous demandez : les glissements, la sélection et les options remplacées.",[1670,1671,1672],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s78Kj, html code.shiki .s78Kj{--shiki-light:#1F8A5B;--shiki-default:#1F8A5B;--shiki-dark:#42B883}html pre.shiki code .s6cML, html code.shiki .s6cML{--shiki-light:#5B5B63;--shiki-default:#5B5B63;--shiki-dark:#9F9FA9}html pre.shiki code .snmWg, html code.shiki .snmWg{--shiki-light:#27272A;--shiki-default:#27272A;--shiki-dark:#E4E4E7}html pre.shiki code .sytrG, html code.shiki .sytrG{--shiki-light:#85858D;--shiki-light-font-style:italic;--shiki-default:#85858D;--shiki-default-font-style:italic;--shiki-dark:#6E6E78;--shiki-dark-font-style:italic}html pre.shiki code .sVvmN, html code.shiki .sVvmN{--shiki-light:#7C4DCC;--shiki-default:#7C4DCC;--shiki-dark:#C3A6FF}",{"title":520,"searchDepth":610,"depth":610,"links":1674},[1675,1681,1682,1683,1684,1685,1686,1687,1688,1689],{"id":508,"depth":594,"text":21,"children":1676},[1677,1678,1679,1680],{"id":512,"depth":610,"text":513},{"id":553,"depth":610,"text":554},{"id":780,"depth":610,"text":781},{"id":795,"depth":610,"text":796},{"id":964,"depth":594,"text":965},{"id":1023,"depth":594,"text":1024},{"id":1110,"depth":594,"text":1111},{"id":1142,"depth":594,"text":1143},{"id":1270,"depth":594,"text":1098},{"id":1425,"depth":594,"text":1101},{"id":1465,"depth":594,"text":1084},{"id":1586,"depth":594,"text":1587},{"id":1660,"depth":594,"text":1661},"Un onglet Vue DnD Kit dans les Vue DevTools et les Nuxt DevTools — une mini-carte en direct, un joystick qui fait vraiment glisser, l'édition des options en direct et un journal de chaque glissement.","md",null,{"source":1694},"6f7e373d0b",{"icon":116},{"title":113,"description":1690},"iWHNMVb88xDBx2fSl9m-yBd4wtk9Wual25j6vkIfzXU",[1699,1701],{"title":365,"path":366,"stem":367,"description":1700,"icon":111},"Comment une entrée devient un glissement — les capteurs pointeur et clavier, les contraintes d'activation, canDrag, vos propres capteurs, et les glissements que vous scriptez avec @vue-dnd-kit\u002Factions.",{"title":372,"path":373,"stem":374,"description":1702,"icon":121},"Le glisser-déposer propre au navigateur, sous forme de glissements de la bibliothèque — des fichiers, des liens et du texte venus d'autres applications dans des cibles de dépôt et des listes qui leur font de la place, des items glissés hors de la page, et entre les fenêtres de votre application.",1793925647790]
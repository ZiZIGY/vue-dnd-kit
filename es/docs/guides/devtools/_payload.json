pia, servida por tu servidor de desarrollo junto a tu app, así que no\npuede ejecutarse dentro de esta documentación. Se configura en tres pasos.",[489,490,290],"h2",{"id":491},"install",[493,494,496],"h3",{"id":495},"_1-add-the-packages","1. Añadir los paquetes",[498,499,504],"pre",{"className":500,"code":501,"language":502,"meta":503,"style":503},"language-bash shiki shiki-themes dnd-light dnd-light dnd-dark","npm i -D @vue-dnd-kit\u002Fdevtools @vue-dnd-kit\u002Factions\n","bash","",[472,505,506],{"__ignoreMap":503},[507,508,511,515,519,522,525],"span",{"class":509,"line":510},"line",1,[507,512,514],{"class":513},"sbwC8","npm",[507,516,518],{"class":517},"sN8r7"," i",[507,520,521],{"class":517}," -D",[507,523,524],{"class":517}," @vue-dnd-kit\u002Fdevtools",[507,526,527],{"class":517}," @vue-dnd-kit\u002Factions\n",[469,529,530,533],{},[472,531,532],{},"@vue-dnd-kit\u002Factions"," es una peer dependency: los movimientos de la pestaña pasan por él. npm 7+\ny pnpm lo instalan solos; con Yarn 1, añádelo.",[493,535,537],{"id":536},"_2-add-the-plugin","2. Añadir el plugin",[539,540,541,690],"code-group",{},[498,542,547],{"className":543,"code":544,"filename":545,"language":546,"meta":503,"style":503},"language-ts shiki shiki-themes dnd-light dnd-light dnd-dark","import { defineConfig } from 'vite';\nimport vue from '@vitejs\u002Fplugin-vue';\nimport vueDevTools from 'vite-plugin-vue-devtools';\nimport { vueDnDKitDevtools } from '@vue-dnd-kit\u002Fdevtools\u002Fvite';\n\nexport default defineConfig({\n  \u002F\u002F Next to the Vue DevTools plugin: the tab joins its sidebar.\n  plugins: [vueDevTools(), vueDnDKitDevtools(), vue()],\n});\n","vite.config.ts","ts",[472,548,549,575,591,606,625,632,647,654,684],{"__ignoreMap":503},[507,550,551,555,559,563,566,569,572],{"class":509,"line":510},[507,552,554],{"class":553},"s78Kj","import",[507,556,558],{"class":557},"s6cML"," {",[507,560,562],{"class":561},"snmWg"," defineConfig ",[507,564,565],{"class":557},"}",[507,567,568]
h @vue-dnd-kit\u002Fdevtools installed, the tab appears in development.\n  modules: ['@vue-dnd-kit\u002Fnuxt'],\n});\n","nuxt.config.ts",[472,695,696,707,712,727],{"__ignoreMap":503},[507,697,698,700,702,705],{"class":509,"line":510},[507,699,637],{"class":553},[507,701,640],{"class":553},[507,703,704],{"class":513}," defineNuxtConfig",[507,706,646],{"class":557},[507,708,709],{"class":509,"line":577},[507,710,711],{"class":652},"  \u002F\u002F With @vue-dnd-kit\u002Fdevtools installed, the tab appears in development.\n",[507,713,714,717,719,721,724],{"class":509,"line":593},[507,715,716],{"class":659},"  modules",[507,718,663],{"class":557},[507,720,666],{"class":557},[507,722,723],{"class":517},"'@vue-dnd-kit\u002Fnuxt'",[507,725,726],{"class":557},"],\n",[507,728,729],{"class":509,"line":608},[507,730,689],{"class":557},[469,732,733,734,737,738,741,742,745,746,749],{},"Con Vite, el plugin hace tres cosas en el servidor de desarrollo (",[472,735,736],{},"vite serve","): sirve la pestaña\nen ",[472,739,740],{},"\u002F__vue-dnd-kit-devtools\u002F"," (bajo tu ",[472,743,744],{},"base","), la añade a las Vue DevTools y hace que la página le\ninforme antes de que arranque tu app. No hace falta ningún ",[472,747,748],{},"app.use()",", y las builds no se tocan.",[469,751,752,753,756,757,760],{},"Con Nuxt, el módulo ",[472,754,755],{},"@vue-dnd-kit\u002Fnuxt"," encuentra el paquete, sirve la pestaña, la añade a las\nNuxt DevTools e instala la parte de la página con un plugin de cliente.\n",[472,758,759],{},"vueDndKit: { devtools: false }"," la desactiva.",[493,762,764],{"id":763},"_3-run-the-app-in-development","3. Ejecutar la app en desarrollo",[469,766,767,768,771,772,775],{},"Arranca el servidor de desarrollo como siempre (",[472,769,770],{},"vite",", ",[472,773,774],{},"nuxt dev",") y abre la app: la pestaña está\nlista. Cada provider de la página aparece en ella, sea cual sea la app en la que se renderiza.",[493,777,779],{"id":778},"without-the-plugins","Sin los plugins",[469,781,782,783,786],{},"Para un servidor de desarrollo propio, o una página que Vite no sirve a partir de un ",[472,784,785],{},"index.html","\n(configuraciones SSR), instala tú la parte de la página:",[498,788,791],{"className":543,"code":789,"filename":790,"language":546,"meta":503,"style":503},"import { createApp } from 'vue';\nimport { DnDDevtools } from '@vue-dnd-kit\u002Fdevtools';\nimport App from '.\u002FApp.vue';\n\nconst app = createApp(App);\napp.use(DnDDevtools); \u002F\u002F before mount: providers set up earlier aren't seen\napp.mount('#app');\n","main.ts",[472,792,793,811,829,843,847,870,892],{"__ignoreMap":503},[507,794,795,797,799,802,804,806,809],{"class":509,"line":510},[507,796,554],{"class":553},[507,798,558],{"class":557},[507,800,801],{"class":561}," createApp ",[507,803,565],{"class":557},[507,805,568],{"class":553},[507,807,808],{"class":517}," 'vue'",[507,810,574],{"class":557},[507,812,813,815,817,820,822,824,827],{"class":509,"line":577},[507,814,554],{"class":553},[507,816,558],{"class":557},[507,818,819],{"class":561}," DnDDevtools ",[507,821,565],{"class":557},[507,823,568],{"class":553},[507,825,826],{"class":517}," '@vue-dnd-kit\u002Fdevtools'",[507,828,574],{"class":557},[507,830,831,833,836,838,841],{"class":509,"line":593},[507,832,554],{"class":553},[507,834,835],{"class":561}," App ",[507,837,585],{"class":553},[507,839,840],{"class":517}," '.\u002FApp.vue'",[507,842,574],{"class":557},[507,844,845],{"class":509,"line":608},[507,846,631],{"emptyLinePlaceholder":630},[507,848,849,852,855,858,861,864,867],{"class":509,"line":627},[507,850,851],{"class":553},"const",[507,853,854],{"class":561}," app ",[507,856,857],{"class":557},"=",[507,859,860],{"class":513}," createApp",[507,862,863],{"class":557},"(",[507,865,866],{"class":561},"App",[507,868,869],{"class":557},");\n",[507,871,872,875,878,881,883,886,889],{"class":509,"line":634},[507,873,874],{"class":513},"app",[507,876,877],{"class":557},".",[507,879,880],{"class":513},"use",[507,882,863],{"class":557},[507,884,885],{"class":561},"DnDDevtools",[507,887,888],{"class":557},");",[507,890,891],{"class":652}," \u002F\u002F before mount: providers set up earlier aren't seen\n",[507,893,894,896,898,901,903,906],{"class":509,"line":649},[507,895,874],{"class":513},[507,897,877],{"class":557},[507,899,900],{"class":513},"mount",[507,902,863],{"class":557},[507,904,905],{"class":517},"'#app'",[507,907,869],{"class":557},[469,909,910,911,914,915,918,919,922,923,926],{},"O importa ",[472,912,913],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," lo primero en el archivo de entrada. Usa\n",[472,916,917],{},"vueDnDKitDevtools({ inject: false })"," cuando el plugin deba servir la pestaña pero la parte de la\npágina la instales tú; ",[472,920,921],{},"serveTab()"," de ",[472,924,925],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," es el middleware que sirve la\npestaña.",[928,929,930],"note",{},[469,931,932,933,936,937,940,941,944],{},"En una build de producción, ",[472,934,935],{},"app.use(DnDDevtools)"," y el import ",[472,938,939],{},"auto"," se reducen casi a nada: cada\npunto de entrada comprueba primero ",[472,942,943],{},"process.env.NODE_ENV",", y los bundlers eliminan el resto. En el\nservidor no hacen nada.",[489,946,948],{"id":947},"open-it","Abrirla",[950,951,952,973,988],"ul",{},[953,954,955,958,959,963,964,963,967,970,971,877],"li",{},[477,956,957],{},"Vue DevTools",": ",[960,961],"kbd",{"value":962},"Alt"," + ",[960,965],{"value":966},"Shift",[960,968],{"value":969},"D",", o el botón de Vue\nen la parte inferior de la página, y luego la pestaña ",[477,972,479],{},[953,974,975,958,978,963,980,963,982,984,985,987],{},[477,976,977],{},"Nuxt DevTools",[960,979],{"value":962},[960,981],{"value":966},[960,983],{"value":969},", o el botón de\nNuxt, y luego ",[477,986,479],{}," (en la barra lateral o en su menú de desbordamiento).",[953,989,990,993,994,997],{},[477,991,992],{},"Una ventana propia",": abre ",[472,995,996],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," en tu servidor de\ndesarrollo, o el botón ⧉ de la pestaña. Muy práctico en una segunda pantalla. Con varias páginas\nabiertas, un selector arriba elige la que observar.",[999,1000,1001],"warning",{},[469,1002,1003],{},"Mantén la pestaña en una ventana propia, no en una pestaña del navegador en segundo plano de la\nmisma ventana: la página debe seguir visible, y una página oculta cancela los arrastres.",[489,1005,1007],{"id":1006},"the-tab-at-a-glance","La pestaña de un vistazo",[1009,1010,1011,1024],"table",{},[1012,1013,1014],"thead",{},[1015,1016,1017,1021],"tr",{},[1018,1019,1020],"th",{},"Parte",[1018,1022,1023],{},"Qué contiene",[1025,1026,1027,1044,1056,1071],"tbody",{},[1015,1028,1029,1033],{},[1030,1031,1032],"td",{},"Barra superior",[1030,1034,1035,1036,1039,1040,1043],{},"Lo que está haciendo el arrastre ahora mismo (",[472,1037,1038],{},"dragging card-3 → done (accepts)","), la página observada, ",[477,1041,1042],{},"⌖ Pick",", el número de opciones editadas con un botón para restablecerlas, ⧉ (una ventana propia) y el tema.",[1015,1045,1046,1049],{},[1030,1047,1048],{},"Izquierda: el registro",[1030,1050,1051,1052,1055],{},"Cada provider como un árbol: sus listas, árboles, destinos de drop y elementos arrastrables. ",[477,1053,1054],{},"☰"," lo muestra u oculta.",[1015,1057,1058,1068],{},[1030,1059,1060,1061,1064,1065],{},"Centro: ",[477,1062,1063],{},"Map"," y ",[477,1066,1067],{},"Log",[1030,1069,1070],{},"El minimapa en vivo de la página, o el registro de los arrastres.",[1015,1072,1073,1085],{},[1030,1074,1075,1076,771,1079,771,1082],{},"Derecha: ",[477,1077,1078],{},"Drive",[477,1080,1081],{},"Options",[477,1083,1084],{},"State",[1030,1086,1087],{},"El joystick y los botones de mover, las opciones del nodo elegido y lo que el provider sabe de él.",[469,1089,1090],{},"Elige un nodo en el registro o un ítem en el mapa, y la parte derecha lo sigue.",[489,1092,1094],{"id":1093},"the-mini-map","El minimapa",[469,1096,1097],{},"Una tarjeta en vivo por lista, árbol y destino de drop, con copias de sus ítems donde están — los\nmismos clones que mostraría el overlay, con el CSS de la página. Durante un arrastre marca:",[950,1099,1100,1111,1114],{},[953,1101,1102,1103,1106,1107,1110],{},"las listas y los destinos que ",[477,1104,1105],{},"aceptan"," el arrastre (en azul) o lo ",[477,1108,1109],{},"rechazan"," (en rojo);",[953,1112,1113],{},"el placeholder y el destino bajo el puntero;",[953,1115,1116,1117,877],{},"el puntero, la caja del overlay y la línea de inserción de las listas con\n",[472,1118,1119],{},"placeholder: 'indicator'",[469,1121,1122],{},"Un clic elige un ítem y lo resalta en la página; un doble clic desplaza la página hasta él. Usa el\nmapa cuando un drop no va adonde esperas: muestra de un vistazo qué listas aceptan el arrastre.",[489,1124,1126],{"id":1125},"drive-the-joystick","Drive: el joystick",[469,1128,1129,1130,1132,1133,1064,1136,1139],{},"Elige un ítem — en el mapa, en el registro o con ",[477,1131,1042],{},", que toma la siguiente pulsación sobre\nun elemento arrastrable de la página en lugar de dejar que actúe — y empuja la palanca del\njoystick. El ítem se agarra y se mueve en esa dirección, más rápido cuanto más lejos del centro\nesté la palanca. Suéltala y se detiene; ",[477,1134,1135],{},"Drop",[477,1137,1138],{},"Cancel"," terminan el arrastre.",[469,1141,1142,1143,1146,1147,1152,1153,1064,1156,1159],{},"Es un arrastre de puntero real de un sensor llamado ",[472,1144,1145],{},"devtools",", hecho con la\n",[1148,1149,1151],"a",{"href":1150},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API pública de sensores",": las listas ordenan debajo,\nlos contenedores se desplazan automáticamente en sus bordes, y ",[472,1154,1155],{},"onBeforeDrop",[472,1157,1158],{},"onDrop"," se\nejecutan como en cualquier arrastre. Los ítems desactivados no se agarran. También se puede\ndirigir un arrastre con teclado que haya empezado la página.",[469,1161,1162,1163,1169],{},"Los ítems de las listas ordenables tienen además botones: arriba, abajo, al principio, al final, a\notra lista del grupo. Cada uno es un arrastre con teclado de\n",[1148,1164,1166],{"href":1165},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[472,1167,1168],{},"moveItem",". Debajo del joystick, una copia grande de lo\nque muestra el overlay.",[1009,1171,1172,1182],{},[1012,1173,1174],{},[1015,1175,1176,1179],{},[1018,1177,1178],{},"Tecla, en la pestaña",[1018,1180,1181],{},"Hace",[1025,1183,1184,1207,1217,1231,1241],{},[1015,1185,1186,1201],{},[1030,1187,1188,1189,1192,1193,1192,1196,1192,1199],{},"Flechas o ",[960,1190],{"value":1191},"W"," ",[960,1194],{"value":1195},"A",[960,1197],{"value":1198},"S",[960,1200],{"value":969},[1030,1202,1203,1204,1206],{},"Empuja la palanca en esa dirección, a medio recorrido; con ",[960,1205],{"value":966},", hasta el tope",[1015,1208,1209,1214],{},[1030,1210,1211],{},[960,1212],{"value":1213},"G",[1030,1215,1216],{},"Agarra el ítem elegido",[1015,1218,1219,1228],{},[1030,1220,1221,1224,1225],{},[960,1222],{"value":1223},"Space"," \u002F ",[960,1226],{"value":1227},"Enter",[1030,1229,1230],{},"Suelta",[1015,1232,1233,1238],{},[1030,1234,1235],{},[960,1236],{"value":1237},"Escape",[1030,1239,1240],{},"Cancela",[1015,1242,1243,1248],{},[1030,1244,1245],{},[960,1246],{"value":1247},"P",[1030,1249,1250],{},"Elige en la página",[489,1252,1254],{"id":1253},"options","Opciones",[469,1256,1257,1258,663],{},"Toda opción que no sea un callback se puede editar mientras la app se ejecuta. Elige el nodo y\nabre ",[477,1259,1081],{},[1009,1261,1262,1271],{},[1012,1263,1264],{},[1015,1265,1266,1269],{},[1018,1267,1268],{},"Nodo",[1018,1270,1254],{},[1025,1272,1273,1315,1354,1372,1389],{},[1015,1274,1275,1278],{},[1030,1276,1277],{},"Provider",[1030,1279,1280,771,1283,771,1286,771,1289,1292,1293,771,1296,771,1299,771,1302,771,1305,771,1308,771,1311,1314],{},[472,1281,1282],{},"overlayFit",[472,1284,1285],{},"autoScroll",[472,1287,1288],{},"collision",[472,1290,1291],{},"modifiers"," (los de la biblioteca, por nombre), ",[472,1294,1295],{},"animation",[472,1297,1298],{},"dropAnimation",[472,1300,1301],{},"animateChanges",[472,1303,1304],{},"activation",[472,1306,1307],{},"keyboard",[472,1309,1310],{},"haptics",[472,1312,1313],{},"copyModifier","…",[1015,1316,1317,1320],{},[1030,1318,1319],{},"Lista",[1030,1321,1322,771,1325,771,1328,771,1331,771,1334,771,1337,771,1340,771,1343,771,1346,771,1348,771,1350,771,1352],{},[472,1323,1324],{},"disabled",[472,1326,1327],{},"strategy",[472,1329,1330],{},"placeholder",[472,1332,1333],{},"behavior",[472,1335,1336],{},"multiple",[472,1338,1339],{},"sort",[472,1341,1342],{},"dropOutside",[472,1344,1345],{},"acceptMode",[472,1347,1295],{},[472,1349,1301],{},[472,1351,1285],{},[472,1353,1291],{},[1015,1355,1356,1359],{},[1030,1357,1358],{},"Árbol",[1030,1360,1361,771,1363,771,1366,771,1369,1314],{},[472,1362,1330],{},[472,1364,1365],{},"indentation",[472,1367,1368],{},"nesting",[472,1370,1371],{},"maxDepth",[1015,1373,1374,1377],{},[1030,1375,1376],{},"Destino de drop",[1030,1378,1379,771,1381,771,1384,771,1387],{},[472,1380,1324],{},[472,1382,1383],{},"priority",[472,1385,1386],{},"accept",[472,1388,1345],{},[1015,1390,1391,1394],{},[1030,1392,1393],{},"Ítem",[1030,1395,1396,771,1398,771,1401],{},[472,1397,1324],{},[472,1399,1400],{},"keyboardMode",[472,1402,1304],{},[469,1404,1405],{},"Una edición se aplica al momento, solo a esta página, y nunca se escribe en tu código: la\nbiblioteca lee el nuevo valor donde lee la opción. Dura hasta que la restableces (↺ por opción, o\nel botón de la barra superior), se desmonta el provider o se recarga la página. Una opción editada\nmuestra a su lado el valor de tu código. Los ítems que se montan mientras hay una edición activa —\nfilas de una lista virtual — también la reciben.",[489,1407,1409],{"id":1408},"state","Estado",[469,1411,1412],{},"Lo que sabe cada provider, para el nodo que elegiste:",[950,1414,1415,1422,1433],{},[953,1416,1417,1418,1421],{},"la ",[477,1419,1420],{},"sesión de arrastre",": el estado, los ids, ítems y sensor activos, el destino y si acepta,\nel puntero, el overlay, la sesión del grupo ordenable y la línea de inserción;",[953,1423,1424,1425,1428,1429,1432],{},"una ",[477,1426,1427],{},"lista",": su orden y su borrador; un ",[477,1430,1431],{},"árbol",": sus filas;",[953,1434,1435,1436,1439,1440,1443],{},"un ",[477,1437,1438],{},"ítem",": su tipo, sus datos y su posición; un ",[477,1441,1442],{},"destino de drop",": sus reglas.",[469,1445,1446],{},"Los ítems se montan y desmontan sin eventos: el registro se pone al día en menos de un segundo.",[489,1448,1450],{"id":1449},"log","Registro",[469,1452,1453],{},"Una franja por arrastre, en orden:",[1009,1455,1456,1466],{},[1012,1457,1458],{},[1015,1459,1460,1463],{},[1018,1461,1462],{},"Entrada",[1018,1464,1465],{},"Qué indica",[1025,1467,1468,1478,1491,1503,1515,1532],{},[1015,1469,1470,1475],{},[1030,1471,1472],{},[472,1473,1474],{},"drag start",[1030,1476,1477],{},"Los ids, el sensor y si es táctil, la lista de la que viene.",[1015,1479,1480,1488],{},[1030,1481,1482,771,1485],{},[472,1483,1484],{},"over",[472,1486,1487],{},"left",[1030,1489,1490],{},"Cada destino en el que entra y del que sale, y si acepta.",[1015,1492,1493,1498],{},[1030,1494,1495],{},[472,1496,1497],{},"release",[1030,1499,1500,1501,877],{},"El destino sobre el que se soltó, mientras decide ",[472,1502,1155],{},[1015,1504,1505,1509],{},[1030,1506,1507],{},[472,1508,1155],{},[1030,1510,1511,1512,1514],{},"El veredicto: aceptado, algunos aceptados, rechazado por un hook, rechazado por el ",[472,1513,1386],{}," del destino, y cuánto tardaron los hooks.",[1015,1516,1517,1522],{},[1030,1518,1519],{},[472,1520,1521],{},"drop",[1030,1523,1524,1525,1528,1529,877],{},"El destino; en las listas ordenables, el movimiento, ",[472,1526,1527],{},"e.result"," y si se llamó a ",[472,1530,1531],{},"preventDefault()",[1015,1533,1534,1539],{},[1030,1535,1536],{},[472,1537,1538],{},"cancel",[1030,1540,1541,1542,1545,1546,1548],{},"Por qué: cancelado (Escape, ",[472,1543,1544],{},"cancel()","), rechazado por un hook o rechazado por el ",[472,1547,1386],{}," del destino.",[469,1550,1551,1552,1064,1555,1558,1559,1562,1563,1566],{},"También ",[472,1553,1554],{},"auto-scroll on",[472,1556,1557],{},"off",", los textos de ",[472,1560,1561],{},"announcement"," (ocultos por defecto) y, fuera de\nlos arrastres, ",[472,1564,1565],{},"animate"," (cambios de los ítems de una lista que no hizo ningún arrastre). Haz clic\nen una entrada para ver sus datos. Una pestaña que se abre más tarde recibe los arrastres hechos\nhasta entonces.",[489,1568,1570],{"id":1569},"debug-a-drop-step-by-step","Depurar un drop, paso a paso",[469,1572,1573],{},"Una tarjeta no entra en una columna. Con la pestaña abierta:",[1575,1576,1577,1586,1603,1624],"ol",{},[953,1578,1579,1582,1583,1585],{},[477,1580,1581],{},"Reprodúcelo"," a mano, o con ",[477,1584,1078],{}," para tener las manos libres para la pestaña.",[953,1587,1588,1591,1592,1595,1596,1599,1600,1602],{},[477,1589,1590],{},"Mira el mapa"," mientras la tarjeta está sobre la columna. Rojo significa que la lista\nrechaza la tarjeta: revisa su ",[472,1593,1594],{},"group"," (",[472,1597,1598],{},"put",") o el ",[472,1601,1386],{}," del destino. Azul significa que la\nacepta, y el problema viene después.",[953,1604,1605,1608,1609,1611,1612,1614,1615,1617,1618,1620,1621,1623],{},[477,1606,1607],{},"Lee el registro"," de ese arrastre. ",[472,1610,1155],{}," dice quién dijo que no — un hook, o el\n",[472,1613,1386],{}," del destino. Si el drop se completó pero tus datos no cambiaron, la entrada ",[472,1616,1521],{},"\ndice si se llamó a ",[472,1619,1531],{}," y qué contenía ",[472,1622,1527],{},": una lista controlada debe\naplicarlo ella misma.",[953,1625,1626,1629,1630,1632,1633,1635,1636,1638,1639,1641],{},[477,1627,1628],{},"Prueba un arreglo en vivo"," en ",[477,1631,1081],{}," — un ",[472,1634,1345],{}," más permisivo, otra ",[472,1637,1288],{},",\n",[472,1640,1119],{}," — y luego escribe en tu código el que funcione.",[489,1643,1645],{"id":1644},"how-it-works","Cómo funciona",[469,1647,1648,1649,1652],{},"Los providers informan a un hook que instala la parte de la página. Mientras ninguna pestaña\nobserva la página, solo se registran; después, la página escucha como cualquier monitor y envía a\nla pestaña lo que muestra — cada 40 ms durante un arrastre, dos veces por segundo el resto del\ntiempo — y se detiene cuando ninguna pestaña la ha observado durante unos segundos. La pestaña\nhabla con la página a través de un ",[472,1650,1651],{},"BroadcastChannel"," del origen de la página. No cambia nada más\nque lo que pides: los arrastres, la selección y las opciones sobrescritas.",[1654,1655,1656],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s78Kj, html code.shiki .s78Kj{--shiki-light:#1F8A5B;--shiki-default:#1F8A5B;--shiki-dark:#42B883}html pre.shiki code .s6cML, html code.shiki .s6cML{--shiki-light:#5B5B63;--shiki-default:#5B5B63;--shiki-dark:#9F9FA9}html pre.shiki code .snmWg, html code.shiki .snmWg{--shiki-light:#27272A;--shiki-default:#27272A;--shiki-dark:#E4E4E7}html pre.shiki code .sytrG, html code.shiki .sytrG{--shiki-light:#85858D;--shiki-light-font-style:italic;--shiki-default:#85858D;--shiki-default-font-style:italic;--shiki-dark:#6E6E78;--shiki-dark-font-style:italic}html pre.shiki code .sVvmN, html code.shiki .sVvmN{--shiki-light:#7C4DCC;--shiki-default:#7C4DCC;--shiki-dark:#C3A6FF}",{"title":503,"searchDepth":593,"depth":593,"links":1658},[1659,1665,1666,1667,1668,1669,1670,1671,1672,1673],{"id":491,"depth":577,"text":290,"children":1660},[1661,1662,1663,1664],{"id":495,"depth":593,"text":496},{"id":536,"depth":593,"text":537},{"id":763,"depth":593,"text":764},{"id":778,"depth":593,"text":779},{"id":947,"depth":577,"text":948},{"id":1006,"depth":577,"text":1007},{"id":1093,"depth":577,"text":1094},{"id":1125,"depth":577,"text":1126},{"id":1253,"depth":577,"text":1254},{"id":1408,"depth":577,"text":1409},{"id":1449,"depth":577,"text":1450},{"id":1569,"depth":577,"text":1570},{"id":1644,"depth":577,"text":1645},"Una pestaña de Vue DnD Kit en las Vue DevTools y las Nuxt DevTools — un minimapa en vivo, un joystick que arrastra de verdad, edición de opciones en vivo y un registro de cada arrastre.","md",null,{"source":1678},"6f7e373d0b",{"icon":116},{"title":113,"description":1674},"J2jvqW3EsZpzHe79HnchVOC8fSJjouLBOtR9v6w2UKg",[1683,1685],{"title":356,"path":357,"stem":358,"description":1684,"icon":111},"Cómo la entrada se convierte en un arrastre — los sensores de puntero y teclado, las restricciones de activación, canDrag, sensores propios y arrastres que programas con @vue-dnd-kit\u002Factions.",{"title":363,"path":364,"stem":365,"description":1686,"icon":121},"El arrastrar y soltar propio del navegador, como arrastres de la biblioteca — archivos, enlaces y texto de otras apps en destinos de drop y listas que les hacen sitio, ítems arrastrados fuera de la página, y entre ventanas de tu app.",1793588247100]
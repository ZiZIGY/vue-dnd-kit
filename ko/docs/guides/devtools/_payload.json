,1446,1447,1449,1450,1452],{},[506,1448,1344],{},": 순서와 초안. ",[506,1451,337],{},": 행",[977,1454,1455,1457,1458,1460],{},[506,1456,1417],{},": 타입, 데이터, 위치. ",[506,1459,1400],{},": 규칙",[494,1462,1463],{},"항목은 이벤트 없이 마운트되고 언마운트되므로, 레지스트리는 1초 안에 따라잡습니다.",[514,1465,1467],{"id":1466},"log","로그",[494,1469,1470],{},"드래그마다 띠 하나가 순서대로 표시됩니다.",[1034,1472,1473,1482],{},[1037,1474,1475],{},[1040,1476,1477,1479],{},[1043,1478,1417],{},[1043,1480,1481],{},"알려 주는 것",[1050,1483,1484,1494,1507,1519,1531,1548],{},[1040,1485,1486,1491],{},[1055,1487,1488],{},[497,1489,1490],{},"drag start",[1055,1492,1493],{},"id, 센서와 터치 여부, 출발한 리스트.",[1040,1495,1496,1504],{},[1055,1497,1498,796,1501],{},[497,1499,1500],{},"over",[497,1502,1503],{},"left",[1055,1505,1506],{},"들어가고 나온 각 대상과 그 수락 여부.",[1040,1508,1509,1514],{},[1055,1510,1511],{},[497,1512,1513],{},"release",[1055,1515,1516,1518],{},[497,1517,1180],{},"이 결정하는 동안, 놓은 위치의 대상.",[1040,1520,1521,1525],{},[1055,1522,1523],{},[497,1524,1180],{},[1055,1526,1527,1528,1530],{},"판정: 수락, 일부 수락, 훅에 의한 거부, 대상의 ",[497,1529,1410],{},"에 의한 거부, 그리고 훅에 걸린 시간.",[1040,1532,1533,1538],{},[1055,1534,1535],{},[497,1536,1537],{},"drop",[1055,1539,1540,1541,796,1544,1547],{},"대상. 정렬 가능한 리스트라면 이동, ",[497,1542,1543],{},"e.result",[497,1545,1546],{},"preventDefault()"," 호출 여부.",[1040,1549,1550,1555],{},[1055,1551,1552],{},[497,1553,1554],{},"cancel",[1055,1556,1557,1558,1561,1562,1564],{},"이유: 취소(Escape, ",[497,1559,1560],{},"cancel()","), 훅에 의한 거부, 대상의 ",[497,1563,1410],{},"에 의한 거부.",[494,1566,1567,1568,1085,1571,796,1574,1577,1578,1581],{},"그 밖에 ",[497,1569,1570],{},"auto-scroll on",[497,1572,1573],{},"off",[497,1575,1576],{},"announcement"," 문구(기본으로 숨김), 그리고 드래그 밖의\n",[497,1579,1580],{},"animate","(드래그가 아닌 리스트 항목 변경)도 있습니다. 항목을 클릭하면 데이터를 볼 수 있습니다. 나중에\n연 탭도 그때까지의 드래그를 받습니다.",[514,1583,1585],{"id":1584},"debug-a-drop-step-by-step","드롭 디버깅, 단계별로",[494,1587,1588],{},"카드가 컬럼에 들어가지 않습니다. 탭을 연 채로:",[1590,1591,1592,1601,1618,1640],"ol",{},[977,1593,1594,1595,1597,1598,901],{},"직접, 또는 손이 탭을 다룰 수 있도록 ",[506,1596,1099],{},"로 ",[506,1599,1600],{},"재현하세요",[977,1602,1603,1604,1607,1608,766,1611,1614,1615,1617],{},"카드가 컬럼 위에 있는 동안 ",[506,1605,1606],{},"맵을 보세요",". 빨간색이면 리스트가 카드를 거부하는 것이니 그\n리스트의 ",[497,1609,1610],{},"group",[497,1612,1613],{},"put",")이나 대상의 ",[497,1616,1410],{},"를 확인하세요. 파란색이면 받는 것이고, 문제는 그\n뒤에 있습니다.",[977,1619,1620,1621,1624,1625,1627,1628,1630,1631,1633,1634,1636,1637,1639],{},"그 드래그의 ",[506,1622,1623],{},"로그를 읽으세요",". ",[497,1626,1180],{},"이 누가 거부했는지 알려 줍니다. 훅인지, 대상의\n",[497,1629,1410],{},"인지. 드롭은 완료됐는데 데이터가 바뀌지 않았다면, ",[497,1632,1537],{}," 항목이 ",[497,1635,1546],{},"가\n호출되었는지와 ",[497,1638,1543],{},"에 무엇이 있었는지 알려 줍니다. 제어 리스트는 이를 직접 적용해야 합니다.",[977,1641,1642,1644,1645,1648,1649,1651,1652,1654,1655,1657],{},[506,1643,1102],{},"에서 ",[506,1646,1647],{},"수정을 실시간으로 시험하세요",". 더 느슨한 ",[497,1650,1370],{},", 다른 ",[497,1653,1313],{},",\n",[497,1656,1140],{}," 같은 것입니다. 그다음 효과가 있는 것을 코드에 반영하세요.",[514,1659,1661],{"id":1660},"how-it-works","동작 방식",[494,1663,1664,1665,1668],{},"프로바이더는 페이지 쪽이 설치한 훅에 보고합니다. 탭이 페이지를 지켜보기 전까지는 기록만 됩니다.\n그다음 페이지는 모니터처럼 듣고, 탭이 보여 주는 것을 보냅니다. 드래그 중에는 40 ms마다, 그 밖에는\n1초에 두 번 보내며, 몇 초 동안 지켜보는 탭이 없으면 멈춥니다. 탭은 페이지 출처의 ",[497,1666,1667],{},"BroadcastChannel","로\n페이지와 통신합니다. 요청한 것(드래그, 선택, 옵션 재정의) 말고는 아무것도 바꾸지 않습니다.",[1670,1671,1672],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}
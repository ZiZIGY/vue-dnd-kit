maxDepth",[1010,1367,1368,1371],{},[1025,1369,1370],{},"드롭 대상",[1025,1372,1373,766,1375,766,1378,766,1381],{},[467,1374,1319],{},[467,1376,1377],{},"priority",[467,1379,1380],{},"accept",[467,1382,1340],{},[1010,1384,1385,1388],{},[1025,1386,1387],{},"항목",[1025,1389,1390,766,1392,766,1394],{},[467,1391,1319],{},[467,1393,1302],{},[467,1395,1299],{},[464,1397,1398],{},"편집은 즉시, 이 페이지에만 적용되며 코드에는 절대 기록되지 않습니다. 라이브러리는 옵션을 읽는 곳에서\n새 값을 읽습니다. 편집은 초기화하거나(옵션별 ↺, 또는 상단 바의 초기화), 프로바이더가 언마운트되거나,\n페이지를 새로 고칠 때까지 유지됩니다. 편집한 옵션 옆에는 코드의 값이 표시됩니다. 편집이 적용된 동안\n마운트되는 항목(가상 리스트의 행)도 편집을 받습니다.",[484,1400,1402],{"id":1401},"state","상태",[464,1404,1405],{},"고른 노드에 대해 각 프로바이더가 아는 것:",[944,1407,1408,1414,1422],{},[947,1409,1410,1413],{},[476,1411,1412],{},"드래그 세션",": 상태, 활성 id, 항목, 센서, 대상과 그 수락 여부, 포인터, 오버레이, 정렬 그룹의\n세션과 삽입선",[947,1415,1416,1418,1419,1421],{},[476,1417,1314],{},": 순서와 초안. ",[476,1420,315],{},": 행",[947,1423,1424,1426,1427,1429],{},[476,1425,1387],{},": 타입, 데이터, 위치. ",[476,1428,1370],{},": 규칙",[464,1431,1432],{},"항목은 이벤트 없이 마운트되고 언마운트되므로, 레지스트리는 1초 안에 따라잡습니다.",[484,1434,1436],{"id":1435},"log","로그",[464,1438,1439],{},"드래그마다 띠 하나가 순서대로 표시됩니다.",[1004,1441,1442,1451],{},[1007,1443,1444],{},[1010,1445,1446,1448],{},[1013,1447,1387],{},[1013,1449,1450],{},"알려 주는 것",[1020,1452,1453,1463,1476,1488,1500,1517],{},[1010,1454,1455,1460],{},[1025,1456,1457],{},[467,1458,1459],{},"drag start",[1025,1461,1462],{},"id, 센서와 터치 여부, 출발한 리스트.",[1010,1464,1465,1473],{},[1025,1466,1467,766,1470],{},[467,1468,1469],{},"over",[467,1471,1472],{},"left",[1025,1474,1475],{},"들어가고 나온 각 대상과 그 수락 여부.",[1010,1477,1478,1483],{},[1025,1479,1480],{},[467,1481,1482],{},"release",[1025,1484,1485,1487],{},[467,1486,1150],{},"이 결정하는 동안, 놓은 위치의 대상.",[1010,1489,1490,1494],{},[1025,1491,1492],{},[467,1493,1150],{},[1025,1495,1496,1497,1499],{},"판정: 수락, 일부 수락, 훅에 의한 거부, 대상의 ",[467,1498,1380],{},"에 의한 거부, 그리고 훅에 걸린 시간.",[1010,1501,1502,1507],{},[1025,1503,1504],{},[467,1505,1506],{},"drop",[1025,1508,1509,1510,766,1513,1516],{},"대상. 정렬 가능한 리스트라면 이동, ",[467,1511,1512],{},"e.result",[467,1514,1515],{},"preventDefault()"," 호출 여부.",[1010,1518,1519,1524],{},[1025,1520,1521],{},[467,1522,1523],{},"cancel",[1025,1525,1526,1527,1530,1531,1533],{},"이유: 취소(Escape, ",[467,1528,1529],{},"cancel()","), 훅에 의한 거부, 대상의 ",[467,1532,1380],{},"에 의한 거부.",[464,1535,1536,1537,1055,1540,766,1543,1546,1547,1549],{},"그 밖에 ",[467,1538,1539],{},"auto-scroll on",[467,1541,1542],{},"off",[467,1544,1545],{},"announcement"," 문구(기본으로 숨김), 그리고 드래그 밖의\n",[467,1548,1296],{},"(드래그가 아닌 리스트 항목 변경)도 있습니다. 항목을 클릭하면 데이터를 볼 수 있습니다. 나중에\n연 탭도 그때까지의 드래그를 받습니다.",[484,1551,1553],{"id":1552},"debug-a-drop-step-by-step","드롭 디버깅, 단계별로",[464,1555,1556],{},"카드가 컬럼에 들어가지 않습니다. 탭을 연 채로:",[1558,1559,1560,1569,1586,1608],"ol",{},[947,1561,1562,1563,1565,1566,871],{},"직접, 또는 손이 탭을 다룰 수 있도록 ",[476,1564,1069],{},"로 ",[476,1567,1568],{},"재현하세요",[947,1570,1571,1572,1575,1576,736,1579,1582,1583,1585],{},"카드가 컬럼 위에 있는 동안 ",[476,1573,1574],{},"맵을 보세요",". 빨간색이면 리스트가 카드를 거부하는 것이니 그\n리스트의 ",[467,1577,1578],{},"group",[467,1580,1581],{},"put",")이나 대상의 ",[467,1584,1380],{},"를 확인하세요. 파란색이면 받는 것이고, 문제는 그\n뒤에 있습니다.",[947,1587,1588,1589,1592,1593,1595,1596,1598,1599,1601,1602,1604,1605,1607],{},"그 드래그의 ",[476,1590,1591],{},"로그를 읽으세요",". ",[467,1594,1150],{},"이 누가 거부했는지 알려 줍니다. 훅인지, 대상의\n",[467,1597,1380],{},"인지. 드롭은 완료됐는데 데이터가 바뀌지 않았다면, ",[467,1600,1506],{}," 항목이 ",[467,1603,1515],{},"가\n호출되었는지와 ",[467,1606,1512],{},"에 무엇이 있었는지 알려 줍니다. 제어 리스트는 이를 직접 적용해야 합니다.",[947,1609,1610,1612,1613,1616,1617,1619,1620,1622,1623,1625],{},[476,1611,1072],{},"에서 ",[476,1614,1615],{},"수정을 실시간으로 시험하세요",". 더 느슨한 ",[467,1618,1340],{},", 다른 ",[467,1621,1283],{},",\n",[467,1624,1110],{}," 같은 것입니다. 그다음 효과가 있는 것을 코드에 반영하세요.",[484,1627,1629],{"id":1628},"how-it-works","동작 방식",[464,1631,1632,1633,1636],{},"프로바이더는 페이지 쪽이 설치한 훅에 보고합니다. 탭이 페이지를 지켜보기 전까지는 기록만 됩니다.\n그다음 페이지는 모니터처럼 듣고, 탭이 보여 주는 것을 보냅니다. 드래그 중에는 40 ms마다, 그 밖에는\n1초에 두 번 보내며, 몇 초 동안 지켜보는 탭이 없으면 멈춥니다. 탭은 페이지 출처의 ",[467,1634,1635],{},"BroadcastChannel","로\n페이지와 통신합니다. 요청한 것(드래그, 선택, 옵션 재정의) 말고는 아무것도 바꾸지 않습니다.",[1638,1639,1640],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s78Kj, html code.shiki .s78Kj{--shiki-light:#1F8A5B;--shiki-default:#1F8A5B;--shiki-dark:#42B883}html pre.shiki code .s6cML, html code.shiki .s6cML{--shiki-light:#5B5B63;--shiki-default:#5B5B63;--shiki-dark:#9F9FA9}html pre.shiki code .snmWg, html code.shiki .snmWg{--shiki-
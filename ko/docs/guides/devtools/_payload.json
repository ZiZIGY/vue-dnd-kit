,{},"dropOutside",[476,1348,1349],{},"acceptMode",[476,1351,1299],{},[476,1353,1305],{},[476,1355,1289],{},[476,1357,1295],{},[1019,1359,1360,1362],{},[1034,1361,324],{},[1034,1363,1364,775,1366,775,1369,775,1372,1318],{},[476,1365,1334],{},[476,1367,1368],{},"indentation",[476,1370,1371],{},"nesting",[476,1373,1374],{},"maxDepth",[1019,1376,1377,1380],{},[1034,1378,1379],{},"드롭 대상",[1034,1381,1382,775,1384,775,1387,775,1390],{},[476,1383,1328],{},[476,1385,1386],{},"priority",[476,1388,1389],{},"accept",[476,1391,1349],{},[1019,1393,1394,1397],{},[1034,1395,1396],{},"항목",[1034,1398,1399,775,1401,775,1404],{},[476,1400,1328],{},[476,1402,1403],{},"keyboardMode",[476,1405,1308],{},[473,1407,1408],{},"편집은 즉시, 이 페이지에만 적용되며 코드에는 절대 기록되지 않습니다. 라이브러리는 옵션을 읽는 곳에서\n새 값을 읽습니다. 편집은 초기화하거나(옵션별 ↺, 또는 상단 바의 초기화), 프로바이더가 언마운트되거나,\n페이지를 새로 고칠 때까지 유지됩니다. 편집한 옵션 옆에는 코드의 값이 표시됩니다. 편집이 적용된 동안\n마운트되는 항목(가상 리스트의 행)도 편집을 받습니다.",[493,1410,1412],{"id":1411},"state","상태",[473,1414,1415],{},"고른 노드에 대해 각 프로바이더가 아는 것:",[953,1417,1418,1424,1432],{},[956,1419,1420,1423],{},[485,1421,1422],{},"드래그 세션",": 상태, 활성 id, 항목, 센서, 대상과 그 수락 여부, 포인터, 오버레이, 정렬 그룹의\n세션과 삽입선",[956,1425,1426,1428,1429,1431],{},[485,1427,1323],{},": 순서와 초안. ",[485,1430,324],{},": 행",[956,1433,1434,1436,1437,1439],{},[485,1435,1396],{},": 타입, 데이터, 위치. ",[485,1438,1379],{},": 규칙",[473,1441,1442],{},"항목은 이벤트 없이 마운트되고 언마운트되므로, 레지스트리는 1초 안에 따라잡습니다.",[493,1444,1446],{"id":1445},"log","로그",[473,1448,1449],{},"드래그마다 띠 하나가 순서대로 표시됩니다.",[1013,1451,1452,1461],{},[1016,1453,1454],{},[1019,1455,1456,1458],{},[1022,1457,1396],{},[1022,1459,1460],{},"알려 주는 것",[1029,1462,1463,1473,1486,1498,1510,1527],{},[1019,1464,1465,1470],{},[1034,1466,1467],{},[476,1468,1469],{},"drag start",[1034,1471,1472],{},"id, 센서와 터치 여부, 출발한 리스트.",[1019,1474,1475,1483],{},[1034,1476,1477,775,1480],{},[476,1478,1479],{},"over",[476,1481,1482],{},"left",[1034,1484,1485],{},"들어가고 나온 각 대상과 그 수락 여부.",[1019,1487,1488,1493],{},[1034,1489,1490],{},[476,1491,1492],{},"releas
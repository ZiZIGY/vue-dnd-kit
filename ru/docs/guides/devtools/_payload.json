866],{"class":560},[510,887,888],{"class":564},"DnDDevtools",[510,890,891],{"class":560},");",[510,893,894],{"class":655}," \u002F\u002F before mount: providers set up earlier aren't seen\n",[510,896,897,899,901,904,906,909],{"class":512,"line":652},[510,898,877],{"class":516},[510,900,880],{"class":560},[510,902,903],{"class":516},"mount",[510,905,866],{"class":560},[510,907,908],{"class":520},"'#app'",[510,910,872],{"class":560},[472,912,913,914,917,918,921,922,925,926,929],{},"Или импортируйте ",[475,915,916],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," первым во входном файле. Используйте\n",[475,919,920],{},"vueDnDKitDevtools({ inject: false })",", когда плагин должен раздавать вкладку, а сторону\nстраницы вы устанавливаете сами; ",[475,923,924],{},"serveTab()"," из ",[475,927,928],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," — middleware,\nкоторое раздаёт вкладку.",[931,932,933],"note",{},[472,934,935,936,939,940,943,944,947],{},"В продакшен-сборке ",[475,937,938],{},"app.use(DnDDevtools)"," и импорт ",[475,941,942],{},"auto"," сжимаются почти в ничто: каждая точка\nвхода сначала проверяет ",[475,945,946],{},"process.env.NODE_ENV",", а бандлеры выбрасывают остальное. На сервере они\nничего не делают.",[492,949,951],{"id":950},"open-it","Как открыть",[953,954,955,976,991],"ul",{},[956,957,958,961,962,966,967,966,970,973,974,880],"li",{},[480,959,960],{},"Vue DevTools",": ",[963,964],"kbd",{"value":965},"Alt"," + ",[963,968],{"value":969},"Shift",[963,971],{"value":972},"D"," или кнопка Vue\nвнизу страницы, затем вкладка ",[480,975,482],{},[956,977,978,961,981,966,983,966,985,987,988,990],{},[480,979,980],{},"Nuxt DevTools",[963,982],{"value":965},[963,984],{"value":969},[963,986],{"value":972}," или кнопка Nuxt,\nзатем ",[480,989,482],{}," (в боковой панели или в её меню переполнения).",[956,992,993,996,997,1000],{},[480,994,995],{},"Отдельное окно",": откройте ",[475,998,999],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," на своём\ndev-сервере или нажмите кнопку ⧉ вкладки. Удобно на втором экране. Если открыто несколько\nстраниц, селект сверху выбирает, за какой следить.",[1002,1003,1004],"warning",{},[472,1005,1006],{},"Держите вкладку в отдельном окне, а не в фоновой вкладке браузера того же окна: страница должна\nоставаться видимой, а скрытая страница отменяет драги.",[492,1008,1010],{"id":1009},"the-tab-at-a-glance","Вкладка вкратце",[1012,1013,1014,1027],"table",{},[1015,1016,1017],"thead",{},[1018,1019,1020,1024],"tr",{},[1021,1022,1023],"th",{},"Часть",[1021,1025,1026],{},"Что в ней",[1028,1029,1030,1047,1059,1074],"tbody",{},[1018,1031,1032,1036],{},[1033,1034,1035],"td",{},"Верхняя панель",[1033,1037,1038,1039,1042,1043,1046],{},"Что драг делает прямо сейчас (",[475,1040,1041],{},"dragging card-3 → done (accepts)","), отслеживаемая страница, ",[480,1044,1045],{},"⌖ Pick",", число изменённых опций со сбросом, ⧉ (отдельное окно) и тема.",[1018,1048,1049,1052],{},[1033,1050,1051],{},"Слева: реестр",[1033,1053,1054,1055,1058],{},"Каждый провайдер в виде дерева: его списки, деревья, цели и перетаскиваемые элементы. ",[480,1056,1057],{},"☰"," показывает или скрывает его.",[1018,1060,1061,1071],{},[1033,1062,1063,1064,1067,1068],{},"В центре: ",[480,1065,1066],{},"Map"," и ",[480,1069,1070],{},"Log",[1033,1072,1073],{},"Живая мини-карта страницы или журнал драгов.",[1018,1075,1076,1088],{},[1033,1077,1078,1079,774,1082,774,1085],{},"Справа: ",[480,1080,1081],{},"Drive",[480,1083,1084],{},"Options",[480,1086,1087],{},"State",[1033,1089,1090],{},"Джойстик и кнопки перемещения, опции выбранного узла и то, что о нём знает провайдер.",[472,1092,1093],{},"Выберите узел в реестре или элемент на карте, и правая часть следует за ним.",[492,1095,1097],{"id":1096},"the-mini-map","Мини-карта",[472,1099,1100],{},"Живая карточка на каждый список, дерево и цель, с копиями их элементов там, где они есть, — те же\nклоны, которые показал бы оверлей, со стилями страницы. Во время драга она отмечает:",[953,1102,1103,1114,1117],{},[956,1104,1105,1106,1109,1110,1113],{},"списки и цели, которые ",[480,1107,1108],{},"принимают"," драг (синие) или ",[480,1111,1112],{},"отклоняют"," его (красные);",[956,1115,1116],{},"плейсхолдер и цель под указателем;",[956,1118,1119,1120,880],{},"указатель, блок оверлея и линию вставки списков с ",[475,1121,1122],{},"placeholder: 'indicator'",[472,1124,1125],{},"Клик выбирает элемент и подсвечивает его на странице; двойной клик прокручивает к нему страницу.\nПользуйтесь картой, когда бросок попадает не туда, куда вы ждёте: она сразу показывает, какие\nсписки принимают драг.",[492,1127,1129],{"id":1128},"drive-the-joystick","Drive: джойстик",[472,1131,1132,1133,1135,1136,1067,1139,1142],{},"Выберите элемент — на карте, в реестре или через ",[480,1134,1045],{},", который перехватывает следующее\nнажатие на перетаскиваемый элемент страницы, не давая ему сработать, — и толкните рукоятку\nджойстика. Элемент берётся и движется в ту сторону, тем быстрее, чем дальше рукоятка от центра.\nОтпустите — и он остановится; ",[480,1137,1138],{},"Drop",[480,1140,1141],{},"Cancel"," завершают драг.",[472,1144,1145,1146,1149,1150,1155,1156,1067,1159,1162],{},"Это настоящий драг указателем от сенсора по имени ",[475,1147,1148],{},"devtools",", сделанный на публичном\n",[1151,1152,1154],"a",{"href":1153},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API сенсоров",": списки сортируются под ним, контейнеры\nпрокручиваются у краёв, а ",[475,1157,1158],{},"onBeforeDrop",[475,1160,1161],{},"onDrop"," выполняются, как для любого драга.\nОтключённые элементы не берутся. Перетаскиванием с клавиатуры, начатым на странице, тоже можно\nуправлять.",[472,1164,1165,1166,1172],{},"Элементы сортируемых списков получают ещё и кнопки: вверх, вниз, в начало, в конец, в другой\nсписок группы. Каждая — одно перетаскивание с клавиатуры через\n",[1151,1167,1169],{"href":1168},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[475,1170,1171],{},"moveItem",". Под джойстиком — крупная копия того, что\nпоказывает оверлей.",[1012,1174,1175,1185],{},[1015,1176,1177],{},[1018,1178,1179,1182],{},[1021,1180,1181],{},"Клавиша во вкладке",[1021,1183,1184],{},"Действие",[1028,1186,1187,1210,1220,1234,1244],{},[1018,1188,1189,1204],{},[1033,1190,1191,1192,1195,1196,1195,1199,1195,1202],{},"Стрелки или ",[963,1193],{"value":1194},"W"," ",[963,1197],{"value":1198},"A",[963,1200],{"value":1201},"S",[963,1203],{"value":972},[1033,1205,1206,1207,1209],{},"Толкнуть рукоятку в ту сторону, наполовину; с ",[963,1208],{"value":969}," — до упора",[1018,1211,1212,1217],{},[1033,1213,1214],{},[963,1215],{"value":1216},"G",[1033,1218,1219],{},"Взять выбранный элемент",[1018,1221,1222,1231],{},[1033,1223,1224,1227,1228],{},[963,1225],{"value":1226},"Space"," \u002F ",[963,1229],{"value":1230},"Enter",[1033,1232,1233],{},"Бросить",[1018,1235,1236,1241],{},[1033,1237,1238],{},[963,1239],{"value":1240},"Escape",[1033,1242,1243],{},"Отменить",[1018,1245,1246,1251],{},[1033,1247,1248],{},[963,1249],{"value":1250},"P",[1033,1252,1253],{},"Выбрать на странице",[492,1255,1084],{"id":1256},"options",[472,1258,1259,1260,666],{},"Каждую опцию, которая не является колбэком, можно править, пока приложение работает. Выберите\nузел и откройте ",[480,1261,1084],{},[1012,1263,1264,1274],{},[1015,1265,1266],{},[1018,1267,1268,1271],{},[1021,1269,1270],{},"Узел",[1021,1272,1273],{},"Опции",[1028,1275,1276,1317,1356,1374,1391],{},[1018,1277,1278,1280],{},[1033,1279,308],{},[1033,1281,1282,774,1285,774,1288,774,1291,1294,1295,774,1298,774,1301,774,1304,774,1307,774,1310,774,1313,1316],{},[475,1283,1284],{},"overlayFit",[475,1286,1287],{},"autoScroll",[475,1289,1290],{},"collision",[475,1292,1293],{},"modifiers"," (библиотечные, по имени), ",[475,1296,1297],{},"animation",[475,1299,1300],{},"dropAnimation",[475,1302,1303],{},"animateChanges",[475,1305,1306],{},"activation",[475,1308,1309],{},"keyboard",[475,1311,1312],{},"haptics",[475,1314,1315],{},"copyModifier","…",[1018,1318,1319,1322],{},[1033,1320,1321],{},"Список",[1033,1323,1324,774,1327,774,1330,774,1333,774,1336,774,1339,774,1342,774,1345,774,1348,774,1350,774,1352,774,1354],{},[475,1325,1326],{},"disabled",[475,1328,1329],{},"strategy",[475,1331,1332],{},"placeholder",[475,1334,1335],{},"behavior",[475,1337,1338],{},"multiple",[475,1340,1341],{},"sort",[475,1343,1344],{},"dropOutside",[475,1346,1347],{},"acceptMode",[475,1349,1297],{},[475,1351,1303],{},[475,1353,1287],{},[475,1355,1293],{},[1018,1357,1358,1361],{},[1033,1359,1360],{},"Дерево",[1033,1362,1363,774,1365,774,1368,774,1371,1316],{},[475,1364,1332],{},[475,1366,1367],{},"indentation",[475,1369,1370],{},"nesting",[475,1372,1373],{},"maxDepth",[1018,1375,1376,1379],{},[1033,1377,1378],{},"Цель",[1033,1380,1381,774,1383,774,1386,774,1389],{},[475,1382,1326],{},[475,1384,1385],{},"priority",[475,1387,1388],{},"accept",[475,1390,1347],{},[1018,1392,1393,1396],{},[1033,1394,1395],{},"Элемент",[1033,1397,1398,774,1400,774,1403],{},[475,1399,1326],{},[475,1401,1402],{},"keyboardMode",[475,1404,1306],{},[472,1406,1407],{},"Правка применяется сразу, только к этой странице, и никогда не записывается в ваш код: библиотека\nчитает новое значение там, где читает опцию. Она действует, пока вы её не сбросите (↺ у каждой\nопции или сброс на верхней панели), пока провайдер не размонтируется или страница не\nперезагрузится. Рядом с изменённой опцией показано значение из вашего кода. Элементы,\nсмонтированные, пока правка задана, — строки виртуального списка — тоже её получают.",[492,1409,1087],{"id":1410},"state",[472,1412,1413],{},"Что знает каждый провайдер о выбранном узле:",[953,1415,1416,1422,1432],{},[956,1417,1418,1421],{},[480,1419,1420],{},"сессия драга",": статус, активные id, элементы и сенсор, цель и принимает ли она, указатель,\nоверлей, сессия сортируемой группы и линия вставки;",[956,1423,1424,1427,1428,1431],{},[480,1425,1426],{},"список",": его порядок и черновик; ",[480,1429,1430],{},"дерево",": его строки;",[956,1433,1434,1437,1438,1441],{},[480,1435,1436],{},"элемент",": его тип, данные и позиция; ",[480,1439,1440],{},"цель",": её правила.",[472,1443,1444],{},"Элементы монтируются и размонтируются без событий: реестр догоняет их в течение секунды.",[492,1446,1070],{"id":1447},"log",[472,1449,1450],{},"Одна полоса на драг, по порядку:",[1012,1452,1453,1463],{},[1015,1454,1455],{},[1018,1456,1457,1460],{},[1021,1458,1459],{},"Запись",[1021,1461,1462],{},"Что сообщает",[1028,1464,1465,1475,1488,1500,1512,1529],{},[1018,1466,1467,1472],{},[1033,1468,1469],{},[475,1470,1471],{},"drag start",[1033,1473,1474],{},"Id, сенсор и было ли это касание, список, из которого пришёл элемент.",[1018,1476,1477,1485],{},[1033,1478,1479,774,1482],{},[475,1480,1481],{},"over",[475,1483,1484],{},"left",[1033,1486,1487],{},"Каждую цель, в которую вошёл и из которой вышел драг, и принимает ли она его.",[1018,1489,1490,1495],{},[1033,1491,1492],{},[475,1493,1494],{},"release",[1033,1496,1497,1498,880],{},"Цель, над которой драг отпущен, пока решает ",[475,1499,1158],{},[1018,1501,1502,1506],{},[1033,1503,1504],{},[475,1505,1158],{},[1033,1507,1508,1509,1511],{},"Вердикт: принято, принято частично, отклонено хуком, отклонено ",[475,1510,1388],{}," цели, и сколько заняли хуки.",[1018,1513,1514,1519],{},[1033,1515,1516],{},[475,1517,1518],{},"drop",[1033,1520,1521,1522,1525,1526,880],{},"Цель; для сортируемых списков — перемещение, ",[475,1523,1524],{},"e.result"," и был ли вызван ",[475,1527,1528],{},"preventDefault()",[1018,1530,1531,1536],{},[1033,1532,1533],{},[475,1534,1535],{},"cancel",[1033,1537,1538,1539,1542,1543,1545],{},"Причина: отменено (Escape, ",[475,1540,1541],{},"cancel()","), отклонено хуком или отклонено ",[475,1544,1388],{}," цели.",[472,1547,1548,1549,1067,1552,1555,1556,1559,1560,1563],{},"А также ",[475,1550,1551],{},"auto-scroll on",[475,1553,1554],{},"off",", тексты ",[475,1557,1558],{},"announcement"," (по умолчанию скрыты) и, вне драгов,\n",[475,1561,1562],{},"animate"," (изменения элементов списка, сделанные не драгом). Кликните по записи, чтобы увидеть её\nданные. Вкладка, открытая позже, получает уже прошедшие драги.",[492,1565,1567],{"id":1566},"debug-a-drop-step-by-step","Отладка броска по шагам",[472,1569,1570],{},"Карточка не попадает в колонку. С открытой вкладкой:",[1572,1573,1574,1583,1600,1621],"ol",{},[956,1575,1576,1579,1580,1582],{},[480,1577,1578],{},"Воспроизведите"," это руками или через ",[480,1581,1081],{},", чтобы руки оставались свободными для\nвкладки.",[956,1584,1585,1588,1589,1592,1593,1596,1597,1599],{},[480,1586,1587],{},"Следите за картой",", пока карточка над колонкой. Красный значит, что список отклоняет\nкарточку: смотрите его ",[475,1590,1591],{},"group"," (",[475,1594,1595],{},"put",") или ",[475,1598,1388],{}," цели. Синий значит, что он принимает, и\nпроблема возникает позже.",[956,1601,1602,1605,1606,1608,1609,1611,1612,1614,1615,1617,1618,1620],{},[480,1603,1604],{},"Прочитайте журнал"," этого драга. ",[475,1607,1158],{}," говорит, кто сказал «нет», — хук или\n",[475,1610,1388],{}," цели. Если бросок прошёл, а ваши данные не изменились, запись ",[475,1613,1518],{}," говорит, был ли\nвызван ",[475,1616,1528],{}," и что было в ",[475,1619,1524],{},": управляемый список должен применять его сам.",[956,1622,1623,1626,1627,1629,1630,1632,1633,774,1635,1637],{},[480,1624,1625],{},"Попробуйте исправление вживую"," в ",[480,1628,1084],{}," — более мягкий ",[475,1631,1347],{},", другой\n",[475,1634,1290],{},[475,1636,1122],{},", — а затем перенесите то, что сработало, в свой код.",[492,1639,1641],{"id":1640},"how-it-works","Как это работает",[472,1643,1644,1645,1648],{},"Провайдеры сообщают о себе хуку, который устанавливает сторона страницы. Пока за страницей не\nследит вкладка, они только записываются; затем страница слушает, как любой монитор, и отправляет\nвкладке то, что та показывает, — каждые 40 ms во время драга, дважды в секунду в остальное время,\n— и останавливается, когда несколько секунд за ней не следит ни одна вкладка. Вкладка общается со\nстраницей через ",[475,1646,1647],{},"BroadcastChannel"," origin страницы. Она не меняет ничего, кроме того, о чём вы\nпросите: драгов, выделения и переопределений опций.",[1650,1651,1652],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s78Kj, html code.shiki .s78Kj{--shiki-light:#1F8A5B;--shiki-default:#1F8A5B;--shiki-dark:#42B883}html pre.shiki code .s6cML, html code.shiki .s6cML{--shik
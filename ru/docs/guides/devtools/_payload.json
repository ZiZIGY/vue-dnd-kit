1,893,894],{"class":507},"mount",[501,896,857],{"class":551},[501,898,899],{"class":511},"'#app'",[501,901,863],{"class":551},[463,903,904,905,908,909,912,913,916,917,920],{},"Или импортируйте ",[466,906,907],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," первым во входном файле. Используйте\n",[466,910,911],{},"vueDnDKitDevtools({ inject: false })",", когда плагин должен раздавать вкладку, а сторону\nстраницы вы устанавливаете сами; ",[466,914,915],{},"serveTab()"," из ",[466,918,919],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," — middleware,\nкоторое раздаёт вкладку.",[922,923,924],"note",{},[463,925,926,927,930,931,934,935,938],{},"В продакшен-сборке ",[466,928,929],{},"app.use(DnDDevtools)"," и импорт ",[466,932,933],{},"auto"," сжимаются почти в ничто: каждая точка\nвхода сначала проверяет ",[466,936,937],{},"process.env.NODE_ENV",", а бандлеры выбрасывают остальное. На сервере они\nничего не делают.",[483,940,942],{"id":941},"open-it","Как открыть",[944,945,946,967,982],"ul",{},[947,948,949,952,953,957,958,957,961,964,965,871],"li",{},[471,950,951],{},"Vue DevTools",": ",[954,955],"kbd",{"value":956},"Alt"," + ",[954,959],{"value":960},"Shift",[954,962],{"value":963},"D"," или кнопка Vue\nвнизу страницы, затем вкладка ",[471,966,473],{},[947,968,969,952,972,957,974,957,976,978,979,981],{},[471,970,971],{},"Nuxt DevTools",[954,973],{"value":956},[954,975],{"value":960},[954,977],{"value":963}," или кнопка Nuxt,\nзатем ",[471,980,473],{}," (в боковой панели или в её меню переполнения).",[947,983,984,987,988,991],{},[471,985,986],{},"Отдельное окно",": откройте ",[466,989,990],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," на своём\ndev-сервере или нажмите кнопку ⧉ вкладки. Удобно на втором экране. Если открыто несколько\nстраниц, селект сверху выбирает, за какой следить.",[993,994,995],"warning",{},[463,996,997],{},"Держите вкладку в отдельном окне, а не в фоновой вкладке браузера того же окна: страница должна\nоставаться видимой, а скрытая страница отменяет драги.",[483,999,1001],{"id":1000},"the-tab-at-a-glance","Вкладка вкратце",[1003,1004,1005,1018],"table",{},[1006,1007,1008],"thead",{},[1009,1010,1011,1015],"tr",{},[1012,1013,1014],"th",{},"Часть",[1012,1016,1017],{},"Что в ней",[1019,1020,1021,1038,1050,1065],"tbody",{},[1009,1022,1023,1027],{},[1024,1025,1026],"td",{},"Верхняя панель",[1024,1028,1029,1030,1033,1034,1037],{},"Что драг делает прямо сейчас (",[466,1031,1032],{},"dragging card-3 → done (accepts)","), отслеживаемая страница, ",[471,1035,1036],{},"⌖ Pick",", число изменённых опций со сбросом, ⧉ (отдельное окно) и тема.",[1009,1039,1040,1043],{},[1024,1041,1042],{},"Слева: реестр",[1024,1044,1045,1046,1049],{},"Каждый провайдер в виде дерева: его списки, деревья, цели и перетаскиваемые элементы. ",[471,1047,1048],{},"☰"," показывает или скрывает его.",[1009,1051,1052,1062],{},[1024,1053,1054,1055,1058,1059],{},"В центре: ",[471,1056,1057],{},"Map"," и ",[471,1060,1061],{},"Log",[1024,1063,1064],{},"Живая мини-карта страницы или журнал драгов.",[1009,1066,1067,1079],{},[1024,1068,1069,1070,765,1073,765,1076],{},"Справа: ",[471,1071,1072],{},"Drive",[471,1074,1075],{},"Options",[471,1077,1078],{},"State",[1024,1080,1081],{},"Джойстик и кнопки перемещения, опции выбранного узла и то, что о нём знает провайдер.",[463,1083,1084],{},"Выберите узел в реестре или элемент на карте, и правая часть следует за ним.",[483,1086,1088],{"id":1087},"the-mini-map","Мини-карта",[463,1090,1091],{},"Живая карточка на каждый список, дерево и цель, с копиями их элементов там, где они есть, — те же\nклоны, которые показал бы оверлей, со стилями страницы. Во время драга она отмечает:",[944,1093,1094,1105,1108],{},[947,1095,1096,1097,1100,1101,1104],{},"списки и цели, которые ",[471,1098,1099],{},"принимают"," драг (синие) или ",[471,1102,1103],{},"отклоняют"," его (красные);",[947,1106,1107],{},"плейсхолдер и цель под указателем;",[947,1109,1110,1111,871],{},"указатель, блок оверлея и линию вставки списков с ",[466,1112,1113],{},"placeholder: 'indicator'",[463,1115,1116],{},"Клик выбирает элемент и подсвечивает его на странице; двойной клик прокручивает к нему страницу.\nПользуйтесь картой, когда бросок попадает не туда, куда вы ждёте: она сразу показывает, какие\nсписки принимают драг.",[483,1118,1120],{"id":1119},"drive-the-joystick","Drive: джойстик",[463,1122,1123,1124,1126,1127,1058,1130,1133],{},"Выберите элемент — на карте, в реестре или через ",[471,1125,1036],{},", который перехватывает следующее\nнажатие на перетаскиваемый элемент страницы, не давая ему сработать, — и толкните рукоятку\nджойстика. Элемент берётся и движется в ту сторону, тем быстрее, чем дальше рукоятка от центра.\nОтпустите — и он остановится; ",[471,1128,1129],{},"Drop",[471,1131,1132],{},"Cancel"," завершают драг.",[463,1135,1136,1137,1140,1141,1146,1147,1058,1150,1153],{},"Это настоящий драг указателем от сенсора по имени ",[466,1138,1139],{},"devtools",", сделанный на публичном\n",[1142,1143,1145],"a",{"href":1144},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API сенсоров",": списки сортируются под ним, контейнеры\nпрокручиваются у краёв, а ",[466,1148,1149],{},"onBeforeDrop",[466,1151,1152],{},"onDrop"," выполняются, как для любого драга.\nОтключённые элементы не берутся. Перетаскиванием с клавиатуры, начатым на странице, тоже можно\nуправлять.",[463,1155,1156,1157,1163],{},"Элементы сортируемых списков получают ещё и кнопки: вверх, вниз, в начало, в конец, в другой\nсписок группы. Каждая — одно перетаскивание с клавиатуры через\n",[1142,1158,1160],{"href":1159},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[466,1161,1162],{},"moveItem",". Под джойстиком — крупная копия того, что\nпоказывает оверлей.",[1003,1165,1166,1176],{},[1006,1167,1168],{},[1009,1169,1170,1173],{},[1012,1171,1172],{},"Клавиша во вкладке",[1012,1174,1175],{},"Действие",[1019,1177,1178,1201,1211,1225,1235],{},[1009,1179,1180,1195],{},[1024,1181,1182,1183,1186,1187,1186,1190,1186,1193],{},"Стрелки или ",[954,1184],{"value":1185},"W"," ",[954,1188],{"value":1189},"A",[954,1191],{"value":1192},"S",[954,1194],{"value":963},[1024,1196,1197,1198,1200],{},"Толкнуть рукоятку в ту сторону, наполовину; с ",[954,1199],{"value":960}," — до упора",[1009,1202,1203,1208],{},[1024,1204,1205],{},[954,1206],{"value":1207},"G",[1024,1209,1210],{},"Взять выбранный элемент",[1009,1212,1213,1222],{},[1024,1214,1215,1218,1219],{},[954,1216],{"value":1217},"Space"," \u002F ",[954,1220],{"value":1221},"Enter",[1024,1223,1224],{},"Бросить",[1009,1226,1227,1232],{},[1024,1228,1229],{},[954,1230],{"value":1231},"Escape",[1024,1233,1234],{},"Отменить",[1009,1236,1237,1242],{},[1024,1238,1239],{},[954,1240],{"value":1241},"P",[1024,1243,1244],{},"Выбрать на странице",[483,1246,1075],{"id":1247},"options",[463,1249,1250,1251,657],{},"Каждую опцию, которая не является колбэком, можно править, пока приложение работает. Выберите\nузел и откройте ",[471,1252,1075],{},[1003,1254,1255,1265],{},[1006,1256,1257],{},[1009,1258,1259,1262],{},[1012,1260,1261],{},"Узел",[1012,1263,1264],{},"Опции",[1019,1266,1267,1308,1347,1365,1382],{},[1009,1268,1269,1271],{},[1024,1270,299],{},[1024,1272,1273,765,1276,765,1279,765,1282,1285,1286,765,1289,765,1292,765,1295,765,1298,765,1301,765,1304,1307],{},[466,1274,1275],{},"overlayFit",[466,1277,1278],{},"autoScroll",[466,1280,1281],{},"collision",[466,1283,1284],{},"modifiers"," (библиотечные, по имени), ",[466,1287,1288],{},"animation",[466,1290,1291],{},"dropAnimation",[466,1293,1294],{},"animate",[466,1296,1297],{},"activation",[466,1299,1300],{},"keyboard",[466,1302,1303],{},"haptics",[466,1305,1306],{},"copyModifier","…",[1009,1309,1310,1313],{},[1024,1311,1312],{},"Список",[1024,1314,1315,765,1318,765,1321,765,1324,765,1327,765,1330,765,1333,765,1336,765,1339,765,1341,765,1343,765,1345],{},[466,1316,1317],{},"disabled",[466,1319,1320],{},"strategy",[466,1322,1323],{},"placeholder",[466,1325,1326],{},"behavior",[466,1328,1329],{},"multiple",[466,1331,1332],{},"sort",[466,1334,1335],{},"dropOutside",[466,1337,1338],{},"acceptMode",[466,1340,1288],{},[466,1342,1294],{},[466,1344,1278],{},[466,1346,1284],{},[1009,1348,1349,1352],{},[1024,1350,1351],{},"Дерево",[1024,1353,1354,765,1356,765,1359,765,1362,1307],{},[466,1355,1323],{},[466,1357,1358],{},"indentation",[466,1360,1361],{},"nesting",[466,1363,1364],{},"maxDepth",[1009,1366,1367,1370],{},[1024,1368,1369],{},"Цель",[1024,1371,1372,765,1374,765,1377,765,1380],{},[466,1373,1317],{},[466,1375,1376],{},"priority",[466,1378,1379],{},"accept",[466,1381,1338],{},[1009,1383,1384,1387],{},[1024,1385,1386],{},"Элемент",[1024,1388,1389,765,1391,765,1393],{},[466,1390,1317],{},[466,1392,1300],{},[466,1394,1297],{},[463,1396,1397],{},"Правка применяется сразу, только к этой странице, и никогда не записывается в ваш код: библиотека\nчитает новое значение там, где читает опцию. Она действует, пока вы её не сбросите (↺ у каждой\nопции или сброс на верхней панели), пока провайдер не размонтируется или страница не\nперезагрузится. Рядом с изменённой опцией показано значение из вашего кода. Элементы,\nсмонтированные, пока правка задана, — строки виртуального списка — тоже её получают.",[483,1399,1078],{"id":1400},"state",[463,1402,1403],{},"Что знает каждый провайдер о выбранном узле:",[944,1405,1406,1412,1422],{},[947,1407,1408,1411],{},[471,1409,1410],{},"сессия драга",": статус, активные id, элементы и сенсор, цель и принимает ли она, указатель,\nоверлей, сессия сортируемой группы и линия вставки;",[947,1413,1414,1417,1418,1421],{},[471,1415,1416],{},"список",": его порядок и черновик; ",[471,1419,1420],{},"дерево",": его строки;",[947,1423,1424,1427,1428,1431],{},[471,1425,1426],{},"элемент",": его тип, данные и позиция; ",[471,1429,1430],{},"цель",": её правила.",[463,1433,1434],{},"Элементы монтируются и размонтируются без событий: реестр догоняет их в течение секунды.",[483,1436,1061],{"id":1437},"log",[463,1439,1440],{},"Одна полоса на драг, по порядку:",[1003,1442,1443,1453],{},[1006,1444,1445],{},[1009,1446,1447,1450],{},[1012,1448,1449],{},"Запись",[1012,1451,1452],{},"Что сообщает",[1019,1454,1455,1465,1478,1490,1502,1519],{},[1009,1456,1457,1462],{},[1024,1458,1459],{},[466,1460,1461],{},"drag start",[1024,1463,1464],{},"Id, сенсор и было ли это касание, список, из которого пришёл элемент.",[1009,1466,1467,1475],{},[1024,1468,1469,765,1472],{},[466,1470,1471],{},"over",[466,1473,1474],{},"left",[1024,1476,1477],{},"Каждую цель, в которую вошёл и из которой вышел драг, и принимает ли она его.",[1009,1479,1480,1485],{},[1024,1481,1482],{},[466,1483,1484],{},"release",[1024,1486,1487,1488,871],{},"Цель, над которой драг отпущен, пока решает ",[466,1489,1149],{},[1009,1491,1492,1496],{},[1024,1493,1494],{},[466,1495,1149],{},[1024,1497,1498,1499,1501],{},"Вердикт: принято, принято частично, отклонено хуком, отклонено ",[466,1500,1379],{}," цели, и сколько заняли хуки.",[1009,1503,1504,1509],{},[1024,1505,1506],{},[466,1507,1508],{},"drop",[1024,1510,1511,1512,1515,1516,871],{},"Цель; для сортируемых списков — перемещение, ",[466,1513,1514],{},"e.result"," и был ли вызван ",[466,1517,1518],{},"preventDefault()",[1009,1520,1521,1526],{},[1024,1522,1523],{},[466,1524,1525],{},"cancel",[1024,1527,1528,1529,1532,1533,1535],{},"Причина: отменено (Escape, ",[466,1530,1531],{},"cancel()","), отклонено хуком или отклонено ",[466,1534,1379],{}," цели.",[463,1537,1538,1539,1058,1542,1545,1546,1549,1550,1552],{},"А также ",[466,1540,1541],{},"auto-scroll on",[466,1543,1544],{},"off",", тексты ",[466,1547,1548],{},"announcement"," (по умолчанию скрыты) и, вне драгов,\n",[466,1551,1294],{}," (изменения элементов списка, сделанные не драгом). Кликните по записи, чтобы увидеть её\nданные. Вкладка, открытая позже, получает уже прошедшие драги.",[483,1554,1556],{"id":1555},"debug-a-drop-step-by-step","Отладка броска по шагам",[463,1558,1559],{},"Карточка не попадает в колонку. С открытой вкладкой:",[1561,1562,1563,1572,1589,1610],"ol",{},[947,1564,1565,1568,1569,1571],{},[471,1566,1567],{},"Воспроизведите"," это руками или через ",[471,1570,1072],{},", чтобы руки оставались свободными для\nвкладки.",[947,1573,1574,1577,1578,1581,1582,1585,1586,1588],{},[471,1575,1576],{},"Следите за картой",", пока карточка над колонкой. Красный значит, что список отклоняет\nкарточку: смотрите его ",[466,1579,1580],{},"group"," (",[466,1583,1584],{},"put",") или ",[466,1587,1379],{}," цели. Синий значит, что он принимает, и\nпроблема возникает позже.",[947,1590,1591,1594,1595,1597,1598,1600,1601,1603,1604,1606,1607,1609],{},[471,1592,1593],{},"Прочитайте журнал"," этого драга. ",[466,1596,1149],{}," говорит, кто сказал «нет», — хук или\n",[466,1599,1379],{}," цели. Если бросок прошёл, а ваши данные не изменились, запись ",[466,1602,1508],{}," говорит, был ли\nвызван ",[466,1605,1518],{}," и что было в ",[466,1608,1514],{},": управляемый список должен применять его сам.",[947,1611,1612,1615,1616,1618,1619,1621,1622,765,1624,1626],{},[471,1613,1614],{},"Попробуйте исправление вживую"," в ",[471,1617,1075],{}," — более мягкий ",[466,1620,1338],{},", другой\n",[466,1623,1281],{},[466,1625,1113],{},", — а затем перенесите то, что сработало, в свой код.",[483,1628,1630],{"id":1629},"how-it-works","Как это работает",[463,1632,1633,1634,1637],{},"Провайдеры сообщают о себе хуку, который устанавливает сторона страницы. Пока за страницей не\nследит вкладка, они только записываются; затем страница слушает, как любой монитор, и отправляет\nвкладке то, что та показывает, — каждые 40 ms во время драга, дважды в секунду в остальное время,\n— и останавливается, когда несколько секунд за ней не следит ни одна вкладка. Вкладка общается со\nстраницей через ",[466,1635,1636],{},"BroadcastChannel"," origin страницы. Она не меняет ничего, кроме того, о чём вы\nпросите: драгов, выделения и переопределений опций.",[1639,1640,1641],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki
4,855],{"class":581}," App ",[527,857,605],{"class":573},[527,859,860],{"class":537}," '.\u002FApp.vue'",[527,862,594],{"class":577},[527,864,865],{"class":529,"line":628},[527,866,651],{"emptyLinePlaceholder":650},[527,868,869,872,875,878,881,884,887],{"class":529,"line":647},[527,870,871],{"class":573},"const",[527,873,874],{"class":581}," app ",[527,876,877],{"class":577},"=",[527,879,880],{"class":533}," createApp",[527,882,883],{"class":577},"(",[527,885,886],{"class":581},"App",[527,888,889],{"class":577},");\n",[527,891,892,895,898,901,903,906,909],{"class":529,"line":654},[527,893,894],{"class":533},"app",[527,896,897],{"class":577},".",[527,899,900],{"class":533},"use",[527,902,883],{"class":577},[527,904,905],{"class":581},"DnDDevtools",[527,907,908],{"class":577},");",[527,910,911],{"class":672}," \u002F\u002F before mount: providers set up earlier aren't seen\n",[527,913,914,916,918,921,923,926],{"class":529,"line":669},[527,915,894],{"class":533},[527,917,897],{"class":577},[527,919,920],{"class":533},"mount",[527,922,883],{"class":577},[527,924,925],{"class":537},"'#app'",[527,927,889],{"class":577},[489,929,930,931,934,935,938,939,942,943,946],{},"Или импортируйте ",[492,932,933],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," первым во входном файле. Используйте\n",[492,936,937],{},"vueDnDKitDevtools({ inject: false })",", когда плагин должен раздавать вкладку, а сторону\nстраницы вы устанавливаете сами; ",[492,940,941],{},"serveTab()"," из ",[492,944,945],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," — middleware,\nкоторое раздаёт вкладку.",[948,949,950],"note",{},[489,951,952,953,956,957,960,961,964],{},"В продакшен-сборке ",[492,954,955],{},"app.use(DnDDevtools)"," и импорт ",[492,958,959],{},"auto"," сжимаются почти в ничто: каждая точка\nвхода сначала проверяет ",[492,962,963],{},"process.env.NODE_ENV",", а бандлеры выбрасывают остальное. На сервере они\nничего не делают.",[509,966,968],{"id":967},"open-it","Как открыть",[970,971,972,993,1008],"ul",{},[973,974,975,978,979,983,984,983,987,990,991,897],"li",{},[497,976,977],{},"Vue DevTools",": ",[980,981],"kbd",{"value":982},"Alt"," + ",[980,985],{"value":986},"Shift",[980,988],{"value":989},"D"," или кнопка Vue\nвнизу страницы, затем вкладка ",[497,992,499],{},[973,994,995,978,998,983,1000,983,1002,1004,1005,1007],{},[497,996,997],{},"Nuxt DevTools",[980,999],{"value":982},[980,1001],{"value":986},[980,1003],{"value":989}," или кнопка Nuxt,\nзатем ",[497,1006,499],{}," (в боковой панели или в её меню переполнения).",[973,1009,1010,1013,1014,1017],{},[497,1011,1012],{},"Отдельное окно",": откройте ",[492,1015,1016],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," на своём\ndev-сервере или нажмите кнопку ⧉ вкладки. Удобно на втором экране. Если открыто несколько\nстраниц, селект сверху выбирает, за какой следить.",[1019,1020,1021],"warning",{},[489,1022,1023],{},"Держите вкладку в отдельном окне, а не в фоновой вкладке браузера того же окна: страница должна\nоставаться видимой, а скрытая страница отменяет драги.",[509,1025,1027],{"id":1026},"the-tab-at-a-glance","Вкладка вкратце",[1029,1030,1031,1044],"table",{},[1032,1033,1034],"thead",{},[1035,1036,1037,1041],"tr",{},[1038,1039,1040],"th",{},"Часть",[1038,1042,1043],{},"Что в ней",[1045,1046,1047,1064,1076,1091],"tbody",{},[1035,1048,1049,1053],{},[1050,1051,1052],"td",{},"Верхняя панель",[1050,1054,1055,1056,1059,1060,1063],{},"Что драг делает прямо сейчас (",[492,1057,1058],{},"dragging card-3 → done (accepts)","), отслеживаемая страница, ",[497,1061,1062],{},"⌖ Pick",", число изменённых опций со сбросом, ⧉ (отдельное окно) и тема.",[1035,1065,1066,1069],{},[1050,1067,1068],{},"Слева: реестр",[1050,1070,1071,1072,1075],{},"Каждый провайдер в виде дерева: его списки, деревья, цели и перетаскиваемые элементы. ",[497,1073,1074],{},"☰"," показывает или скрывает его.",[1035,1077,1078,1088],{},[1050,1079,1080,1081,1084,1085],{},"В центре: ",[497,1082,1083],{},"Map"," и ",[497,1086,1087],{},"Log",[1050,1089,1090],{},"Живая мини-карта страницы или журнал драгов.",[1035,1092,1093,1105],{},[1050,1094,1095,1096,791,1099,791,1102],{},"Справа: ",[497,1097,1098],{},"Drive",[497,1100,1101],{},"Options",[497,1103,1104],{},"State",[1050,1106,1107],{},"Джойстик и кнопки перемещения, опции выбранного узла и то, что о нём знает провайдер.",[489,1109,1110],{},"Выберите узел в реестре или элемент на карте, и правая часть следует за ним.",[509,1112,1114],{"id":1113},"the-mini-map","Мини-карта",[489,1116,1117],{},"Живая карточка на каждый список, дерево и цель, с копиями их элементов там, где они есть, — те же\nклоны, которые показал бы оверлей, со стилями страницы. Во время драга она отмечает:",[970,1119,1120,1131,1134],{},[973,1121,1122,1123,1126,1127,1130],{},"списки и цели, которые ",[497,1124,1125],{},"принимают"," драг (синие) или ",[497,1128,1129],{},"отклоняют"," его (красные);",[973,1132,1133],{},"плейсхолдер и цель под указателем;",[973,1135,1136,1137,897],{},"указатель, блок оверлея и линию вставки списков с ",[492,1138,1139],{},"placeholder: 'indicator'",[489,1141,1142],{},"Клик выбирает элемент и подсвечивает его на странице; двойной клик прокручивает к нему страницу.\nПользуйтесь картой, когда бросок попадает не туда, куда вы ждёте: она сразу показывает, какие\nсписки принимают драг.",[509,1144,1146],{"id":1145},"drive-the-joystick","Drive: джойстик",[489,1148,1149,1150,1152,1153,1084,1156,1159],{},"Выберите элемент — на карте, в реестре или через ",[497,1151,1062],{},", который перехватывает следующее\nнажатие на перетаскиваемый элемент страницы, не давая ему сработать, — и толкните рукоятку\nджойстика. Элемент берётся и движется в ту сторону, тем быстрее, чем дальше рукоятка от центра.\nОтпустите — и он остановится; ",[497,1154,1155],{},"Drop",[497,1157,1158],{},"Cancel"," завершают драг.",[489,1161,1162,1163,1166,1167,1172,1173,1084,1176,1179],{},"Это настоящий драг указателем от сенсора по имени ",[492,1164,1165],{},"devtools",", сделанный на публичном\n",[1168,1169,1171],"a",{"href":1170},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API сенсоров",": списки сортируются под ним, контейнеры\nпрокручиваются у краёв, а ",[492,1174,1175],{},"onBeforeDrop",[492,1177,1178],{},"onDrop"," выполняются, как для любого драга.\nОтключённые элементы не берутся. Перетаскиванием с клавиатуры, начатым на странице, тоже можно\nуправлять.",[489,1181,1182,1183,1189],{},"Элементы сортируемых списков получают ещё и кнопки: вверх, вниз, в начало, в конец, в другой\nсписок группы. Каждая — одно перетаскивание с клавиатуры через\n",[1168,1184,1186],{"href":1185},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[492,1187,1188],{},"moveItem",". Под джойстиком — крупная копия того, что\nпоказывает оверлей.",[1029,1191,1192,1202],{},[1032,1193,1194],{},[1035,1195,1196,1199],{},[1038,1197,1198],{},"Клавиша во вкладке",[1038,1200,1201],{},"Действие",[1045,1203,1204,1227,1237,1251,1261],{},[1035,1205,1206,1221],{},[1050,1207,1208,1209,1212,1213,1212,1216,1212,1219],{},"Стрелки или ",[980,1210],{"value":1211},"W"," ",[980,1214],{"value":1215},"A",[980,1217],{"value":1218},"S",[980,1220],{"value":989},[1050,1222,1223,1224,1226],{},"Толкнуть рукоятку в ту сторону, наполовину; с ",[980,1225],{"value":986}," — до упора",[1035,1228,1229,1234],{},[1050,1230,1231],{},[980,1232],{"value":1233},"G",[1050,1235,1236],{},"Взять выбранный элемент",[1035,1238,1239,1248],{},[1050,1240,1241,1244,1245],{},[980,1242],{"value":1243},"Space"," \u002F ",[980,1246],{"value":1247},"Enter",[1050,1249,1250],{},"Бросить",[1035,1252,1253,1258],{},[1050,1254,1255],{},[980,1256],{"value":1257},"Escape",[1050,1259,1260],{},"Отменить",[1035,1262,1263,1268],{},[1050,1264,1265],{},[980,1266],{"value":1267},"P",[1050,1269,1270],{},"Выбрать на странице",[509,1272,1101],{"id":1273},"options",[489,1275,1276,1277,683],{},"Каждую опцию, которая не является колбэком, можно править, пока приложение работает. Выберите\nузел и откройте ",[497,1278,1101],{},[1029,1280,1281,1291],{},[1032,1282,1283],{},[1035,1284,1285,1288],{},[1038,1286,1287],{},"Узел",[1038,1289,1290],{},"Опции",[1045,1292,1293,1334,1373,1391,1408],{},[1035,1294,1295,1297],{},[1050,1296,317],{},[1050,1298,1299,791,1302,791,1305,791,1308,1311,1312,791,1315,791,1318,791,1321,791,1324,791,1327,791,1330,1333],{},[492,1300,1301],{},"overlayFit",[492,1303,1304],{},"autoScroll",[492,1306,1307],{},"collision",[492,1309,1310],{},"modifiers"," (библиотечные, по имени), ",[492,1313,1314],{},"animation",[492,1316,1317],{},"dropAnimation",[492,1319,1320],{},"animateChanges",[492,1322,1323],{},"activation",[492,1325,1326],{},"keyboard",[492,1328,1329],{},"haptics",[492,1331,1332],{},"copyModifier","…",[1035,1335,1336,1339],{},[1050,1337,1338],{},"Список",[1050,1340,1341,791,1344,791,1347,791,1350,791,1353,791,1356,791,1359,791,1362,791,1365,791,1367,791,1369,791,1371],{},[492,1342,1343],{},"disabled",[492,1345,1346],{},"strategy",[492,1348,1349],{},"placeholder",[492,1351,1352],{},"behavior",[492,1354,1355],{},"multiple",[492,1357,1358],{},"sort",[492,1360,1361],{},"dropOutside",[492,1363,1364],{},"acceptMode",[492,1366,1314],{},[492,1368,1320],{},[492,1370,1304],{},[492,1372,1310],{},[1035,1374,1375,1378],{},[1050,1376,1377],{},"Дерево",[1050,1379,1380,791,1382,791,1385,791,1388,1333],{},[492,1381,1349],{},[492,1383,1384],{},"indentation",[492,1386,1387],{},"nesting",[492,1389,1390],{},"maxDepth",[1035,1392,1393,1396],{},[1050,1394,1395],{},"Цель",[1050,1397,1398,791,1400,791,1403,791,1406],{},[492,1399,1343],{},[492,1401,1402],{},"priority",[492,1404,1405],{},"accept",[492,1407,1364],{},[1035,1409,1410,1413],{},[1050,1411,1412],{},"Элемент",[1050,1414,1415,791,1417,791,1420],{},[492,1416,1343],{},[492,1418,1419],{},"keyboardMode",[492,1421,1323],{},[489,1423,1424],{},"Правка применяется сразу, только к этой странице, и никогда не записывается в ваш код: библиотека\nчитает новое значение там, где читает опцию. Она действует, пока вы её не сбросите (↺ у каждой\nопции или сброс на верхней панели), пока провайдер не размонтируется или страница не\nперезагрузится. Рядом с изменённой опцией показано значение из вашего кода. Элементы,\nсмонтированные, пока правка задана, — строки виртуального списка — тоже её получают.",[509,1426,1104],{"id":1427},"state",[489,1429,1430],{},"Что знает каждый провайдер о выбранном узле:",[970,1432,1433,1439,1449],{},[973,1434,1435,1438],{},[497,1436,1437],{},"сессия драга",": статус, активные id, элементы и сенсор, цель и принимает ли она, указатель,\nоверлей, сессия сортируемой группы и линия вставки;",[973,1440,1441,1444,1445,1448],{},[497,1442,1443],{},"список",": его порядок и черновик; ",[497,1446,1447],{},"дерево",": его строки;",[973,1450,1451,1454,1455,1458],{},[497,1452,1453],{},"элемент",": его тип, данные и позиция; ",[497,1456,1457],{},"цель",": её правила.",[489,1460,1461],{},"Элементы монтируются и размонтируются без событий: реестр догоняет их в течение секунды.",[509,1463,1087],{"id":1464},"log",[489,1466,1467],{},"Одна полоса на драг, по порядку:",[1029,1469,1470,1480],{},[1032,1471,1472],{},[1035,1473,1474,1477],{},[1038,1475,1476],{},"Запись",[1038,1478,1479],{},"Что сообщает",[1045,1481,1482,1492,1505,1517,1529,1546],{},[1035,1483,1484,1489],{},[1050,1485,1486],{},[492,1487,1488],{},"drag start",[1050,1490,1491],{},"Id, сенсор и было ли это касание, список, из которого пришёл элемент.",[1035,1493,1494,1502],{},[1050,1495,1496,791,1499],{},[492,1497,1498],{},"over",[492,1500,1501],{},"left",[1050,1503,1504],{},"Каждую цель, в которую вошёл и из которой вышел драг, и принимает ли она его.",[1035,1506,1507,1512],{},[1050,1508,1509],{},[492,1510,1511],{},"release",[1050,1513,1514,1515,897],{},"Цель, над которой драг отпущен, пока решает ",[492,1516,1175],{},[1035,1518,1519,1523],{},[1050,1520,1521],{},[492,1522,1175],{},[1050,1524,1525,1526,1528],{},"Вердикт: принято, принято частично, отклонено хуком, отклонено ",[492,1527,1405],{}," цели, и сколько заняли хуки.",[1035,1530,1531,1536],{},[1050,1532,1533],{},[492,1534,1535],{},"drop",[1050,1537,1538,1539,1542,1543,897],{},"Цель; для сортируемых списков — перемещение, ",[492,1540,1541],{},"e.result"," и был ли вызван ",[492,1544,1545],{},"preventDefault()",[1035,1547,1548,1553],{},[1050,1549,1550],{},[492,1551,1552],{},"cancel",[1050,1554,1555,1556,1559,1560,1562],{},"Причина: отменено (Escape, ",[492,1557,1558],{},"cancel()","), отклонено хуком или отклонено ",[492,1561,1405],{}," цели.",[489,1564,1565,1566,1084,1569,1572,1573,1576,1577,1580],{},"А также ",[492,1567,1568],{},"auto-scroll on",[492,1570,1571],{},"off",", тексты ",[492,1574,1575],{},"announcement"," (по умолчанию скрыты) и, вне драгов,\n",[492,1578,1579],{},"animate"," (изменения элементов списка, сделанные не драгом). Кликните по записи, чтобы увидеть её\nданные. Вкладка, открытая позже, получает уже прошедшие драги.",[509,1582,1584],{"id":1583},"debug-a-drop-step-by-step","Отладка броска по шагам",[489,1586,1587],{},"Карточка не попадает в колонку. С открытой вкладкой:",[1589,1590,1591,1600,1617,1638],"ol",{},[973,1592,1593,1596,1597,1599],{},[497,1594,1595],{},"Воспроизведите"," это руками или через ",[497,1598,1098],{},", чтобы руки оставались свободными для\nвкладки.",[973,1601,1602,1605,1606,1609,1610,1613,1614,1616],{},[497,1603,1604],{},"Следите за картой",", пока карточка над колонкой. Красный значит, что список отклоняет\nкарточку: смотрите его ",[492,1607,1608],{},"group"," (",[492,1611,1612],{},"put",") или ",[492,1615,1405],{}," цели. Синий значит, что он принимает, и\nпроблема возникает позже.",[973,1618,1619,1622,1623,1625,1626,1628,1629,1631,1632,1634,1635,1637],{},[497,1620,1621],{},"Прочитайте журнал"," этого драга. ",[492,1624,1175],{}," говорит, кто сказал «нет», — хук или\n",[492,1627,1405],{}," цели. Если бросок прошёл, а ваши данные не изменились, запись ",[492,1630,1535],{}," говорит, был ли\nвызван ",[492,1633,1545],{}," и что было в ",[492,1636,1541],{},": управляемый список должен применять его сам.",[973,1639,1640,1643,1644,1646,1647,1649,1650,791,1652,1654],{},[497,1641,1642],{},"Попробуйте исправление вживую"," в ",[497,1645,1101],{}," — более мягкий ",[492,1648,1364],{},", другой\n",[492,1651,1307],{},[492,1653,1139],{},", — а затем перенесите то, что сработало, в свой код.",[509,1656,1658],{"id":1657},"how-it-works","Как это работает",[489,1660,1661,1662,1665],{},"Провайдеры сообщают о себе хуку, который устанавливает сторона страницы. Пока за страницей не\nследит вкладка, они только записываются; затем страница слушает, как любой монитор, и отправляет\nвкладке то, что та показывает, — каждые 40 ms во время драга, дважды в секунду в остальное время,\n— и останавливается, когда несколько секунд за ней не следит ни одна вкладка. Вкладка общается со\nстраницей через ",[492,1663,1664],{},"BroadcastChannel"," origin страницы. Она не меняет ничего, кроме того, о чём вы\nпросите: драгов, выделения и переопределений опций.",[1667,1668,1669],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style
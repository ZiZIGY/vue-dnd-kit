-kit\u002Fdevtools'",[531,852,598],{"class":581},[531,854,855,857,860,862,865],{"class":533,"line":617},[531,856,578],{"class":577},[531,858,859],{"class":585}," App ",[531,861,609],{"class":577},[531,863,864],{"class":541}," '.\u002FApp.vue'",[531,866,598],{"class":581},[531,868,869],{"class":533,"line":632},[531,870,655],{"emptyLinePlaceholder":654},[531,872,873,876,879,882,885,888,891],{"class":533,"line":651},[531,874,875],{"class":577},"const",[531,877,878],{"class":585}," app ",[531,880,881],{"class":581},"=",[531,883,884],{"class":537}," createApp",[531,886,887],{"class":581},"(",[531,889,890],{"class":585},"App",[531,892,893],{"class":581},");\n",[531,895,896,899,902,905,907,910,913],{"class":533,"line":658},[531,897,898],{"class":537},"app",[531,900,901],{"class":581},".",[531,903,904],{"class":537},"use",[531,906,887],{"class":581},[531,908,909],{"class":585},"DnDDevtools",[531,911,912],{"class":581},");",[531,914,915],{"class":676}," \u002F\u002F before mount: providers set up earlier aren't seen\n",[531,917,918,920,922,925,927,930],{"class":533,"line":673},[531,919,898],{"class":537},[531,921,901],{"class":581},[531,923,924],{"class":537},"mount",[531,926,887],{"class":581},[531,928,929],{"class":541},"'#app'",[531,931,893],{"class":581},[493,933,934,935,938,939,942,943,946,947,950],{},"Или импортируйте ",[496,936,937],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," первым во входном файле. Используйте\n",[496,940,941],{},"vueDnDKitDevtools({ inject: false })",", когда плагин должен раздавать вкладку, а сторону\nстраницы вы устанавливаете сами; ",[496,944,945],{},"serveTab()"," из ",[496,948,949],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," — middleware,\nкоторое раздаёт вкладку.",[952,953,954],"note",{},[493,955,956,957,960,961,964,965,968],{},"В продакшен-сборке ",[496,958,959],{},"app.use(DnDDevtools)"," и импорт ",[496,962,963],{},"auto"," сжимаются почти в ничто: каждая точка\nвхода сначала проверяет ",[496,966,967],{},"process.env.NODE_ENV",", а бандлеры выбрасывают остальное. На сервере они\nничего не делают.",[513,970,972],{"id":971},"open-it","Как открыть",[974,975,976,997,1012],"ul",{},[977,978,979,982,983,987,988,987,991,994,995,901],"li",{},[501,980,981],{},"Vue DevTools",": ",[984,985],"kbd",{"value":986},"Alt"," + ",[984,989],{"value":990},"Shift",[984,992],{"value":993},"D"," или кнопка Vue\nвнизу страницы, затем вкладка ",[501,996,503],{},[977,998,999,982,1002,987,1004,987,1006,1008,1009,1011],{},[501,1000,1001],{},"Nuxt DevTools",[984,1003],{"value":986},[984,1005],{"value":990},[984,1007],{"value":993}," или кнопка Nuxt,\nзатем ",[501,1010,503],{}," (в боковой панели или в её меню переполнения).",[977,1013,1014,1017,1018,1021],{},[501,1015,1016],{},"Отдельное окно",": откройте ",[496,1019,1020],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," на своём\ndev-сервере или нажмите кнопку ⧉ вкладки. Удобно на втором экране. Если открыто несколько\nстраниц, селект сверху выбирает, за какой следить.",[1023,1024,1025],"warning",{},[493,1026,1027],{},"Держите вкладку в отдельном окне, а не в фоновой вкладке браузера того же окна: страница должна\nоставаться видимой, а скрытая страница отменяет драги.",[513,1029,1031],{"id":1030},"the-tab-at-a-glance","Вкладка вкратце",[1033,1034,1035,1048],"table",{},[1036,1037,1038],"thead",{},[1039,1040,1041,1045],"tr",{},[1042,1043,1044],"th",{},"Часть",[1042,1046,1047],{},"Что в ней",[1049,1050,1051,1068,1080,1095],"tbody",{},[1039,1052,1053,1057],{},[1054,1055,1056],"td",{},"Верхняя панель",[1054,1058,1059,1060,1063,1064,1067],{},"Что драг делает прямо сейчас (",[496,1061,1062],{},"dragging card-3 → done (accepts)","), отслеживаемая страница, ",[501,1065,1066],{},"⌖ Pick",", число изменённых опций со сбросом, ⧉ (отдельное окно) и тема.",[1039,1069,1070,1073],{},[1054,1071,1072],{},"Слева: реестр",[1054,1074,1075,1076,1079],{},"Каждый провайдер в виде дерева: его списки, деревья, цели и перетаскиваемые элементы. ",[501,1077,1078],{},"☰"," показывает или скрывает его.",[1039,1081,1082,1092],{},[1054,1083,1084,1085,1088,1089],{},"В центре: ",[501,1086,1087],{},"Map"," и ",[501,1090,1091],{},"Log",[1054,1093,1094],{},"Живая мини-карта страницы или журнал драгов.",[1039,1096,1097,1109],{},[1054,1098,1099,1100,795,1103,795,1106],{},"Справа: ",[501,1101,1102],{},"Drive",[501,1104,1105],{},"Options",[501,1107,1108],{},"State",[1054,1110,1111],{},"Джойстик и кнопки перемещения, опции выбранного узла и то, что о нём знает провайдер.",[493,1113,1114],{},"Выберите узел в реестре или элемент на карте, и правая часть следует за ним.",[513,1116,1118],{"id":1117},"the-mini-map","Мини-карта",[493,1120,1121],{},"Живая карточка на каждый список, дерево и цель, с копиями их элементов там, где они есть, — те же\nклоны, которые показал бы оверлей, со стилями страницы. Во время драга она отмечает:",[974,1123,1124,1135,1138],{},[977,1125,1126,1127,1130,1131,1134],{},"списки и цели, которые ",[501,1128,1129],{},"принимают"," драг (синие) или ",[501,1132,1133],{},"отклоняют"," его (красные);",[977,1136,1137],{},"плейсхолдер и цель под указателем;",[977,1139,1140,1141,901],{},"указатель, блок оверлея и линию вставки списков с ",[496,1142,1143],{},"placeholder: 'indicator'",[493,1145,1146],{},"Клик выбирает элемент и подсвечивает его на странице; двойной клик прокручивает к нему страницу.\nПользуйтесь картой, когда бросок попадает не туда, куда вы ждёте: она сразу показывает, какие\nсписки принимают драг.",[513,1148,1150],{"id":1149},"drive-the-joystick","Drive: джойстик",[493,1152,1153,1154,1156,1157,1088,1160,1163],{},"Выберите элемент — на карте, в реестре или через ",[501,1155,1066],{},", который перехватывает следующее\nнажатие на перетаскиваемый элемент страницы, не давая ему сработать, — и толкните рукоятку\nджойстика. Элемент берётся и движется в ту сторону, тем быстрее, чем дальше рукоятка от центра.\nОтпустите — и он остановится; ",[501,1158,1159],{},"Drop",[501,1161,1162],{},"Cancel"," завершают драг.",[493,1165,1166,1167,1170,1171,1176,1177,1088,1180,1183],{},"Это настоящий драг указателем от сенсора по имени ",[496,1168,1169],{},"devtools",", сделанный на публичном\n",[1172,1173,1175],"a",{"href":1174},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API сенсоров",": списки сортируются под ним, контейнеры\nпрокручиваются у краёв, а ",[496,1178,1179],{},"onBeforeDrop",[496,1181,1182],{},"onDrop"," выполняются, как для любого драга.\nОтключённые элементы не берутся. Перетаскиванием с клавиатуры, начатым на странице, тоже можно\nуправлять.",[493,1185,1186,1187,1193],{},"Элементы сортируемых списков получают ещё и кнопки: вверх, вниз, в начало, в конец, в другой\nсписок группы. Каждая — одно перетаскивание с клавиатуры через\n",[1172,1188,1190],{"href":1189},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[496,1191,1192],{},"moveItem",". Под джойстиком — крупная копия того, что\nпоказывает оверлей.",[1033,1195,1196,1206],{},[1036,1197,1198],{},[1039,1199,1200,1203],{},[1042,1201,1202],{},"Клавиша во вкладке",[1042,1204,1205],{},"Действие",[1049,1207,1208,1231,1241,1255,1265],{},[1039,1209,1210,1225],{},[1054,1211,1212,1213,1216,1217,1216,1220,1216,1223],{},"Стрелки или ",[984,1214],{"value":1215},"W"," ",[984,1218],{"value":1219},"A",[984,1221],{"value":1222},"S",[984,1224],{"value":993},[1054,1226,1227,1228,1230],{},"Толкнуть рукоятку в ту сторону, наполовину; с ",[984,1229],{"value":990}," — до упора",[1039,1232,1233,1238],{},[1054,1234,1235],{},[984,1236],{"value":1237},"G",[1054,1239,1240],{},"Взять выбранный элемент",[1039,1242,1243,1252],{},[1054,1244,1245,1248,1249],{},[984,1246],{"value":1247},"Space"," \u002F ",[984,1250],{"value":1251},"Enter",[1054,1253,1254],{},"Бросить",[1039,1256,1257,1262],{},[1054,1258,1259],{},[984,1260],{"value":1261},"Escape",[1054,1263,1264],{},"Отменить",[1039,1266,1267,1272],{},[1054,1268,1269],{},[984,1270],{"value":1271},"P",[1054,1273,1274],{},"Выбрать на странице",[513,1276,1105],{"id":1277},"options",[493,1279,1280,1281,687],{},"Каждую опцию, которая не является колбэком, можно править, пока приложение работает. Выберите\nузел и откройте ",[501,1282,1105],{},[1033,1284,1285,1295],{},[1036,1286,1287],{},[1039,1288,1289,1292],{},[1042,1290,1291],{},"Узел",[1042,1293,1294],{},"Опции",[1049,1296,1297,1338,1377,1395,1412],{},[1039,1298,1299,1301],{},[1054,1300,321],{},[1054,1302,1303,795,1306,795,1309,795,1312,1315,1316,795,1319,795,1322,795,1325,795,1328,795,1331,795,1334,1337],{},[496,1304,1305],{},"overlayFit",[496,1307,1308],{},"autoScroll",[496,1310,1311],{},"collision",[496,1313,1314],{},"modifiers"," (библиотечные, по имени), ",[496,1317,1318],{},"animation",[496,1320,1321],{},"dropAnimation",[496,1323,1324],{},"animateChanges",[496,1326,1327],{},"activation",[496,1329,1330],{},"keyboard",[496,1332,1333],{},"haptics",[496,1335,1336],{},"copyModifier","…",[1039,1339,1340,1343],{},[1054,1341,1342],{},"Список",[1054,1344,1345,795,1348,795,1351,795,1354,795,1357,795,1360,795,1363,795,1366,795,1369,795,1371,795,1373,795,1375],{},[496,1346,1347],{},"disabled",[496,1349,1350],{},"strategy",[496,1352,1353],{},"placeholder",[496,1355,1356],{},"behavior",[496,1358,1359],{},"multiple",[496,1361,1362],{},"sort",[496,1364,1365],{},"dropOutside",[496,1367,1368],{},"acceptMode",[496,1370,1318],{},[496,1372,1324],{},[496,1374,1308],{},[496,1376,1314],{},[1039,1378,1379,1382],{},[1054,1380,1381],{},"Дерево",[1054,1383,1384,795,1386,795,1389,795,1392,1337],{},[496,1385,1353],{},[496,1387,1388],{},"indentation",[496,1390,1391],{},"nesting",[496,1393,1394],{},"maxDepth",[1039,1396,1397,1400],{},[1054,1398,1399],{},"Цель",[1054,1401,1402,795,1404,795,1407,795,1410],{},[496,1403,1347],{},[496,1405,1406],{},"priority",[496,1408,1409],{},"accept",[496,1411,1368],{},[1039,1413,1414,1417],{},[1054,1415,1416],{},"Элемент",[1054,1418,1419,795,1421,795,1424],{},[496,1420,1347],{},[496,1422,1423],{},"keyboardMode",[496,1425,1327],{},[493,1427,1428],{},"Правка применяется сразу, только к этой странице, и никогда не записывается в ваш код: библиотека\nчитает новое значение там, где читает опцию. Она действует, пока вы её не сбросите (↺ у каждой\nопции или сброс на верхней панели), пока провайдер не размонтируется или страница не\nперезагрузится. Рядом с изменённой опцией показано значение из вашего кода. Элементы,\nсмонтированные, пока правка задана, — строки виртуального списка — тоже её получают.",[513,1430,1108],{"id":1431},"state",[493,1433,1434],{},"Что знает каждый провайдер о выбранном узле:",[974,1436,1437,1443,1453],{},[977,1438,1439,1442],{},[501,1440,1441],{},"сессия драга",": статус, активные id, элементы и сенсор, цель и принимает ли она, указатель,\nоверлей, сессия сортируемой группы и линия вставки;",[977,1444,1445,1448,1449,1452],{},[501,1446,1447],{},"список",": его порядок и черновик; ",[501,1450,1451],{},"дерево",": его строки;",[977,1454,1455,1458,1459,1462],{},[501,1456,1457],{},"элемент",": его тип, данные и позиция; ",[501,1460,1461],{},"цель",": её правила.",[493,1464,1465],{},"Элементы монтируются и размонтируются без событий: реестр догоняет их в течение секунды.",[513,1467,1091],{"id":1468},"log",[493,1470,1471],{},"Одна полоса на драг, по порядку:",[1033,1473,1474,1484],{},[1036,1475,1476],{},[1039,1477,1478,1481],{},[1042,1479,1480],{},"Запись",[1042,1482,1483],{},"Что сообщает",[1049,1485,1486,1496,1509,1521,1533,1550],{},[1039,1487,1488,1493],{},[1054,1489,1490],{},[496,1491,1492],{},"drag start",[1054,1494,1495],{},"Id, сенсор и было ли это касание, список, из которого пришёл элемент.",[1039,1497,1498,1506],{},[1054,1499,1500,795,1503],{},[496,1501,1502],{},"over",[496,1504,1505],{},"left",[1054,1507,1508],{},"Каждую цель, в которую вошёл и из которой вышел драг, и принимает ли она его.",[1039,1510,1511,1516],{},[1054,1512,1513],{},[496,1514,1515],{},"release",[1054,1517,1518,1519,901],{},"Цель, над которой драг отпущен, пока решает ",[496,1520,1179],{},[1039,1522,1523,1527],{},[1054,1524,1525],{},[496,1526,1179],{},[1054,1528,1529,1530,1532],{},"Вердикт: принято, принято частично, отклонено хуком, отклонено ",[496,1531,1409],{}," цели, и сколько заняли хуки.",[1039,1534,1535,1540],{},[1054,1536,1537],{},[496,1538,1539],{},"drop",[1054,1541,1542,1543,1546,1547,901],{},"Цель; для сортируемых списков — перемещение, ",[496,1544,1545],{},"e.result"," и был ли вызван ",[496,1548,1549],{},"preventDefault()",[1039,1551,1552,1557],{},[1054,1553,1554],{},[496,1555,1556],{},"cancel",[1054,1558,1559,1560,1563,1564,1566],{},"Причина: отменено (Escape, ",[496,1561,1562],{},"cancel()","), отклонено хуком или отклонено ",[496,1565,1409],{}," цели.",[493,1568,1569,1570,1088,1573,1576,1577,1580,1581,1584],{},"А также ",[496,1571,1572],{},"auto-scroll on",[496,1574,1575],{},"off",", тексты ",[496,1578,1579],{},"announcement"," (по умолчанию скрыты) и, вне драгов,\n",[496,1582,1583],{},"animate"," (изменения элементов списка, сделанные не драгом). Кликните по записи, чтобы увидеть её\nданные. Вкладка, открытая позже, получает уже прошедшие драги.",[513,1586,1588],{"id":1587},"debug-a-drop-step-by-step","Отладка броска по шагам",[493,1590,1591],{},"Карточка не попадает в колонку. С открытой вкладкой:",[1593,1594,1595,1604,1621,1642],"ol",{},[977,1596,1597,1600,1601,1603],{},[501,1598,1599],{},"Воспроизведите"," это руками или через ",[501,1602,1102],{},", чтобы руки оставались свободными для\nвкладки.",[977,1605,1606,1609,1610,1613,1614,1617,1618,1620],{},[501,1607,1608],{},"Следите за картой",", пока карточка над колонкой. Красный значит, что список отклоняет\nкарточку: смотрите его ",[496,1611,1612],{},"group"," (",[496,1615,1616],{},"put",") или ",[496,1619,1409],{}," цели. Синий значит, что он принимает, и\nпроблема возникает позже.",[977,1622,1623,1626,1627,1629,1630,1632,1633,1635,1636,1638,1639,1641],{},[501,1624,1625],{},"Прочитайте журнал"," этого драга. ",[496,1628,1179],{}," говорит, кто сказал «нет», — хук или\n",[496,1631,1409],{}," цели. Если бросок прошёл, а ваши данные не изменились, запись ",[496,1634,1539],{}," говорит, был ли\nвызван ",[496,1637,1549],{}," и что было в ",[496,1640,1545],{},": управляемый список должен применять его сам.",[977,1643,1644,1647,1648,1650,1651,1653,1654,795,1656,1658],{},[501,1645,1646],{},"Попробуйте исправление вживую"," в ",[501,1649,1105],{}," — более мягкий ",[496,1652,1368],{},", другой\n",[496,1655,1311],{},[496,1657,1143],{},", — а затем перенесите то, что сработало, в свой код.",[513,1660,1662],{"id":1661},"how-it-works","Как это работает",[493,1664,1665,1666,1669],{},"Провайдеры сообщают о себе хуку, который устанавливает сторона страницы. Пока за страницей не\nследит вкладка, они только записываются; затем страница слушает, как любой монитор, и отправляет\nвкладке то, что та показывает, — каждые 40 ms во время драга, дважды в секунду в остальное время,\n— и останавливается, когда несколько секунд за ней не следит ни одна вкладка. Вкладка общается со\nстраницей через ",[496,1667,1668],{},"BroadcastChannel"," origin страницы. Она не меняет ничего, кроме того, о чём вы\nпросите: драгов, выделения и переопределений опций.",[1671,1672,1673],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default
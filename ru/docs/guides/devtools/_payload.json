ore mount: providers set up earlier aren't seen\n",[506,892,893,895,897,900,902,905],{"class":508,"line":648},[506,894,873],{"class":512},[506,896,876],{"class":556},[506,898,899],{"class":512},"mount",[506,901,862],{"class":556},[506,903,904],{"class":516},"'#app'",[506,906,868],{"class":556},[468,908,909,910,913,914,917,918,921,922,925],{},"Или импортируйте ",[471,911,912],{},"@vue-dnd-kit\u002Fdevtools\u002Fauto"," первым во входном файле. Используйте\n",[471,915,916],{},"vueDnDKitDevtools({ inject: false })",", когда плагин должен раздавать вкладку, а сторону\nстраницы вы устанавливаете сами; ",[471,919,920],{},"serveTab()"," из ",[471,923,924],{},"@vue-dnd-kit\u002Fdevtools\u002Fvite"," — middleware,\nкоторое раздаёт вкладку.",[927,928,929],"note",{},[468,930,931,932,935,936,939,940,943],{},"В продакшен-сборке ",[471,933,934],{},"app.use(DnDDevtools)"," и импорт ",[471,937,938],{},"auto"," сжимаются почти в ничто: каждая точка\nвхода сначала проверяет ",[471,941,942],{},"process.env.NODE_ENV",", а бандлеры выбрасывают остальное. На сервере они\nничего не делают.",[488,945,947],{"id":946},"open-it","Как открыть",[949,950,951,972,987],"ul",{},[952,953,954,957,958,962,963,962,966,969,970,876],"li",{},[476,955,956],{},"Vue DevTools",": ",[959,960],"kbd",{"value":961},"Alt"," + ",[959,964],{"value":965},"Shift",[959,967],{"value":968},"D"," или кнопка Vue\nвнизу страницы, затем вкладка ",[476,971,478],{},[952,973,974,957,977,962,979,962,981,983,984,986],{},[476,975,976],{},"Nuxt DevTools",[959,978],{"value":961},[959,980],{"value":965},[959,982],{"value":968}," или кнопка Nuxt,\nзатем ",[476,985,478],{}," (в боковой панели или в её меню переполнения).",[952,988,989,992,993,996],{},[476,990,991],{},"Отдельное окно",": откройте ",[471,994,995],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," на своём\ndev-сервере или нажмите кнопку ⧉ вкладки. Удобно на втором экране. Если открыто несколько\nстраниц, селект сверху выбирает, за какой следить.",[998,999,1000],"warning",{},[468,1001,1002],{},"Держите вкладку в отдельном окне, а не в фоновой вкладке браузера того же окна: страница должна\nоставаться видимой, а скрытая страница отменяет драги.",[488,1004,1006],{"id":1005},"the-tab-at-a-glance","Вкладка вкратце",[1008,1009,1010,1023],"table",{},[1011,1012,1013],"thead",{},[1014,1015,1016,1020],"tr",{},[1017,1018,1019],"th",{},"Часть",[1017,1021,1022],{},"Что в ней",[1024,1025,1026,1043,1055,1070],"tbody",{},[1014,1027,1028,1032],{},[1029,1030,1031],"td",{},"Верхняя панель",[1029,1033,1034,1035,1038,1039,1042],{},"Что драг делает прямо сейчас (",[471,1036,1037],{},"dragging card-3 → done (accepts)","), отслеживаемая страница, ",[476,1040,1041],{},"⌖ Pick",", число изменённых опций со сбросом, ⧉ (отдельное окно) и тема.",[1014,1044,1045,1048],{},[1029,1046,1047],{},"Слева: реестр",[1029,1049,1050,1051,1054],{},"Каждый провайдер в виде дерева: его списки, деревья, цели и перетаскиваемые элементы. ",[476,1052,1053],{},"☰"," показывает или скрывает его.",[1014,1056,1057,1067],{},[1029,1058,1059,1060,1063,1064],{},"В центре: ",[476,1061,1062],{},"Map"," и ",[476,1065,1066],{},"Log",[1029,1068,1069],{},"Живая мини-карта страницы или журнал драгов.",[1014,1071,1072,1084],{},[1029,1073,1074,1075,770,1078,770,1081],{},"Справа: ",[476,1076,1077],{},"Drive",[476,1079,1080],{},"Options",[476,1082,1083],{},"State",[1029,1085,1086],{},"Джойстик и кнопки перемещения, опции выбранного узла и то, что о нём знает провайдер.",[468,1088,1089],{},"Выберите узел в реестре или элемент на карте, и правая часть следует за ним.",[488,1091,1093],{"id":1092},"the-mini-map","Мини-карта",[468,1095,1096],{},"Живая карточка на каждый список, дерево и цель, с копиями их элементов там, где они есть, — те же\nклоны, которые показал бы оверлей, со стилями страницы. Во время драга она отмечает:",[949,1098,1099,1110,1113],{},[952,1100,1101,1102,1105,1106,1109],{},"списки и цели, которые ",[476,1103,1104],{},"принимают"," драг (синие) или ",[476,1107,1108],{},"отклоняют"," его (красные);",[952,1111,1112],{},"плейсхолдер и цель под указателем;",[952,1114,1115,1116,876],{},"указатель, блок оверлея и линию вставки списков с ",[471,1117,1118],{},"placeholder: 'indicator'",[468,1120,1121],{},"Клик выбирает элемент и подсвечивает его на странице; двойной клик прокручивает к нему страницу.\nПользуйтесь картой, когда бросок попадает не туда, куда вы ждёте: она сразу показывает, какие\nсписки принимают драг.",[488,1123,1125],{"id":1124},"drive-the-joystick","Drive: джойстик",[468,1127,1128,1129,1131,1132,1063,1135,1138],{},"Выберите элемент — на карте, в реестре или через ",[476,1130,1041],{},", который перехватывает следующее\nнажатие на перетаскиваемый элемент страницы, не давая ему сработать, — и толкните рукоятку\nджойстика. Элемент берётся и движется в ту сторону, тем быстрее, чем дальше рукоятка от центра.\nОтпустите — и он остановится; ",[476,1133,1134],{},"Drop",[476,1136,1137],{},"Cancel"," завершают драг.",[468,1140,1141,1142,1145,1146,1151,1152,1063,1155,1158],{},"Это настоящий драг указателем от сенсора по имени ",[471,1143,1144],{},"devtools",", сделанный на публичном\n",[1147,1148,1150],"a",{"href":1149},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","API сенсоров",": списки сортируются под ним, контейнеры\nпрокручиваются у краёв, а ",[471,1153,1154],{},"onBeforeDrop",[471,1156,1157],{},"onDrop"," выполняются, как для любого драга.\nОтключённые элементы не берутся. Перетаскиванием с клавиатуры, начатым на странице, тоже можно\nуправлять.",[468,1160,1161,1162,1168],{},"Элементы сортируемых списков получают ещё и кнопки: вверх, вниз, в начало, в конец, в другой\nсписок группы. Каждая — одно перетаскивание с клавиатуры через\n",[1147,1163,1165],{"href":1164},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[471,1166,1167],{},"moveItem",". Под джойстиком — крупная копия того, что\nпоказывает оверлей.",[1008,1170,1171,1181],{},[1011,1172,1173],{},[1014,1174,1175,1178],{},[1017,1176,1177],{},"Клавиша во вкладке",[1017,1179,1180],{},"Действие",[1024,1182,1183,1206,1216,1230,1240],{},[1014,1184,1185,1200],{},[1029,1186,1187,1188,1191,1192,1191,1195,1191,1198],{},"Стрелки или ",[959,1189],{"value":1190},"W"," ",[959,1193],{"value":1194},"A",[959,1196],{"value":1197},"S",[959,1199],{"value":968},[1029,1201,1202,1203,1205],{},"Толкнуть рукоятку в ту сторону, наполовину; с ",[959,1204],{"value":965}," — до упора",[1014,1207,1208,1213],{},[1029,1209,1210],{},[959,1211],{"value":1212},"G",[1029,1214,1215],{},"Взять выбранный элемент",[1014,1217,1218,1227],{},[1029,1219,1220,1223,1224],{},[959,1221],{"value":1222},"Space"," \u002F ",[959,1225],{"value":1226},"Enter",[1029,1228,1229],{},"Бросить",[1014,1231,1232,1237],{},[1029,1233,1234],{},[959,1235],{"value":1236},"Escape",[1029,1238,1239],{},"Отменить",[1014,1241,1242,1247],{},[1029,1243,1244],{},[959,1245],{"value":1246},"P",[1029,1248,1249],{},"Выбрать на странице",[488,1251,1080],{"id":1252},"options",[468,1254,1255,1256,662],{},"Каждую опцию, которая не является колбэком, можно править, пока приложение работает. Выберите\nузел и откройте ",[476,1257,1080],{},[1008,1259,1260,1270],{},[1011,1261,1262],{},[1014,1263,1264,1267],{},[1017,1265,1266],{},"Узел",[1017,1268,1269],{},"Опции",[1024,1271,1272,1313,1352,1370,1387],{},[1014,1273,1274,1276],{},[1029,1275,304],{},[1029,1277,1278,770,1281,770,1284,770,1287,1290,1291,770,1294,770,1297,770,1300,770,1303,770,1306,770,1309,1312],{},[471,1279,1280],{},"overlayFit",[471,1282,1283],{},"autoScroll",[471,1285,1286],{},"collision",[471,1288,1289],{},"modifiers"," (библиотечные, по имени), ",[471,1292,1293],{},"animation",[471,1295,1296],{},"dropAnimation",[471,1298,1299],{},"animateChanges",[471,1301,1302],{},"activation",[471,1304,1305],{},"keyboard",[471,1307,1308],{},"haptics",[471,1310,1311],{},"copyModifier","…",[1014,1314,1315,1318],{},[1029,1316,1317],{},"Список",[1029,1319,1320,770,1323,770,1326,770,1329,770,1332,770,1335,770,1338,770,1341,770,1344,770,1346,770,1348,770,1350],{},[471,1321,1322],{},"disabled",[471,1324,1325],{},"strategy",[471,1327,1328],{},"placeholder",[471,1330,1331],{},"behavior",[471,1333,1334],{},"multiple",[471,1336,1337],{},"sort",[471,1339,1340],{},"dropOutside",[471,1342,1343],{},"acceptMode",[471,1345,1293],{},[471,1347,1299],{},[471,1349,1283],{},[471,1351,1289],{},[1014,1353,1354,1357],{},[1029,1355,1356],{},"Дерево",[1029,1358,1359,770,1361,770,1364,770,1367,1312],{},[471,1360,1328],{},[471,1362,1363],{},"indentation",[471,1365,1366],{},"nesting",[471,1368,1369],{},"maxDepth",[1014,1371,1372,1375],{},[1029,1373,1374],{},"Цель",[1029,1376,1377,770,1379,770,1382,770,1385],{},[471,1378,1322],{},[471,1380,1381],{},"priority",[471,1383,1384],{},"accept",[471,1386,1343],{},[1014,1388,1389,1392],{},[1029,1390,1391],{},"Элемент",[1029,1393,1394,770,1396,770,1399],{},[471,1395,1322],{},[471,1397,1398],{},"keyboardMode",[471,1400,1302],{},[468,1402,1403],{},"Правка применяется сразу, только к этой странице, и никогда не записывается в ваш код: библиотека\nчитает новое значение там, где читает опцию. Она действует, пока вы её не сбросите (↺ у каждой\nопции или сброс на верхней панели), пока провайдер не размонтируется или страница не\nперезагрузится. Рядом с изменённой опцией показано значение из вашего кода. Элементы,\nсмонтированные, пока правка задана, — строки виртуального списка — тоже её получают.",[488,1405,1083],{"id":1406},"state",[468,1408,1409],{},"Что знает каждый провайдер о выбранном узле:",[949,1411,1412,1418,1428],{},[952,1413,1414,1417],{},[476,1415,1416],{},"сессия драга",": статус, активные id, элементы и сенсор, цель и принимает ли она, указатель,\nоверлей, сессия сортируемой группы и линия вставки;",[952,1419,1420,1423,1424,1427],{},[476,1421,1422],{},"список",": его порядок и черновик; ",[476,1425,1426],{},"дерево",": его строки;",[952,1429,1430,1433,1434,1437],{},[476,1431,1432],{},"элемент",": его тип, данные и позиция; ",[476,1435,1436],{},"цель",": её правила.",[468,1439,1440],{},"Элементы монтируются и размонтируются без событий: реестр догоняет их в течение секунды.",[488,1442,1066],{"id":1443},"log",[468,1445,1446],{},"Одна полоса на драг, по порядку:",[1008,1448,1449,1459],{},[1011,1450,1451],{},[1014,1452,1453,1456],{},[1017,1454,1455],{},"Запись",[1017,1457,1458],{},"Что сообщает",[1024,1460,1461,1471,1484,1496,1508,1525],{},[1014,1462,1463,1468],{},[1029,1464,1465],{},[471,1466,1467],{},"drag start",[1029,1469,1470],{},"Id, сенсор и было ли это касание, список, из которого пришёл элемент.",[1014,1472,1473,1481],{},[1029,1474,1475,770,1478],{},[471,1476,1477],{},"over",[471,1479,1480],{},"left",[1029,1482,1483],{},"Каждую цель, в которую вошёл и из которой вышел драг, и принимает ли она его.",[1014,1485,1486,1491],{},[1029,1487,1488],{},[471,1489,1490],{},"release",[1029,1492,1493,1494,876],{},"Цель, над которой драг отпущен, пока решает ",[471,1495,1154],{},[1014,1497,1498,1502],{},[1029,1499,1500],{},[471,1501,1154],{},[1029,1503,1504,1505,1507],{},"Вердикт: принято, принято частично, отклонено хуком, отклонено ",[471,1506,1384],{}," цели, и сколько заняли хуки.",[1014,1509,1510,1515],{},[1029,1511,1512],{},[471,1513,1514],{},"drop",[1029,1516,1517,1518,1521,1522,876],{},"Цель; для сортируемых списков — перемещение, ",[471,1519,1520],{},"e.result"," и был ли вызван ",[471,1523,1524],{},"preventDefault()",[1014,1526,1527,1532],{},[1029,1528,1529],{},[471,1530,1531],{},"cancel",[1029,1533,1534,1535,1538,1539,1541],{},"Причина: отменено (Escape, ",[471,1536,1537],{},"cancel()","), отклонено хуком или отклонено ",[471,1540,1384],{}," цели.",[468,1543,1544,1545,1063,1548,1551,1552,1555,1556,1559],{},"А также ",[471,1546,1547],{},"auto-scroll on",[471,1549,1550],{},"off",", тексты ",[471,1553,1554],{},"announcement"," (по умолчанию скрыты) и, вне драгов,\n",[471,1557,1558],{},"animate"," (изменения элементов списка, сделанные не драгом). Кликните по записи, чтобы увидеть её\nданные. Вкладка, открытая позже, получает уже прошедшие драги.",[488,1561,1563],{"id":1562},"debug-a-drop-step-by-step","Отладка броска по шагам",[468,1565,1566],{},"Карточка не попадает в колонку. С открытой вкладкой:",[1568,1569,1570,1579,1596,1617],"ol",{},[952,1571,1572,1575,1576,1578],{},[476,1573,1574],{},"Воспроизведите"," это руками или через ",[476,1577,1077],{},", чтобы руки оставались свободными для\nвкладки.",[952,1580,1581,1584,1585,1588,1589,1592,1593,1595],{},[476,1582,1583],{},"Следите за картой",", пока карточка над колонкой. Красный значит, что список отклоняет\nкарточку: смотрите его ",[471,1586,1587],{},"group"," (",[471,1590,1591],{},"put",") или ",[471,1594,1384],{}," цели. Синий значит, что он принимает, и\nпроблема возникает позже.",[952,1597,1598,1601,1602,1604,1605,1607,1608,1610,1611,1613,1614,1616],{},[476,1599,1600],{},"Прочитайте журнал"," этого драга. ",[471,1603,1154],{}," говорит, кто сказал «нет», — хук или\n",[471,1606,1384],{}," цели. Если бросок прошёл, а ваши данные не изменились, запись ",[471,1609,1514],{}," говорит, был ли\nвызван ",[471,1612,1524],{}," и что было в ",[471,1615,1520],{},": управляемый список должен применять его сам.",[952,1618,1619,1622,1623,1625,1626,1628,1629,770,1631,1633],{},[476,1620,1621],{},"Попробуйте исправление вживую"," в ",[476,1624,1080],{}," — более мягкий ",[471,1627,1343],{},", другой\n",[471,1630,1286],{},[471,1632,1118],{},", — а затем перенесите то, что сработало, в свой код.",[488,1635,1637],{"id":1636},"how-it-works","Как это работает",[468,1639,1640,1641,1644],{},"Провайдеры сообщают о себе хуку, который устанавливает сторона страницы. Пока за страницей не\nследит вкладка, они только записываются; затем страница слушает, как любой монитор, и отправляет\nвкладке то, что та показывает, — каждые 40 ms во время драга, дважды в секунду в остальное время,\n— и останавливается, когда несколько секунд за ней не следит ни одна вкладка. Вкладка общается со\nстраницей через ",[471,1642,1643],{},"BroadcastChannel"," origin страницы. Она не меняет ничего, кроме того, о чём вы\nпросите: драгов, выделения и переопределений опций.",[1646,1647,1648],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A6700;--shiki-default:#9A6700;--shiki-dark:#E9C46A}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s78Kj, html code.shiki .s78Kj{--shiki-light:#1F8A5B;--shiki-default:#1F8A5B;--shiki-dark:#42B883}html pre.shiki code .s6cML, html code.shiki .s6cML{--shiki-light:#5B5B63;--shiki-default:#5B5B63;--shiki-dark:#9F9FA9}html pre.shiki code .snmWg, html code.shiki .snmWg{--shiki-light:#27272A;--shiki-d
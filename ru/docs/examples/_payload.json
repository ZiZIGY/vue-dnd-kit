amples\u002F00.index.md",{"type":490,"value":491,"toc":566},"minimark",[492,504,509,512],[493,494,495,496,500,501,503],"p",{},"Каждый пример — небольшое Vue-приложение: ",[497,498,499],"code",{},"index.vue"," со своим ",[497,502,129],{}," и нужные ему\nкомпоненты. Вкладки с кодом под демо — это те самые файлы, которые его запускают.",[505,506,508],"h2",{"id":507},"apps","Приложения",[493,510,511],{},"Целые интерфейсы — такие, какими вы бы их строили сами: несколько списков, правила, оверлеи и\nклавиатура работают вместе.",[513,514,515,521,526,531,536,541,546,551,556,561],"card-group",{},[516,517,518],"card",{"icon":210,"title":446,"to":208},[493,519,520],{},"Колонки, которые можно переставлять, WIP-лимиты, подтверждение перед Done, множественное\nвыделение и корзина.",[516,522,523],{"icon":215,"title":450,"to":213},[493,524,525],{},"События перетаскиваются между днями и получасами с привязкой к сетке.",[516,527,528],{"icon":220,"title":454,"to":218},[493,529,530],{},"Дерево папок и сетка файлов: выделение рамкой, броски на папки, Alt для копирования.",[516,532,533],{"icon":225,"title":458,"to":223},[493,534,535],{},"Блоки в духе Notion: перемещаются за ручки, вкладываются друг в друга и перетаскиваются из меню\n«\u002F» или боковой панели.",[516,537,538],{"icon":230,"title":462,"to":228},[493,539,540],{},"Допустимые ходы подсвечиваются, фигура в руке говорит, почему поле отклонено, пешка спрашивает,\nкем ей стать, а бот отвечает настоящими драгами.",[516,542,543],{"icon":235,"title":466,"to":233},[493,544,545],{},"Поля Nuxt UI из палитры, расставленные рядом в строках, заполняемые в живом превью и\nэкспортируемые как код Vue.",[516,547,548],{"icon":240,"title":470,"to":238},[493,549,550],{},"Фреймы и слои на масштабируемом холсте, умные направляющие, Alt для дублирования и панель\nслоёв, которая и есть дерево дизайна.",[516,552,553],{"icon":245,"title":474,"to":243},[493,554,555],{},"Секции, которые над страницей превращаются в настоящие, элементы между колонками, дерево слоёв\nна тех же данных, редактирование на месте.",[516,557,558],{"icon":250,"title":478,"to":248},[493,559,560],{},"Таблица Nuxt UI на 2 000 задач: виртуализированная, с поиском, сортируется за ручки строк.",[516,562,563],{"icon":255,"title":482,"to":253},[493,564,565],{},"Виджеты, которые перемещаются за заголовки и меняют размер за углы по ячейке за раз, в строках\nвысотой по содержимому.",{"title":567,"searchDepth":568,"depth":568,"links":569},"",3,[570],{"id":507,"depth":571,"text":508},2,"Живые демо с кодом — каждый файл, который вы видите, работает на странице. Копируйте их или открывайте в StackBlitz.","md",null,{"source":576},"b56dd26d61",{"title":444,"icon":205},{"title":439,"description":572},"sqVu6bRARdopqDyTZhQ-4fbj0JXy_GvnRJsHFGvRGlo",[581,583],{"title":435,"path":436,"stem":437,"description":582,"icon":197},"Небольшие типы, на которые ссылается каждая страница API, — ключи, координаты, прямоугольники, ref элементов и реактивные опции.",{"title":446,"path":447,"stem":448,"description":584,"icon":210},"Продуктовая доска в духе Linear и Trello — колонки, которые можно переставлять, WIP-лимиты, вопрос перед Done, множественное выделение с панелью выделения, фильтры, сквозь которые работают драги, корзина с Undo и панель карточки, чьи кнопки Status проигрывают настоящие драги.",1793926361087]
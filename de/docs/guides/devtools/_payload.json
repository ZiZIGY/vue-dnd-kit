60],{},"process.env.NODE_ENV",", und Bundler werfen den Rest weg.\nAuf dem Server tun sie nichts.",[506,963,965],{"id":964},"open-it","Öffnen",[967,968,969,990,1005],"ul",{},[970,971,972,975,976,980,981,980,984,987,988,894],"li",{},[498,973,974],{},"Vue DevTools",": ",[977,978],"kbd",{"value":979},"Alt"," + ",[977,982],{"value":983},"Shift",[977,985],{"value":986},"D"," oder der Vue-Button\nunten auf der Seite, dann der Tab ",[498,989,500],{},[970,991,992,975,995,980,997,980,999,1001,1002,1004],{},[498,993,994],{},"Nuxt DevTools",[977,996],{"value":979},[977,998],{"value":983},[977,1000],{"value":986}," oder der\nNuxt-Button, dann ",[498,1003,500],{}," (in der Seitenleiste oder ihrem Überlaufmenü).",[970,1006,1007,1010,1011,1014],{},[498,1008,1009],{},"Ein eigenes Fenster",": Öffne ",[489,1012,1013],{},"http:\u002F\u002Flocalhost:5173\u002F__vue-dnd-kit-devtools\u002F"," auf deinem\nDev-Server oder nutze den ⧉-Button des Tabs. Praktisch auf einem zweiten Bildschirm. Sind mehrere\nSeiten offen, wählt ein Select oben die, die beobachtet wird.",[1016,1017,1018],"warning",{},[486,1019,1020],{},"Halte den Tab in einem eigenen Fenster, nicht in einem Hintergrund-Tab desselben Browserfensters:\nDie Seite muss sichtbar bleiben, und eine verborgene Seite bricht Drags ab.",[506,1022,1024],{"id":1023},"the-tab-at-a-glance","Der Tab im Überblick",[1026,1027,1028,1041],"table",{},[1029,1030,1031],"thead",{},[1032,1033,1034,1038],"tr",{},[1035,1036,1037],"th",{},"Teil",[1035,1039,1040],{},"Was er enthält",[1042,1043,1044,1061,1073,1088],"tbody",{},[1032,1045,1046,1050],{},[1047,1048,1049],"td",{},"Obere Leiste",[1047,1051,1052,1053,1056,1057,1060],{},"Was der Drag gerade tut (",[489,1054,1055],{},"dragging card-3 → done (accepts)","), die beobachtete Seite, ",[498,1058,1059],{},"⌖ Pick",", die Anzahl bearbeiteter Optionen mit einem Reset, ⧉ (ein eigenes Fenster) und das Theme.",[1032,1062,1063,1066],{},[1047,1064,1065],{},"Links: die Registry",[1047,1067,1068,1069,1072],{},"Jeder Provider als Baum: seine Listen, Bäume, Drop-Ziele und ziehbaren Elemente. ",[498,1070,1071],{},"☰"," blendet sie ein oder aus.",[1032,1074,1075,1085],{},[1047,1076,1077,1078,1081,1082],{},"Mitte: ",[498,1079,1080],{},"Map"," und ",[498,1083,1084],{},"Log",[1047,1086,1087],{},"Die Live-Minikarte der Seite oder das Log der Drags.",[1032,1089,1090,1102],{},[1047,1091,1092,1093,788,1096,788,1099],{},"Rechts: ",[498,1094,1095],{},"Drive",[498,1097,1098],{},"Options",[498,1100,1101],{},"State",[1047,1103,1104],{},"Der Joystick und die Buttons zum Verschieben, die Optionen des gewählten Knotens und was der Provider darüber weiß.",[486,1106,1107],{},"Wähle einen Knoten in der Registry oder ein Element auf der Karte, und die rechte Seite folgt ihm.",[506,1109,1111],{"id":1110},"the-mini-map","Die Minikarte",[486,1113,1114],{},"Eine Live-Karte pro Liste, Baum und Drop-Ziel, mit Kopien ihrer Elemente dort, wo sie sind –\ndieselben Klone, die das Overlay zeigen würde, mit dem CSS der Seite. Während eines Drags markiert\nsie:",[967,1116,1117,1128,1131],{},[970,1118,1119,1120,1123,1124,1127],{},"die Listen und Ziele, die den Drag ",[498,1121,1122],{},"annehmen"," (blau) oder ",[498,1125,1126],{},"ablehnen"," (rot);",[970,1129,1130],{},"den Platzhalter und das Ziel unter dem Zeiger;",[970,1132,1133,1134,894],{},"den Zeiger, die Box des Overlays und die Einfügelinie von Listen mit ",[489,1135,1136],{},"placeholder: 'indicator'",[486,1138,1139],{},"Ein Klick wählt ein Element und hebt es auf der Seite hervor; ein Doppelklick scrollt die Seite\ndorthin. Nutze die Karte, wenn ein Drop nicht dort landet, wo du es erwartest: Sie zeigt auf einen\nBlick, welche Listen den Drag annehmen.",[506,1141,1143],{"id":1142},"drive-the-joystick","Drive: der Joystick",[486,1145,1146,1147,1149,1150,1081,1153,1156],{},"Wähle ein Element – auf der Karte, in der Registry oder mit ",[498,1148,1059],{},", das das nächste Drücken auf\nein ziehbares Element der Seite abfängt, statt es wirken zu lassen – und drück den Knauf des\nJoysticks. Das Element wird aufgenommen und bewegt sich in diese Richtung, umso schneller, je\nweiter der Knauf von der Mitte entfernt ist. Lass los, und es hält an; ",[498,1151,1152],{},"Drop",[498,1154,1155],{},"Cancel","\nbeenden den Drag.",[486,1158,1159,1160,1163,1164,1169,1170,1081,1173,1176],{},"Es ist ein echter Drag per Zeiger von einem Sensor namens ",[489,1161,1162],{},"devtools",", gebaut mit der öffentlichen\n",[1165,1166,1168],"a",{"href":1167},"\u002Fdocs\u002Fguides\u002Fsensors#a-sensor-of-your-own","Sensor-API",": Listen sortieren sich darunter, Container\nscrollen an ihren Rändern, und ",[489,1171,1172],{},"onBeforeDrop",[489,1174,1175],{},"onDrop"," laufen wie bei jedem Drag. Deaktivierte\nElemente werden nicht aufgenommen. Auch ein Drag per Tastatur, den die Seite gestartet hat, lässt\nsich steuern.",[486,1178,1179,1180,1186],{},"Elemente sortierbarer Listen bekommen zusätzlich Buttons: nach oben, nach unten, an den Anfang, ans\nEnde, in eine andere Liste der Gruppe. Jeder ist ein Drag per Tastatur mit\n",[1165,1181,1183],{"href":1182},"\u002Fdocs\u002Fguides\u002Fsensors#programmatic-drags",[489,1184,1185],{},"moveItem",". Unter dem Joystick eine große Kopie dessen,\nwas das Overlay zeigt.",[1026,1188,1189,1199],{},[1029,1190,1191],{},[1032,1192,1193,1196],{},[1035,1194,1195],{},"Taste im Tab",[1035,1197,1198],{},"Wirkung",[1042,1200,1201,1224,1234,1248,1258],{},[1032,1202,1203,1218],{},[1047,1204,1205,1206,1209,1210,1209,1213,1209,1216],{},"Pfeiltasten oder ",[977,1207],{"value":1208},"W"," ",[977,1211],{"value":1212},"A",[977,1214],{"value":1215},"S",[977,1217],{"value":986},[1047,1219,1220,1221,1223],{},"Den Knauf in diese Richtung drücken, halb; mit ",[977,1222],{"value":983}," ganz",[1032,1225,1226,1231],{},[1047,1227,1228],{},[977,1229],{"value":1230},"G",[1047,1232,1233],{},"Das gewählte Element aufnehmen",[1032,1235,1236,1245],{},[1047,1237,1238,1241,1242],{},[977,1239],{"value":1240},"Space"," \u002F ",[977,1243],{"value":1244},"Enter",[1047,1246,1247],{},"Ablegen",[1032,1249,1250,1255],{},[1047,1251,1252],{},[977,1253],{"value":1254},"Escape",[1047,1256,1257],{},"Abbrechen",[1032,1259,1260,1265],{},[1047,1261,1262],{},[977,1263],{"value":1264},"P",[1047,1266,1267],{},"Auf der Seite auswählen",[506,1269,1098],{"id":1270},"options",[486,1272,1273,1274,680],{},"Jede Option, die kein Callback ist, lässt sich bearbeiten, während die App läuft. Wähle den Knoten\nund öffne ",[498,1275,1098],{},[1026,1277,1278,1288],{},[1029,1279,1280],{},[1032,1281,1282,1285],{},[1035,1283,1284],{},"Knoten",[1035,1286,1287],{},"Optionen",[1042,1289,1290,1332,1371,1389,1406],{},[1032,1291,1292,1295],{},[1047,1293,1294],{},"Provider",[1047,1296,1297,788,1300,788,1303,788,1306,1309,1310,788,1313,788,1316,788,1319,788,1322,788,1325,788,1328,1331],{},[489,1298,1299],{},"overlayFit",[489,1301,1302],{},"autoScroll",[489,1304,1305],{},"collision",[489,1307,1308],{},"modifiers"," (die der Bibliothek, nach Namen), ",[489,1311,1312],{},"animation",[489,1314,1315],{},"dropAnimation",[489,1317,1318],{},"animateChanges",[489,1320,1321],{},"activation",[489,1323,1324],{},"keyboard",[489,1326,1327],{},"haptics",[489,1329,1330],{},"copyModifier"," …",[1032,1333,1334,1337],{},[1047,1335,1336],{},"Liste",[1047,1338,1339,788,1342,788,1345,788,1348,788,1351,788,1354,788,1357,788,1360,788,1363,788,1365,788,1367,788,1369],{},[489,1340,1341],{},"disabled",[489,1343,1344],{},"strategy",[489,1346,1347],{},"placeholder",[489,1349,1350],{},"behavior",[489,1352,1353],{},"multiple",[489,1355,1356],{},"sort",[489,1358,1359],{},"dropOutside",[489,1361,1362],{},"acceptMode",[489,1364,1312],{},[489,1366,1318],{},[489,1368,1302],{},[489,1370,1308],{},[1032,1372,1373,1376],{},[1047,1374,1375],{},"Baum",[1047,1377,1378,788,1380,788,1383,788,1386,1331],{},[489,1379,1347],{},[489,1381,1382],{},"indentation",[489,1384,1385],{},"nesting",[489,1387,1388],{},"maxDepth",[1032,1390,1391,1394],{},[1047,1392,1393],{},"Drop-Ziel",[1047,1395,1396,788,1398,788,1401,788,1404],{},[489,1397,1341],{},[489,1399,1400],{},"priority",[489,1402,1403],{},"accept",[489,1405,1362],{},[1032,1407,1408,1411],{},[1047,1409,1410],{},"Element",[1047,1412,1413,788,1415,788,1418],{},[489,1414,1341],{},[489,1416,1417],{},"keyboardMode",[489,1419,1321],{},[486,1421,1422],{},"Eine Änderung gilt sofort, nur für diese Seite, und wird nie in deinen Code geschrieben: Die\nBibliothek liest den neuen Wert dort, wo sie die Option liest. Sie gilt, bis du sie zurücksetzt (↺\npro Option oder der Reset in der oberen Leiste), der Provider unmountet oder die Seite neu lädt.\nNeben einer bearbeiteten Option steht der Wert aus deinem Code. Elemente, die gemountet werden,\nwährend eine Änderung gesetzt ist – Zeilen einer virtuellen Liste –, bekommen sie auch.",[506,1424,1101],{"id":1425},"state",[486,1427,1428],{},"Was jeder Provider über den gewählten Knoten weiß:",[967,1430,1431,1438,1447],{},[970,1432,1433,1434,1437],{},"die ",[498,1435,1436],{},"Drag-Sitzung",": Status, die aktiven IDs, Elemente und der Sensor, das Ziel und ob es\nannimmt, der Zeiger, das Overlay, die Sitzung der sortierbaren Gruppe und die Einfügelinie;",[970,1439,1440,1441,1443,1444,1446],{},"eine ",[498,1442,1336],{},": ihre Reihenfolge und ihr Entwurf; ein ",[498,1445,1375],{},": seine Zeilen;",[970,1448,1449,1450,1452,1453,1455],{},"ein ",[498,1451,1410],{},": sein Typ, seine Daten und seine Position; ein ",[498,1454,1393],{},": seine Regeln.",[486,1457,1458],{},"Elemente mounten und unmounten ohne Events: Die Registry holt das innerhalb einer Sekunde auf.",[506,1460,1084],{"id":1461},"log",[486,1463,1464],{},"Ein Band pro Drag, der Reihe nach:",[1026,1466,1467,1477],{},[1029,1468,1469],{},[1032,1470,1471,1474],{},[1035,1472,1473],{},"Eintrag",[1035,1475,1476],{},"Was er sagt",[1042,1478,1479,1489,1502,1515,1527,1545],{},[1032,1480,1481,1486],{},[1047,1482,1483],{},[489,1484,1485],{},"drag start",[1047,1487,1488],{},"Die IDs, der Sensor und ob per Touch, die Liste, aus der er kommt.",[1032,1490,1491,1499],{},[1047,1492,1493,788,1496],{},[489,1494,1495],{},"over",[489,1497,1498],{},"left",[1047,1500,1501],{},"Jedes Ziel, das betreten und verlassen wurde, und ob es annimmt.",[1032,1503,1504,1509],{},[1047,1505,1506],{},[489,1507,1508],{},"release",[1047,1510,1511,1512,1514],{},"Das Ziel, über dem losgelassen wurde, während ",[489,1513,1172],{}," entscheidet.",[1032,1516,1517,1521],{},[1047,1518,1519],{},[489,1520,1172],{},[1047,1522,1523,1524,1526],{},"Das Urteil: angenommen, teilweise angenommen, von einem Hook abgelehnt, vom ",[489,1525,1403],{}," des Ziels abgelehnt, und wie lange die Hooks gebraucht haben.",[1032,1528,1529,1534],{},[1047,1530,1531],{},[489,1532,1533],{},"drop",[1047,1535,1536,1537,1540,1541,1544],{},"Das Ziel; bei sortierbaren Listen die Bewegung, ",[489,1538,1539],{},"e.result"," und ob ",[489,1542,1543],{},"preventDefault()"," aufgerufen wurde.",[1032,1546,1547,1552],{},[1047,1548,1549],{},[489,1550,1551],{},"cancel",[1047,1553,1554,1555,1558,1559,1561],{},"Warum: abgebrochen (Escape, ",[489,1556,1557],{},"cancel()","), von einem Hook abgelehnt oder vom ",[489,1560,1403],{}," des Ziels abgelehnt.",[486,1563,1564,1565,1081,1568,1571,1572,1575,1576,1579],{},"Außerdem ",[489,1566,1567],{},"auto-scroll on",[489,1569,1570],{},"off",", die ",[489,1573,1574],{},"announcement","-Texte (standardmäßig ausgeblendet) und,\naußerhalb von Drags, ",[489,1577,1578],{},"animate"," (Änderungen an den Elementen einer Liste, die kein Drag gemacht\nhat). Klick auf einen Eintrag, um seine Daten zu sehen. Ein Tab, der später geöffnet wird, bekommt\ndie bisherigen Drags.",[506,1581,1583],{"id":1582},"debug-a-drop-step-by-step","Einen Drop Schritt für Schritt debuggen",[486,1585,1586],{},"Eine Karte will nicht in eine Spalte. Mit offenem Tab:",[1588,1589,1590,1599,1616,1637],"ol",{},[970,1591,1592,1595,1596,1598],{},[498,1593,1594],{},"Reproduziere es"," von Hand oder mit ",[498,1597,1095],{},", damit deine Hände für den Tab frei bleiben.",[970,1600,1601,1604,1605,1608,1609,1612,1613,1615],{},[498,1602,1603],{},"Beobachte die Karte",", während die Karte über der Spalte ist. Rot heißt, die Liste lehnt die\nKarte ab: Sieh dir ihre ",[489,1606,1607],{},"group"," (",[489,1610,1611],{},"put",") oder das ",[489,1614,1403],{}," des Ziels an. Blau heißt, sie nimmt\nan, und das Problem kommt später.",[970,1617,1618,1621,1622,1624,1625,1627,1628,1630,1631,1633,1634,1636],{},[498,1619,1620],{},"Lies das Log"," dieses Drags. ",[489,1623,1172],{}," sagt, wer Nein gesagt hat – ein Hook oder das\n",[489,1626,1403],{}," des Ziels. Ging der Drop durch, aber deine Daten haben sich nicht geändert, sagt der\nEintrag ",[489,1629,1533],{},", ob ",[489,1632,1543],{}," aufgerufen wurde und was in ",[489,1635,1539],{}," stand: Eine\nkontrollierte Liste muss es selbst anwenden.",[970,1638,1639,1642,1643,1645,1646,1648,1649,788,1651,1653],{},[498,1640,1641],{},"Probier einen Fix live"," in ",[498,1644,1098],{}," aus – ein lockereres ",[489,1647,1362],{},", eine andere\n",[489,1650,1305],{},[489,1652,1136],{}," – und schreib dann den, der funktioniert, in deinen\nCode.",[506,1655,1657],{"id":1656},"how-it-works","Wie es funktioniert",[486,1659,1660,1661,1664],{},"Provider berichten an einen Hook, den der Teil auf der Seite installiert. Bis ein Tab die Seite\nbeobachtet, werden sie nur erfasst; dann hört die Seite zu wie jeder Monitor und schickt dem Tab,\nwas er zeigt – alle 40 ms während eines Drags, sonst zweimal pro Sekunde – und hört auf, sobald\neinige Sekunden lang kein Tab mehr zugesehen hat. Der Tab spricht mit der Seite über einen\n",[489,1662,1663],{},"BroadcastChannel"," des Origins der Seite. Er ändert nichts außer dem, worum du bittest: die Drags,\ndie Auswahl und die überschriebenen Optionen.",[1666,1667,1668],"style",{},"html pre.shiki code .sbwC8, html code.shiki .sbwC8{--shiki-light:#0969DA;--shiki-default:#0969DA;--shiki-dark:#7CC4FF}html pre.shiki code .sN8r7, html code.shiki .sN8r7{--shiki-light:#9A67